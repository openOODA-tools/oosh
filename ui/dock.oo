// # Live Ambient Status Dock
//
// Logline: Resolves host node identity and git context without runes or box frames.
//
// Setup: Formats standard status query environment and capability indicators.
//
// Beats:
//   1. Resolve active user identity and host node name.
//   2. Read .git/HEAD directly without subshells for instant context.
//   3. Render clean ambient dock status without runes or frames.

import "std/fs/process/env.oo";

pub fn resolve_node_id(env: &EnvCap) -> String {
    let ur: Result[String, String] = env_get(env, "USER");
    let user_name: String = match ur { Ok(u) => u, Err(_) => "sovereign" };
    let hr: Result[String, String] = env_get(env, "HOSTNAME");
    let host_name: String = match hr { Ok(h) => h, Err(_) => "node" };
    return user_name + "@" + host_name;
}

pub fn resolve_ambient_user(env: &EnvCap, cwd: String) -> String {
    let ur: Result[String, String] = env_get(env, "USER");
    let u: String = match ur { Ok(s) => s, Err(_) => "" };
    if u != "" { return u; }
    if str_starts_with(cwd, "/home/") {
        let after: String = str_slice(cwd, 6, chars_len(cwd));
        let s_idx: Int = str_index_of(after, "/");
        return if s_idx > 0 { str_slice(after, 0, s_idx) } else { after };
    }
    if str_starts_with(cwd, "/root") { return "root"; }
    return "sovereign";
}

pub fn resolve_ambient_home(env: &EnvCap, cwd: String) -> String {
    let hr: Result[String, String] = env_get(env, "HOME");
    let h: String = match hr { Ok(s) => s, Err(_) => "" };
    if h != "" { return h; }
    if str_starts_with(cwd, "/home/") {
        let after: String = str_slice(cwd, 6, chars_len(cwd));
        let s_idx: Int = str_index_of(after, "/");
        let u: String = if s_idx > 0 { str_slice(after, 0, s_idx) } else { after };
        if u != "" { return "/home/" + u; }
    }
    if str_starts_with(cwd, "/root") { return "/root"; }
    return "";
}

fn path_dirname(p: String) -> String {
    let n: Int = chars_len(p);
    let mut i: Int = n;
    while i > 0 {
        i = i - 1;
        if char_at(p, i) == "/" {
            if i == 0 { return "/"; }
            return str_slice(p, 0, i);
        }
    }
    return "";
}

pub fn resolve_git_branch(fs_r: &FsReadCap, cwd: String) -> String {
    let mut cur: String = cwd;
    let mut depth: Int = 0;
    while depth < 8 {
        let head_path: String = if cur == "/" { "/.git/HEAD" } else { cur + "/.git/HEAD" };
        let r: Result[String, String] = read_file(fs_r, head_path);
        if r.is_ok() {
            let content: String = str_trim(match r { Ok(s) => s, Err(_) => "" });
            if str_starts_with(content, "ref: refs/heads/") {
                return str_slice(content, 16, chars_len(content));
            }
            if chars_len(content) >= 7 {
                return str_slice(content, 0, 7);
            }
            return content;
        }
        if cur == "/" || cur == "" || cur == "." {
            break;
        }
        let parent: String = path_dirname(cur);
        if parent == cur || parent == "" {
            break;
        }
        cur = parent;
        depth = depth + 1;
    }
    return "";
}

pub fn render_ambient_dock(fs_r: &FsReadCap, env: &EnvCap, cwd: String, has_failure: Bool, last_rc: Int) -> String {
    let home: String = resolve_ambient_home(env, cwd);
    let mut disp_cwd: String = cwd + "";
    if home != "" {
        if cwd == home {
            disp_cwd = "~";
        } else if str_starts_with(cwd, home + "/") {
            disp_cwd = "~" + str_slice(cwd, chars_len(home), chars_len(cwd));
        }
    }
    let branch: String = resolve_git_branch(fs_r, cwd);
    let user_name: String = resolve_ambient_user(env, cwd);
    let host_file: Result[String, String] = read_file(fs_r, "/etc/hostname");
    let host_name: String = match host_file { Ok(s) => str_trim(s), Err(_) => "node" };
    let node: String = user_name + "@" + (if host_name != "" { host_name } else { "node" });

    let esc: String = bytes_to_str(bytes_push(bytes_new(), 27));
    let cyan: String = esc + "[38;2;0;240;255m";
    let purple: String = esc + "[38;2;189;0;255m";
    let amber: String = esc + "[38;2;255;184;0m";
    let gray: String = esc + "[38;2;110;120;140m";
    let rst: String = esc + "[0m";

    let branch_part: String = if branch != "" { " " + purple + "(git:" + branch + ")" + rst } else { "" };
    let host_part: String = gray + "[" + node + "]" + rst;
    let path_part: String = " " + cyan + disp_cwd + rst;
    let cap_part: String = " " + amber + "[CAPS: PROC+FS+NET]" + rst;

    return host_part + path_part + branch_part + cap_part + "\r\n";
}
