// # Active Failure Diagnostics & Remedy Engine
//
// Logline: Analyzes failure envelopes to generate targeted root cause diagnostics and remediation commands.
//
// Setup: Inspects session FlightRecord and FailureEnvelope, renders 68-col Algiz card.
//
// Beats:
//   1. Inspect failure envelope from active flight recorder.
//   2. Route failure parameters through diagnostic rules engine (command not found, permission, git, build).
//   3. Synthesize actionable remediation commands and guidance card.

import "ui/palette.oo";
import "ui/card.oo";
import "envelope.oo";
import "rules.oo";

fn safe_prefix(s: String, max_chars: Int) -> String {
    if chars_len(s) <= max_chars { return s; }
    return str_slice(s, 0, max_chars);
}

pub fn render_remedy_card(has_failed: Bool, cmd: String, exit_code: Int, err_str: String, cwd: String) -> String {
    let top: String = card_top("", "OOSH REMEDY FAILURE DIAGNOSTICS");

    if !has_failed {
        let r1: String = card_row("Diagnostic", "No active failure trace detected in current scope.");
        let r2: String = card_row("Status", "Nominal operating envelope. Zero faults detected.");
        let r3: String = card_row("Hint", "If a command fails, invoke 'remedy' or 'fix' immediately.");
        let bot: String = card_bottom("ENVELOPE NOMINAL");
        return top + "\n" + r1 + "\n" + r2 + "\n" + r3 + "\n" + bot;
    }

    let code_str: String = exit_code.to_string();
    let diag: DiagnosticResult = match_failure_rules(cmd, exit_code, err_str, cwd);

    let sec1: String = card_section("FAULT ENVELOPE");
    let r_cmd: String = card_row("Faulted Command", safe_prefix(cmd, 50));
    let r_rc: String = card_row_colored("Exit Code", code_str, cyber_red());
    let r_err_val: String = if err_str == "" { "(no captured stream)" } else { safe_prefix(err_str, 50) };
    let r_err: String = card_row("Captured Stream", r_err_val);

    let sec2: String = card_section("ROOT CAUSE ANALYSIS");
    let r_cat: String = card_row_colored("Category", diag.category, cyber_purple());
    let r_diag: String = card_row_colored("Diagnosis", diag.summary, cyber_amber());
    let r_exp: String = card_row("Reasoning", diag.explanation);

    let sec3: String = card_section("PROPOSED REMEDIATION");
    let r_act: String = card_row_colored("Actionable", diag.actionable_cmd, cyber_green());
    let r_sec: String = card_row_colored("Alternative", diag.secondary_cmd, cyber_cyan());

    let bot: String = card_bottom("REMEDY READY");
    return top + "\n" + sec1 + "\n" + r_cmd + "\n" + r_rc + "\n" + r_err + "\n" +
           sec2 + "\n" + r_cat + "\n" + r_diag + "\n" + r_exp + "\n" +
           sec3 + "\n" + r_act + "\n" + r_sec + "\n" + bot;
}

pub fn diagnose_failure(rec: FlightRecord) -> String {
    return render_remedy_card(rec.has_failed, rec.last_failed_cmd, rec.last_exit_code, rec.last_stderr, "");
}

pub fn diagnose_failure_cwd(rec: FlightRecord, cwd: String) -> String {
    return render_remedy_card(rec.has_failed, rec.last_failed_cmd, rec.last_exit_code, rec.last_stderr, cwd);
}

pub fn diagnose_envelope(env: FailureEnvelope) -> String {
    return render_remedy_card(env.has_failed, env.cmd, env.exit_code, env.output, env.cwd);
}
