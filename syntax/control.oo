// # Syntax Control Flow and Function Table
//
// Logline: Parses and evaluates loops (for/while), conditionals (if/case), subshells, and functions.
//
// Setup: Bridges control flow statements and in-memory function definitions.
//
// Beats:
//   1. Maintain session function table for user-defined shell functions.
//   2. Parse and evaluate test/[ conditions, string equality, and numeric comparisons.
//   3. Recognize for/while loops, if/case conditionals, and subshell blocks.

import "lexer.oo";
import "arith.oo";
import "std/fs/process/process.oo";

pub type FunctionMap = struct { names: List[String], bodies: List[String] };
pub fn func_map_new() -> FunctionMap { return FunctionMap { names: list_new(), bodies: list_new() }; }
pub fn func_map_get(m: FunctionMap, name: String) -> Result[String, String] {
    let n: Int = list_len(m.names); let mut i: Int = 0;
    while i < n {
        if list_get(m.names, i) == name { return Ok(list_get(m.bodies, i)); }
        i = i + 1;
    }
    return Err("not_found");
}
pub fn func_map_set(m: FunctionMap, name: String, body: String) -> FunctionMap {
    let mut new_n: List[String] = list_new(); let mut new_b: List[String] = list_new();
    let n: Int = list_len(m.names); let mut i: Int = 0;
    while i < n {
        if list_get(m.names, i) != name { new_n = list_push(new_n, list_get(m.names, i)); new_b = list_push(new_b, list_get(m.bodies, i)); }
        i = i + 1;
    }
    return FunctionMap { names: list_push(new_n, name), bodies: list_push(new_b, body) };
}

pub fn is_subshell_stmt(line: String) -> Bool {
    let t: String = str_trim(line); return chars_len(t) >= 2 && str_starts_with(t, "(") && str_ends_with(t, ")");
}
pub fn extract_subshell_body(line: String) -> String {
    let t: String = str_trim(line); let n: Int = chars_len(t);
    return if n >= 2 && str_starts_with(t, "(") && str_ends_with(t, ")") { str_trim(str_slice(t, 1, n - 1)) } else { t };
}
pub fn is_function_def(line: String) -> Bool {
    let t: String = str_trim(line); return (str_starts_with(t, "function ") || str_index_of(t, "()") > 0) && str_contains(t, "{") && str_ends_with(t, "}");
}
pub fn parse_function_def(line: String) -> Result[CompoundSplit, String] {
    let t: String = str_trim(line); let o_brace: Int = str_index_of(t, "{");
    let mut c_brace: Int = -1; let mut ci: Int = chars_len(t) - 1;
    while ci >= 0 {
        if char_at(t, ci) == "}" { c_brace = ci; ci = -1; } else { ci = ci - 1; }
    }
    if o_brace < 0 || c_brace <= o_brace { return Err("malformed_function"); }
    let body: String = str_trim(str_slice(t, o_brace + 1, c_brace));
    let head: String = str_trim(str_slice(t, 0, o_brace));
    let name: String = if str_starts_with(head, "function ") {
        let after_fn: String = str_trim(str_slice(head, 9, chars_len(head)));
        if str_contains(after_fn, "()") { str_trim(str_slice(after_fn, 0, str_index_of(after_fn, "()"))) } else { after_fn }
    } else {
        let p: Int = str_index_of(head, "()");
        if p > 0 { str_trim(str_slice(head, 0, p)) } else { head }
    };
    return Ok(CompoundSplit { lhs: name, op: "def", rhs: body });
}

pub type ForLoopDef = struct { var_name: String, items: List[String], body: String };
pub type WhileLoopDef = struct { cond: String, body: String };
pub type IfStmtDef = struct { cond: String, then_body: String, else_body: String };
pub type CaseStmtDef = struct { matched_body: String };
pub fn for_def_empty() -> ForLoopDef { return ForLoopDef { var_name: "", items: list_new(), body: "" }; }

fn trim_semi(s: String) -> String {
    let t: String = str_trim(s);
    return if str_ends_with(t, ";") { str_trim(str_slice(t, 0, chars_len(t) - 1)) } else { t };
}

pub fn find_keyword_delimited(line: String, kw: String, last: Bool) -> Int {
    let n: Int = chars_len(line); let kn: Int = chars_len(kw);
    if kn == 0 || n < kn { return -1; }
    let mut in_s: Bool = false; let mut in_d: Bool = false; let mut esc: Bool = false;
    let mut last_pos: Int = -1; let mut i: Int = 0;
    while i <= n - kn {
        let ch: String = char_at(line, i);
        if esc { esc = false; i = i + 1; }
        else if ch == "\\" && !in_s { esc = true; i = i + 1; }
        else if ch == "'" && !in_d { in_s = !in_s; i = i + 1; }
        else if ch == "\"" && !in_s { in_d = !in_d; i = i + 1; }
        else if !in_s && !in_d {
            if str_slice(line, i, i + kn) == kw {
                let p_ok: Bool = i == 0 || char_at(line, i - 1) == " " || char_at(line, i - 1) == "\t" || char_at(line, i - 1) == "\n" || char_at(line, i - 1) == ";";
                let n_ok: Bool = i + kn == n || char_at(line, i + kn) == " " || char_at(line, i + kn) == "\t" || char_at(line, i + kn) == "\n" || char_at(line, i + kn) == ";";
                if p_ok && n_ok { if !last { return i; } last_pos = i; }
            }
            i = i + 1;
        } else { i = i + 1; }
    }
    return last_pos;
}

pub fn parse_for_stmt(line: String) -> Result[ForLoopDef, String] {
    let do_i: Int = find_keyword_delimited(line, "do", false);
    let done_i: Int = find_keyword_delimited(line, "done", true);
    if do_i <= 0 || done_i <= do_i { return Err("malformed_for"); }
    let header: String = trim_semi(str_slice(line, 4, do_i));
    let body: String = trim_semi(str_slice(line, do_i + 2, done_i));
    let h_toks: List[String] = split_cmd_tokens_quote_aware(header);
    if list_len(h_toks) < 3 { return Err("missing_in_clause"); }
    let var_name: String = list_get(h_toks, 0);
    let mut items: List[String] = list_new(); let mut hi: Int = 2;
    while hi < list_len(h_toks) { items = list_push(items, list_get(h_toks, hi)); hi = hi + 1; }
    return Ok(ForLoopDef { var_name: var_name, items: items, body: body });
}

pub fn parse_while_stmt(line: String) -> Result[WhileLoopDef, String] {
    let do_i: Int = find_keyword_delimited(line, "do", false);
    let done_i: Int = find_keyword_delimited(line, "done", true);
    if do_i <= 0 || done_i <= do_i { return Err("malformed_while"); }
    return Ok(WhileLoopDef { cond: trim_semi(str_slice(line, 6, do_i)), body: trim_semi(str_slice(line, do_i + 2, done_i)) });
}

pub fn parse_if_stmt(line: String) -> Result[IfStmtDef, String] {
    let t: String = str_trim(line); let n: Int = chars_len(t);
    if !str_starts_with(t, "if ") || n < 8 { return Err("not_if"); }
    let mut in_s: Bool = false; let mut in_d: Bool = false; let mut esc: Bool = false;
    let mut depth: Int = 0; let mut then_pos: Int = -1; let mut elif_pos: Int = -1;
    let mut else_pos: Int = -1; let mut fi_pos: Int = -1; let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(t, i);
        if esc { esc = false; i = i + 1; }
        else if ch == "\\" && !in_s { esc = true; i = i + 1; }
        else if ch == "'" && !in_d { in_s = !in_s; i = i + 1; }
        else if ch == "\"" && !in_s { in_d = !in_d; i = i + 1; }
        else if !in_s && !in_d {
            let p_ok: Bool = i == 0 || char_at(t, i - 1) == " " || char_at(t, i - 1) == "\t" || char_at(t, i - 1) == "\n" || char_at(t, i - 1) == ";";
            if p_ok {
                let rem_len: Int = n - i;
                if rem_len >= 2 && str_slice(t, i, i + 2) == "if" && (i + 2 == n || char_at(t, i + 2) == " " || char_at(t, i + 2) == "\t" || char_at(t, i + 2) == "\n" || char_at(t, i + 2) == ";") {
                    depth = depth + 1; i = i + 2;
                } else if rem_len >= 2 && str_slice(t, i, i + 2) == "fi" && (i + 2 == n || char_at(t, i + 2) == " " || char_at(t, i + 2) == "\t" || char_at(t, i + 2) == "\n" || char_at(t, i + 2) == ";") {
                    depth = depth - 1;
                    if depth == 0 { fi_pos = i; i = n; } else { i = i + 2; }
                } else if depth == 1 && rem_len >= 4 && str_slice(t, i, i + 4) == "then" && (i + 4 == n || char_at(t, i + 4) == " " || char_at(t, i + 4) == "\t" || char_at(t, i + 4) == "\n" || char_at(t, i + 4) == ";") {
                    if then_pos < 0 { then_pos = i; } i = i + 4;
                } else if depth == 1 && rem_len >= 4 && str_slice(t, i, i + 4) == "elif" && (i + 4 == n || char_at(t, i + 4) == " " || char_at(t, i + 4) == "\t" || char_at(t, i + 4) == "\n" || char_at(t, i + 4) == ";") {
                    if elif_pos < 0 && else_pos < 0 { elif_pos = i; } i = i + 4;
                } else if depth == 1 && rem_len >= 4 && str_slice(t, i, i + 4) == "else" && (i + 4 == n || char_at(t, i + 4) == " " || char_at(t, i + 4) == "\t" || char_at(t, i + 4) == "\n" || char_at(t, i + 4) == ";") {
                    if else_pos < 0 && elif_pos < 0 { else_pos = i; } i = i + 4;
                } else { i = i + 1; }
            } else { i = i + 1; }
        } else { i = i + 1; }
    }
    if then_pos < 0 || fi_pos < 0 { return Err("malformed_if"); }
    let cond: String = trim_semi(str_slice(t, 3, then_pos));
    if elif_pos > 0 {
        return Ok(IfStmtDef { cond: cond, then_body: trim_semi(str_slice(t, then_pos + 4, elif_pos)), else_body: "if " + str_trim(str_slice(t, elif_pos + 4, fi_pos)) + "; fi" });
    }
    if else_pos > 0 {
        return Ok(IfStmtDef { cond: cond, then_body: trim_semi(str_slice(t, then_pos + 4, else_pos)), else_body: trim_semi(str_slice(t, else_pos + 4, fi_pos)) });
    }
    return Ok(IfStmtDef { cond: cond, then_body: trim_semi(str_slice(t, then_pos + 4, fi_pos)), else_body: "" });
}

pub fn is_case_stmt(line: String) -> Bool {
    let t: String = str_trim(line); let in_i: Int = find_keyword_delimited(t, "in", false);
    return str_starts_with(t, "case ") && in_i > 0 && find_keyword_delimited(t, "esac", true) > in_i;
}

pub fn parse_case_stmt(line: String) -> Result[CaseStmtDef, String] {
    let in_i: Int = find_keyword_delimited(line, "in", false);
    let esac_i: Int = find_keyword_delimited(line, "esac", true);
    if in_i <= 0 || esac_i <= in_i { return Err("malformed_case"); }
    let raw_w: String = str_trim(str_slice(line, 5, in_i)); let wlen: Int = chars_len(raw_w);
    let target_word: String = if wlen >= 2 && ((str_starts_with(raw_w, "\"") && str_ends_with(raw_w, "\"")) || (str_starts_with(raw_w, "'") && str_ends_with(raw_w, "'"))) { str_slice(raw_w, 1, wlen - 1) } else { raw_w };
    let body: String = str_slice(line, in_i + 2, esac_i); let bn: Int = chars_len(body);
    let mut i: Int = 0; let mut chunk_start: Int = 0;
    while i <= bn {
        let is_sep: Bool = if i + 1 < bn { char_at(body, i) == ";" && char_at(body, i + 1) == ";" } else { i == bn };
        if is_sep {
            let chunk: String = str_trim(str_slice(body, chunk_start, i)); let p_idx: Int = str_index_of(chunk, ")");
            if p_idx > 0 {
                let pat: String = str_trim(str_slice(chunk, 0, p_idx)); let action: String = str_trim(str_slice(chunk, p_idx + 1, chars_len(chunk)));
                if pat == target_word || pat == "*" || (str_ends_with(pat, "*") && str_starts_with(target_word, str_slice(pat, 0, chars_len(pat) - 1))) {
                    return Ok(CaseStmtDef { matched_body: action });
                }
            }
            chunk_start = i + 2; i = i + 1;
        }
        i = i + 1;
    }
    return Ok(CaseStmtDef { matched_body: "" });
}

pub fn is_for_stmt(line: String) -> Bool { return str_starts_with(str_trim(line), "for ") && parse_for_stmt(line).is_ok(); }
pub fn is_while_stmt(line: String) -> Bool { return str_starts_with(str_trim(line), "while ") && parse_while_stmt(line).is_ok(); }
pub fn is_if_stmt(line: String) -> Bool { return str_starts_with(str_trim(line), "if ") && parse_if_stmt(line).is_ok(); }

pub fn eval_test_tokens(sys: &ProcessCap, tokens: List[String]) -> Bool {
    let n: Int = list_len(tokens);
    if n == 0 { return false; }
    let first: String = list_get(tokens, 0);
    let start_i: Int = if first == "test" || first == "[" { 1 } else { 0 };
    let end_i: Int = if n > start_i && list_get(tokens, n - 1) == "]" { n - 1 } else { n };
    let mut args: List[String] = list_new(); let mut i: Int = start_i;
    while i < end_i { args = list_push(args, list_get(tokens, i)); i = i + 1; }
    let argc: Int = list_len(args);
    if argc == 0 { return false; }
    if argc == 1 { return list_get(args, 0) != ""; }
    if argc == 2 {
        let op: String = list_get(args, 0); let val: String = list_get(args, 1);
        if op == "-z" { return val == ""; }
        if op == "-n" { return val != ""; }
        if op == "!" { return val == ""; }
    }
    if argc == 3 {
        let a0: String = list_get(args, 0); let op: String = list_get(args, 1); let a2: String = list_get(args, 2);
        if op == "=" || op == "==" { return a0 == a2; }
        if op == "!=" { return a0 != a2; }
        if op == "-eq" || op == "-ne" || op == "-lt" || op == "-le" || op == "-gt" || op == "-ge" {
            let v1: Int = parse_int_safe(a0); let v2: Int = parse_int_safe(a2);
            if op == "-eq" { return v1 == v2; } else if op == "-ne" { return v1 != v2; }
            else if op == "-lt" { return v1 < v2; } else if op == "-le" { return v1 <= v2; }
            else if op == "-gt" { return v1 > v2; } else if op == "-ge" { return v1 >= v2; }
        }
    }
    let mut cmd: String = "test"; let mut fi: Int = 0;
    while fi < argc { cmd = cmd + " \"" + list_get(args, fi) + "\""; fi = fi + 1; }
    return process_exec(sys, cmd).is_ok();
}
