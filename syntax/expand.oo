// # Syntax Parameter and Command Substitution Engine
//
// Logline: Expands environment variables, script positional arguments, and command substitutions.
//
// Setup: Receives ProcessCap, EnvCap, and SessionState for parameter and subshell resolution.
//
// Beats:
//   1. Expand nested command substitutions ($(cmd) and `cmd`) via subshell capture.
//   2. Resolve positional arguments ($0..$9, $#, $@, $*) and exit status ($?).
//   3. Expand bracketed (${VAR}) and bare ($VAR) environment variables with quote safety.

import "std/fs/process/env.oo";
import "std/fs/process/process.oo";

pub type EnvMap = struct {
    keys: List[String],
    vals: List[String]
};

pub fn env_map_new() -> EnvMap {
    let empty_k: List[String] = list_new();
    let empty_v: List[String] = list_new();
    return EnvMap { keys: empty_k, vals: empty_v };
}

pub fn env_map_get(m: EnvMap, key: String) -> Result[String, String] {
    let n: Int = list_len(m.keys);
    let mut i: Int = 0;
    while i < n {
        if list_get(m.keys, i) == key { return Ok(list_get(m.vals, i)); }
        i = i + 1;
    }
    return Err("not_found");
}

pub fn env_map_set(m: EnvMap, key: String, val: String) -> EnvMap {
    let mut new_k: List[String] = list_new();
    let mut new_v: List[String] = list_new();
    let n: Int = list_len(m.keys);
    let mut i: Int = 0;
    while i < n {
        if list_get(m.keys, i) != key {
            new_k = list_push(new_k, list_get(m.keys, i));
            new_v = list_push(new_v, list_get(m.vals, i));
        }
        i = i + 1;
    }
    return EnvMap { keys: list_push(new_k, key), vals: list_push(new_v, val) };
}

pub fn env_map_remove(m: EnvMap, key: String) -> EnvMap {
    let mut new_k: List[String] = list_new();
    let mut new_v: List[String] = list_new();
    let n: Int = list_len(m.keys);
    let mut i: Int = 0;
    while i < n {
        if list_get(m.keys, i) != key {
            new_k = list_push(new_k, list_get(m.keys, i));
            new_v = list_push(new_v, list_get(m.vals, i));
        }
        i = i + 1;
    }
    return EnvMap { keys: new_k, vals: new_v };
}

pub fn expand_subshell_captures(sys: &ProcessCap, line: String) -> String {
    let n: Int = chars_len(line);
    let mut out: String = "";
    let mut in_s: Bool = false;
    let mut in_d: Bool = false;
    let mut esc: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(line, i);
        if esc {
            out = out + ch; esc = false; i = i + 1;
        } else if ch == "\\" && !in_s {
            esc = true; out = out + ch; i = i + 1;
        } else if ch == "'" && !in_d {
            in_s = !in_s; out = out + ch; i = i + 1;
        } else if ch == "\"" && !in_s {
            in_d = !in_d; out = out + ch; i = i + 1;
        } else if !in_s && ch == "$" && i + 1 < n && char_at(line, i + 1) == "(" {
            let mut depth: Int = 1;
            let mut ci: Int = i + 2;
            while ci < n && depth > 0 {
                let cch: String = char_at(line, ci);
                if cch == "(" { depth = depth + 1; }
                else if cch == ")" { depth = depth - 1; }
                if depth > 0 { ci = ci + 1; }
            }
            if depth == 0 {
                let inner_cmd: String = str_slice(line, i + 2, ci);
                let rec_cmd: String = expand_subshell_captures(sys, inner_cmd);
                let r: Result[String, String] = process_exec(sys, rec_cmd);
                let mut captured: String = match r { Ok(s) => s, Err(_) => "" };
                while str_ends_with(captured, "\n") || str_ends_with(captured, "\r") {
                    captured = str_slice(captured, 0, chars_len(captured) - 1);
                }
                out = out + captured;
                i = ci + 1;
            } else {
                out = out + "$(";
                i = i + 2;
            }
        } else if !in_s && ch == "`" {
            let mut ci: Int = i + 1;
            while ci < n && char_at(line, ci) != "`" { ci = ci + 1; }
            if ci < n {
                let inner_cmd: String = str_slice(line, i + 1, ci);
                let rec_cmd: String = expand_subshell_captures(sys, inner_cmd);
                let r: Result[String, String] = process_exec(sys, rec_cmd);
                let mut captured: String = match r { Ok(s) => s, Err(_) => "" };
                while str_ends_with(captured, "\n") || str_ends_with(captured, "\r") {
                    captured = str_slice(captured, 0, chars_len(captured) - 1);
                }
                out = out + captured;
                i = ci + 1;
            } else {
                out = out + "`";
                i = i + 1;
            }
        } else {
            out = out + ch;
            i = i + 1;
        }
    }
    return out;
}

pub fn expand_variables_safe(env: &EnvCap, env_map: EnvMap, last_rc: Int, line: String) -> String {
    let n: Int = chars_len(line);
    let mut out: String = "";
    let mut in_s: Bool = false;
    let mut in_d: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(line, i);
        if ch == "'" && !in_d {
            in_s = !in_s; out = out + ch; i = i + 1;
        } else if ch == "\"" && !in_s {
            in_d = !in_d; out = out + ch; i = i + 1;
        } else if ch == "$" && !in_s && i + 1 < n {
            let next_ch: String = char_at(line, i + 1);
            if next_ch == "?" {
                out = out + last_rc.to_string();
                i = i + 2;
            } else if next_ch == "#" || next_ch == "@" || next_ch == "*" || (byte_at(next_ch, 0) >= 48 && byte_at(next_ch, 0) <= 57) {
                let val: String = match env_map_get(env_map, next_ch) {
                    Ok(v) => v,
                    Err(_) => match env_get(env, next_ch) { Ok(ev) => ev, Err(_) => "" }
                };
                out = out + val;
                i = i + 2;
            } else if next_ch == "{" {
                let mut close_idx: Int = -1;
                let mut ci: Int = i + 2;
                while ci < n {
                    if char_at(line, ci) == "}" { close_idx = ci; ci = n; }
                    else { ci = ci + 1; }
                }
                if close_idx >= 0 {
                    let k: String = str_slice(line, i + 2, close_idx);
                    let val: String = match env_map_get(env_map, k) {
                        Ok(v) => v,
                        Err(_) => match env_get(env, k) { Ok(ev) => ev, Err(_) => "" }
                    };
                    out = out + val;
                    i = close_idx + 1;
                } else { out = out + "${"; i = i + 2; }
            } else {
                let mut vi: Int = i + 1;
                let mut var_name: String = "";
                while vi < n {
                    let vc: String = char_at(line, vi);
                    let vb: Int = byte_at(vc, 0);
                    if (vb >= 65 && vb <= 90) || (vb >= 97 && vb <= 122) || (vb >= 48 && vb <= 57) || vb == 95 {
                        var_name = var_name + vc;
                        vi = vi + 1;
                    } else { vi = n; }
                }
                if chars_len(var_name) > 0 {
                    let val: String = match env_map_get(env_map, var_name) {
                        Ok(v) => v,
                        Err(_) => match env_get(env, var_name) { Ok(ev) => ev, Err(_) => "" }
                    };
                    out = out + val;
                    i = i + 1 + chars_len(var_name);
                } else { out = out + "$"; i = i + 1; }
            }
        } else { out = out + ch; i = i + 1; }
    }
    return out;
}

pub fn expand_command_line(sys: &ProcessCap, env: &EnvCap, env_map: EnvMap, last_rc: Int, line: String) -> String {
    let sub: String = expand_subshell_captures(sys, line);
    return expand_variables_safe(env, env_map, last_rc, sub);
}
