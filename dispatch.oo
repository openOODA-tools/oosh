// # oosh Command Dispatcher
//
// Logline: Dispatches shell input lines to internal builtins, intent queries, or host system processes.
//
// Setup: Receives ProcessCap, EnvCap, FfiCap, FsWriteCap, FsReadCap, FlightRecord, and SessionState.
//
// Beats:
//   1. Expand command aliases and handle builtin session state (history, alias, unalias, export, unset).
//   2. Wire builtin output streams directly to pipes and files without intermediate disk files.
//   3. Mutate active directory state for cd and take requests natively via syscalls without subshells.
//   4. Dispatch host system commands directly via sys_exec_wait with terminal control.

import "alias.oo";
import "anchor.oo";
import "manual.oo";
import "ui/anchor.oo";
import "diagnostics/anchor.oo";
import "flight/anchor.oo";
import "intent/anchor.oo";
import "ipc/anchor.oo";
import "syntax/anchor.oo";
import "exec/anchor.oo";
import "job/anchor.oo";

pub type DispatchResult = struct {
    next_cwd: String,
    should_exit: Bool,
    exit_code: Int,
    flight_rec: FlightRecord,
    aliases: AliasMap,
    session: SessionState
};

fn is_exit(cmd: String) -> Bool { return cmd == "exit" || cmd == "quit" || cmd == "q" || cmd == ":q" || cmd == ":q!" || cmd == ":x" || cmd == "bye" || cmd == "logout"; }

fn make_res(cwd: String, exit: Bool, rc: Int, rec: FlightRecord, sess: SessionState) -> DispatchResult { return DispatchResult { next_cwd: cwd, should_exit: exit, exit_code: rc, flight_rec: rec, aliases: sess.alias_map, session: sess }; }

pub fn dispatch_line(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, env: &EnvCap, ffi: &FfiCap, raw_line: String, rec: FlightRecord, session: SessionState) -> DispatchResult {
    let mut raw_trimmed: String = str_trim(raw_line);
    let cwd: String = session.cwd;
    if raw_trimmed == "" { return make_res(cwd, false, 0, rec, session); }

    let split: CompoundSplit = find_compound_split(raw_trimmed);
    if split.op != "" {
        let res1: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, split.lhs, rec, session);
        if res1.should_exit { return res1; }
        if split.op == ";" || (split.op == "&&" && res1.exit_code == 0) || (split.op == "||" && res1.exit_code != 0) {
            return dispatch_line(fs_r, fs_w, sys, env, ffi, split.rhs, res1.flight_rec, res1.session);
        }
        return res1;
    }

    if str_starts_with(raw_trimmed, "#") { return make_res(cwd, false, 0, rec, session); }
    if str_starts_with(raw_trimmed, "rune ") { raw_trimmed = str_trim(str_slice(raw_trimmed, 5, chars_len(raw_trimmed))); }

    if is_subshell_stmt(raw_trimmed) {
        let sub_res: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, extract_subshell_body(raw_trimmed), rec, session);
        if sub_res.next_cwd != cwd { let _ = oo_tui_write(ffi, "\x1b_cd:" + cwd); }
        return make_res(cwd, sub_res.should_exit, sub_res.exit_code, sub_res.flight_rec, session);
    }

    if is_function_def(raw_trimmed) {
        let def_r: Result[CompoundSplit, String] = parse_function_def(raw_trimmed);
        if def_r.is_ok() {
            let def: CompoundSplit = match def_r { Ok(d) => d, Err(_) => CompoundSplit { lhs: "", op: "", rhs: "" } };
            let next_sess: SessionState = SessionState { cwd: cwd, env_map: session.env_map, alias_map: session.alias_map, job_table: session.job_table, func_map: func_map_set(session.func_map, def.lhs, def.rhs) };
            return make_res(cwd, false, 0, flight_success(rec, raw_trimmed, 0), next_sess);
        }
    }

    if is_for_stmt(raw_trimmed) {
        let f_r: Result[ForLoopDef, String] = parse_for_stmt(raw_trimmed);
        if f_r.is_ok() {
            let f: ForLoopDef = match f_r { Ok(v) => v, Err(_) => for_def_empty() };
            let mut cur_s: SessionState = session;
            let mut cur_rec: FlightRecord = rec;
            let mut last_rc: Int = 0;
            let mut item_i: Int = 0;
            while item_i < list_len(f.items) {
                cur_s = SessionState { cwd: cur_s.cwd, env_map: env_map_set(cur_s.env_map, f.var_name, list_get(f.items, item_i)), alias_map: cur_s.alias_map, job_table: cur_s.job_table, func_map: cur_s.func_map };
                let res: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, f.body, cur_rec, cur_s);
                cur_rec = res.flight_rec; cur_s = res.session; last_rc = res.exit_code;
                if res.should_exit { return res; }
                item_i = item_i + 1;
            }
            return make_res(cwd, false, last_rc, cur_rec, cur_s);
        }
    }

    if is_while_stmt(raw_trimmed) {
        let w_r: Result[WhileLoopDef, String] = parse_while_stmt(raw_trimmed);
        if w_r.is_ok() {
            let w: WhileLoopDef = match w_r { Ok(v) => v, Err(_) => WhileLoopDef { cond: "", body: "" } };
            let mut cur_s: SessionState = session;
            let mut cur_rec: FlightRecord = rec;
            let mut last_rc: Int = 0;
            let mut guard: Int = 0;
            while guard < 1000 {
                let c_res: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, w.cond, cur_rec, cur_s);
                if c_res.exit_code != 0 { guard = 1001; } else {
                    let b_res: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, w.body, c_res.flight_rec, c_res.session);
                    cur_rec = b_res.flight_rec; cur_s = b_res.session; last_rc = b_res.exit_code;
                    if b_res.should_exit { return b_res; }
                    guard = guard + 1;
                }
            }
            return make_res(cwd, false, last_rc, cur_rec, cur_s);
        }
    }

    if is_if_stmt(raw_trimmed) {
        let i_r: Result[IfStmtDef, String] = parse_if_stmt(raw_trimmed);
        if i_r.is_ok() {
            let stmt: IfStmtDef = match i_r { Ok(v) => v, Err(_) => IfStmtDef { cond: "", then_body: "", else_body: "" } };
            let c_res: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, stmt.cond, rec, session);
            if c_res.exit_code == 0 { return dispatch_line(fs_r, fs_w, sys, env, ffi, stmt.then_body, c_res.flight_rec, c_res.session); }
            if stmt.else_body != "" { return dispatch_line(fs_r, fs_w, sys, env, ffi, stmt.else_body, c_res.flight_rec, c_res.session); }
            return make_res(cwd, false, 0, c_res.flight_rec, c_res.session);
        }
    }

    if is_case_stmt(raw_trimmed) {
        let cs_r: Result[CaseStmtDef, String] = parse_case_stmt(raw_trimmed);
        if cs_r.is_ok() {
            let cs: CaseStmtDef = match cs_r { Ok(v) => v, Err(_) => CaseStmtDef { matched_body: "" } };
            if cs.matched_body != "" { return dispatch_line(fs_r, fs_w, sys, env, ffi, cs.matched_body, rec, session); }
            return make_res(cwd, false, 0, flight_success(rec, raw_trimmed, 0), session);
        }
    }

    let expanded: String = expand_command_line(sys, env, session.env_map, rec.last_exit_code, raw_trimmed);
    let line: String = alias_expand(session.alias_map, expanded);

    if has_unquoted_background(line) {
        let next_jobs: JobTable = spawn_background(ffi, session.job_table, strip_unquoted_background(line));
        return make_res(cwd, false, 0, flight_success(rec, line, 0), SessionState { cwd: cwd, env_map: session.env_map, alias_map: session.alias_map, job_table: next_jobs, func_map: session.func_map });
    }

    let r_split: RedirectSplit = find_unquoted_redirect(line);
    let pipe_i: Int = find_unquoted_pipe(line);
    if r_split.found && pipe_i < 0 {
        let b_res: Result[String, String] = get_all_builtin_output(sys, env, fs_r, cwd, rec, r_split.lhs, session);
        if b_res.is_ok() {
            let _ = route_builtin_redirection(fs_w, match b_res { Ok(s) => s, Err(_) => "" }, cwd, r_split.target, r_split.op == ">>");
            return make_res(cwd, false, 0, flight_success(rec, line, 0), session);
        }
    }
    if pipe_i >= 0 {
        let lhs: String = str_trim(str_slice(line, 0, pipe_i));
        let rhs: String = str_trim(str_slice(line, pipe_i + 1, chars_len(line)));
        let b_res: Result[String, String] = get_all_builtin_output(sys, env, fs_r, cwd, rec, lhs, session);
        if b_res.is_ok() {
            let prc: Int = route_builtin_pipeline(ffi, match b_res { Ok(s) => s, Err(_) => "" }, rhs);
            return make_res(cwd, false, prc, if prc == 0 { flight_success(rec, line, 0) } else { flight_failure(rec, line, prc, "", 0) }, session);
        }
    }

    if is_exit(line) { return make_res(cwd, true, 0, rec, session); }
    if is_version_cmd(line) { println("oosh " + oosh_version()); return make_res(cwd, false, 0, rec, session); }
    if is_job_cmd(line) {
        let jr: Result[JobTable, String] = dispatch_job_cmd(ffi, line, session.job_table);
        if jr.is_ok() {
            return make_res(cwd, false, 0, flight_success(rec, line, 0), SessionState { cwd: cwd, env_map: session.env_map, alias_map: session.alias_map, job_table: match jr { Ok(t) => t, Err(_) => session.job_table }, func_map: session.func_map });
        }
        return make_res(cwd, false, 1, flight_failure(rec, line, 1, "", 0), session);
    }
    if dispatch_manual(sys, cwd, line) || dispatch_ui(sys, cwd, line) || dispatch_diagnostics(sys, cwd, rec, line) { return make_res(cwd, false, 0, rec, session); }
    if is_link_cmd(line) { ipc_dispatch_link(sys, env, cwd, rec, line); return make_res(cwd, false, 0, rec, session); }
    if intent_is_query(line) || str_starts_with(line, "ai ") {
        let q: IntentQuery = parse_intent_query(line);
        if q.is_bare { println(intent_bare_guidance(q.prefix)); return make_res(cwd, false, 0, rec, session); }
        let action: IntentPromptAction = intent_prompt(fs_r, sys, line, cwd);
        if action.should_execute && action.command_to_run != "" { return dispatch_line(fs_r, fs_w, sys, env, ffi, action.command_to_run, rec, session); }
        return make_res(cwd, false, 0, rec, session);
    }
    if line == "pwd" || line == "cwd" || line == "where" || line == "here" { println(cwd); return make_res(cwd, false, 0, rec, session); }
    if is_session_builtin(line) {
        let b_res: Result[SessionState, String] = dispatch_session_builtin(ffi, fs_r, sys, env, cwd, line, session);
        if b_res.is_ok() {
            let next_s: SessionState = match b_res { Ok(s) => s, Err(_) => session };
            return make_res(cwd, false, 0, flight_success(rec, line, 0), next_s);
        }
        return make_res(cwd, false, 1, flight_failure(rec, line, 1, "builtin failed", 0), session);
    }
    if is_nav_cmd(line) || is_take_cmd(line) {
        let nav_res = if is_nav_cmd(line) { dispatch_nav_cd(ffi, env, cwd, line) } else { dispatch_nav_take(ffi, env, cwd, line) };
        if nav_res.is_ok() {
            let next_cwd: String = match nav_res { Ok(s) => s, Err(_) => cwd };
            return make_res(next_cwd, false, 0, flight_success(rec, line, 0), SessionState { cwd: next_cwd, env_map: session.env_map, alias_map: session.alias_map, job_table: session.job_table, func_map: session.func_map });
        }
        return make_res(cwd, false, 1, flight_failure(rec, line, 1, "directory not found", 0), session);
    }

    if pipe_i >= 0 || r_split.found {
        let _ = oo_tui_disable_raw(ffi, "");
        let exec_res = sys_exec_wait(sys, "sh", list_push(list_push(list_new(), "-c"), line));
        let rc: Int = match exec_res { Ok(c) => c, Err(_) => 1 };
        return make_res(cwd, false, rc, if rc == 0 { flight_success(rec, line, 0) } else { flight_failure(rec, line, rc, "", 0) }, session);
    }

    let raw_tokens: List[String] = split_cmd_tokens(line);
    let tokens: List[String] = expand_globs(fs_r, raw_tokens);
    let num_tokens: Int = list_len(tokens);
    let cmd: String = list_get(tokens, 0);

    let fn_r: Result[String, String] = func_map_get(session.func_map, cmd);
    if fn_r.is_ok() {
        let fn_body: String = match fn_r { Ok(b) => b, Err(_) => "" };
        let mut fn_em: EnvMap = session.env_map;
        let mut all_fn_args: String = "";
        let mut ai: Int = 1;
        while ai < num_tokens {
            let a_val: String = list_get(tokens, ai);
            fn_em = env_map_set(fn_em, ai.to_string(), a_val);
            all_fn_args = if all_fn_args == "" { a_val } else { all_fn_args + " " + a_val };
            ai = ai + 1;
        }
        fn_em = env_map_set(fn_em, "#", (num_tokens - 1).to_string());
        fn_em = env_map_set(fn_em, "@", all_fn_args);
        fn_em = env_map_set(fn_em, "*", all_fn_args);
        fn_em = env_map_set(fn_em, "0", cmd);
        let fn_sess: SessionState = SessionState { cwd: cwd, env_map: fn_em, alias_map: session.alias_map, job_table: session.job_table, func_map: session.func_map };
        let fn_res: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, fn_body, rec, fn_sess);
        return make_res(cwd, fn_res.should_exit, fn_res.exit_code, fn_res.flight_rec, session);
    }

    if cmd == "test" || cmd == "[" {
        let rc: Int = if eval_test_tokens(sys, tokens) { 0 } else { 1 };
        return make_res(cwd, false, rc, if rc == 0 { flight_success(rec, line, 0) } else { flight_failure(rec, line, rc, "", 0) }, session);
    }

    let mut args: List[String] = list_new();
    let mut ti: Int = 1;
    while ti < num_tokens {
        args = list_push(args, list_get(tokens, ti));
        ti = ti + 1;
    }
    let _ = oo_tui_disable_raw(ffi, "");
    let exec_res = sys_exec_wait(sys, cmd, args);
    if exec_res.is_ok() {
        let rc: Int = match exec_res { Ok(c) => c, Err(_) => 0 };
        return make_res(cwd, false, rc, if rc == 0 { flight_success(rec, line, 0) } else { flight_failure(rec, line, rc, "", 0) }, session);
    }

    let err_msg: String = match exec_res { Ok(_) => "", Err(m) => m };
    let is_cnf: Bool = err_msg == "command not found";
    let rc: Int = if is_cnf { 127 } else { 1 };
    let diag: DiagnosticResult = flight_rules_match(cmd, rc, err_msg, cwd);
    if is_cnf && diag.actionable_cmd != "" && !str_starts_with(diag.actionable_cmd, "which ") {
        println("oosh: command not found: '" + cmd + "'. Did you mean '" + diag.actionable_cmd + "'?");
    } else {
        println("oosh: " + (if is_cnf { "command not found: '" + cmd + "'" } else { cmd + ": " + err_msg }));
    }
    return make_res(cwd, false, rc, flight_failure(rec, line, rc, err_msg, 0), session);
}
