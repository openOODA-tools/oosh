// # Native Terminal ANSI Palette
//
// Logline: Minimal 16-color ANSI terminal styling with zero theme engine dependencies.
//
// Setup: Pure string formatting and standard SGR escape sequences with zero ambient effects.
//
// Beats:
//   1. Provide standard ANSI SGR escape sequences for core terminal colors.
//   2. Provide terminal styling primitives for bold, dim, and reset controls.
//   3. Wrap text segments with standard ANSI color tokens and automatic reset.

pub fn ansi_esc() -> String {
    return bytes_to_str(bytes_push(bytes_new(), 27));
}

pub fn cyber_esc() -> String { return ansi_esc(); }
pub fn cyber_reset() -> String { return ansi_esc() + "[0m"; }
pub fn cyber_bold() -> String { return ansi_esc() + "[1m"; }
pub fn cyber_dim() -> String { return ansi_esc() + "[2m"; }

// Standard 16-color ANSI SGR codes
pub fn cyber_cyan() -> String { return ansi_esc() + "[36m"; }
pub fn cyber_amber() -> String { return ansi_esc() + "[33m"; }
pub fn cyber_purple() -> String { return ansi_esc() + "[35m"; }
pub fn cyber_green() -> String { return ansi_esc() + "[32m"; }
pub fn cyber_red() -> String { return ansi_esc() + "[31m"; }
pub fn cyber_blue() -> String { return ansi_esc() + "[34m"; }
pub fn cyber_gray() -> String { return ansi_esc() + "[90m"; }

pub fn paint_cyan(s: String) -> String { return cyber_cyan() + s + cyber_reset(); }
pub fn paint_amber(s: String) -> String { return cyber_amber() + s + cyber_reset(); }
pub fn paint_purple(s: String) -> String { return cyber_purple() + s + cyber_reset(); }
pub fn paint_green(s: String) -> String { return cyber_green() + s + cyber_reset(); }
pub fn paint_red(s: String) -> String { return cyber_red() + s + cyber_reset(); }
pub fn paint_blue(s: String) -> String { return cyber_blue() + s + cyber_reset(); }
pub fn paint_gray(s: String) -> String { return cyber_gray() + s + cyber_reset(); }
