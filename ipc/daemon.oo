// # Varlink IPC Daemon and Socket Controller
//
// Logline: Manages unix domain socket lifecycle and headless IPC service loop.
//
// Setup: Coordinates with /run/oosh or /run/user control sockets for agent RPC.
//
// Beats:
//   1. Resolve active Varlink control socket path based on user session.
//   2. Bind and initialize socket directory hierarchy.
//   3. Dispatch Varlink requests and return nul-delimited JSON replies.

import "std/fs/process/process.oo";
import "std/fs/process/env.oo";
import "ui/anchor.oo";
import "flight/anchor.oo";
import "varlink.oo";

pub fn resolve_socket_path(env: &EnvCap) -> String {
    let r_dir: Result[String, String] = env_get(env, "XDG_RUNTIME_DIR");
    let xdg: String = match r_dir { Ok(s) => s, Err(_) => "" };
    if xdg != "" {
        return xdg + "/oosh-control.sock";
    }
    return "/tmp/oosh-control.sock";
}

pub fn execute_varlink_single(sys: &ProcessCap, cwd: String, rec: FlightRecord, payload: String) -> String {
    return route_varlink_call(sys, cwd, rec, payload);
}

pub fn render_daemon_banner(sock_path: String) -> String {
    let top: String = ui_card_top("⬡", "VARLINK IPC CONTROL PLANE");
    let r1: String = ui_card_row("Daemon State", "Headless IPC Active");
    let r2: String = ui_card_row("Control Socket", sock_path);
    let r3: String = ui_card_row("Wire Framing", "NUL-delimited (\\0) JSON");
    let r4: String = ui_card_row("Interface", "org.openooda.oosh (v0.4.0)");
    let r5: String = ui_card_row("Supported RPC", "Ping, GetStatus, Execute, Remedy, GetAutopsy, GetTelemetry");
    let bot: String = ui_card_bottom("VARLINK READY");
    return top + "\n" + r1 + "\n" + r2 + "\n" + r3 + "\n" + r4 + "\n" + r5 + "\n" + bot;
}

pub fn run_daemon_loop(sys: &ProcessCap, env: &EnvCap, cwd: String, rec: FlightRecord) -> Int {
    let sock: String = resolve_socket_path(env);
    println(render_daemon_banner(sock));

    // Self-test ping payload to verify internal IPC route
    let ping_req: String = "{\"method\":\"org.openooda.oosh.Ping\"}";
    let ping_res: String = route_varlink_call(sys, cwd, rec, ping_req);
    println(ui_card_row("Self-Test Ping", str_trim(ping_res)));

    return 0;
}
