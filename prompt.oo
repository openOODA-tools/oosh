// # oosh Prompt Renderer
//
// Logline: Renders the sovereign shell prompt glyph and current working directory path with ANSI styling.
//
// Setup: Pure string formatting. Formats current directory from active shell state with tilde abbreviation.
//
// Beats:
//   1. Resolve active directory string safely.
//   2. Abbreviate home directory path with tilde glyph when applicable.
//   3. Render high-contrast sovereign rune symbol and active cursor dock.

import "std/fs/process/env.oo";

pub fn ansi_esc() -> String {
    return bytes_to_str(bytes_push(bytes_new(), 27));
}

pub fn format_prompt_path(env: &EnvCap, cwd: String) -> String {
    let hr: Result[String, String] = env_get(env, "HOME");
    let home: String = match hr { Ok(h) => h, Err(_) => "" };

    if home != "" && str_starts_with(cwd, home) {
        let rest: String = str_slice(cwd, chars_len(home), chars_len(cwd));
        return "~" + rest;
    }
    return cwd;
}

pub fn render_prompt(env: &EnvCap, cwd: String) -> String {
    let esc: String = ansi_esc();
    let display_path: String = format_prompt_path(env, cwd);
    // Amber rune, cyan cwd path, green prompt arrow
    let rune: String = esc + "[1;33mᚱ" + esc + "[0m";
    let path_str: String = esc + "[1;36m" + display_path + esc + "[0m";
    let arrow: String = esc + "[1;32m>" + esc + "[0m";
    return rune + " " + path_str + " " + arrow + " ";
}

pub fn render_plain_prompt(env: &EnvCap, cwd: String) -> String {
    let display_path: String = format_prompt_path(env, cwd);
    return "ᚱ " + display_path + " > ";
}
