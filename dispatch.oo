// # oosh Command Dispatcher
//
// Logline: Dispatches shell input lines to internal builtins, intent queries, or host system processes.
//
// Setup: Receives ProcessCap, EnvCap, FfiCap, FsWriteCap, FsReadCap, FlightRecord, and SessionState.
//
// Beats:
//   1. Expand command aliases and handle builtin session state (history, alias, unalias, export, unset).
//   2. Wire builtin output streams directly to pipes and files without intermediate disk files.
//   3. Mutate active directory state for cd and take requests natively via syscalls without subshells.
//   4. Dispatch host system commands directly via sys_exec_wait with terminal control.

import "alias.oo";
import "anchor.oo";
import "manual.oo";
import "ui/anchor.oo";
import "diagnostics/anchor.oo";
import "flight/anchor.oo";
import "intent/anchor.oo";
import "ipc/anchor.oo";
import "syntax/anchor.oo";
import "exec/anchor.oo";
import "job/anchor.oo";

pub type DispatchResult = struct {
    next_cwd: String,
    should_exit: Bool,
    exit_code: Int,
    flight_rec: FlightRecord,
    aliases: AliasMap,
    session: SessionState,
    is_return: Bool
};

fn is_exit(cmd: String) -> Bool { let t: String = str_trim(cmd); return t == "exit" || str_starts_with(t, "exit ") || t == "quit" || t == "q" || t == ":q" || t == ":q!" || t == ":x" || t == "bye" || t == "logout"; }

fn make_res(cwd: String, exit: Bool, rc: Int, rec: FlightRecord, sess: SessionState, ret: Bool) -> DispatchResult {
    return DispatchResult { next_cwd: cwd, should_exit: exit, exit_code: rc, flight_rec: rec, aliases: sess.alias_map, session: sess, is_return: ret };
}

pub fn dispatch_line(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, env: &EnvCap, ffi: &FfiCap, raw_line: String, rec: FlightRecord, session: SessionState) -> DispatchResult {
    let mut raw_trimmed: String = str_trim(raw_line);
    let cwd: String = session.cwd;
    let clean_jobs: JobTable = job_table_poll_and_reap(ffi, session.job_table);
    let cur_s: SessionState = SessionState { cwd: cwd, env_map: session.env_map, alias_map: session.alias_map, job_table: clean_jobs, func_map: session.func_map };
    if raw_trimmed == "" { return make_res(cwd, false, 0, rec, cur_s, false); }

    let split: CompoundSplit = find_compound_split(raw_trimmed);
    if split.op != "" {
        if split.op == "&" {
            let bg_jobs: JobTable = spawn_background(ffi, cur_s.job_table, split.lhs);
            let next_bg_s: SessionState = SessionState { cwd: cwd, env_map: cur_s.env_map, alias_map: cur_s.alias_map, job_table: bg_jobs, func_map: cur_s.func_map };
            if split.rhs != "" { return dispatch_line(fs_r, fs_w, sys, env, ffi, split.rhs, rec, next_bg_s); }
            return make_res(cwd, false, 0, flight_success(rec, split.lhs, 0), next_bg_s, false);
        }
        let res1: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, split.lhs, rec, cur_s);
        if res1.should_exit || res1.is_return { return res1; }
        if split.op == ";" || (split.op == "&&" && res1.exit_code == 0) || (split.op == "||" && res1.exit_code != 0) {
            return dispatch_line(fs_r, fs_w, sys, env, ffi, split.rhs, res1.flight_rec, res1.session);
        }
        return res1;
    }

    if str_starts_with(raw_trimmed, "#") { return make_res(cwd, false, 0, rec, cur_s, false); }
    if str_starts_with(raw_trimmed, "rune ") { raw_trimmed = str_trim(str_slice(raw_trimmed, 5, chars_len(raw_trimmed))); }

    if is_subshell_stmt(raw_trimmed) {
        let sub_res: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, extract_subshell_body(raw_trimmed), rec, cur_s);
        if sub_res.next_cwd != cwd { let _ = oo_tui_write(ffi, "\x1b_cd:" + cwd); }
        return make_res(cwd, false, sub_res.exit_code, sub_res.flight_rec, cur_s, false);
    }

    if is_function_def(raw_trimmed) {
        let def_r: Result[CompoundSplit, String] = parse_function_def(raw_trimmed);
        if def_r.is_ok() {
            let def: CompoundSplit = match def_r { Ok(d) => d, Err(_) => CompoundSplit { lhs: "", op: "", rhs: "" } };
            return make_res(cwd, false, 0, flight_success(rec, raw_trimmed, 0), SessionState { cwd: cwd, env_map: cur_s.env_map, alias_map: cur_s.alias_map, job_table: cur_s.job_table, func_map: func_map_set(cur_s.func_map, def.lhs, def.rhs) }, false);
        }
    }

    if is_for_stmt(raw_trimmed) {
        let f_r: Result[ForLoopDef, String] = parse_for_stmt(raw_trimmed);
        if f_r.is_ok() {
            let f: ForLoopDef = match f_r { Ok(v) => v, Err(_) => for_def_empty() };
            let mut iter_s: SessionState = cur_s; let mut cur_rec: FlightRecord = rec;
            let mut last_rc: Int = 0; let mut item_i: Int = 0;
            while item_i < list_len(f.items) {
                iter_s = SessionState { cwd: iter_s.cwd, env_map: env_map_set(iter_s.env_map, f.var_name, list_get(f.items, item_i)), alias_map: iter_s.alias_map, job_table: iter_s.job_table, func_map: iter_s.func_map };
                let res: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, f.body, cur_rec, iter_s);
                cur_rec = res.flight_rec; iter_s = res.session; last_rc = res.exit_code;
                if res.should_exit || res.is_return { return res; }
                item_i = item_i + 1;
            }
            return make_res(iter_s.cwd, false, last_rc, cur_rec, iter_s, false);
        }
    }

    if is_while_stmt(raw_trimmed) {
        let w_r: Result[WhileLoopDef, String] = parse_while_stmt(raw_trimmed);
        if w_r.is_ok() {
            let w: WhileLoopDef = match w_r { Ok(v) => v, Err(_) => WhileLoopDef { cond: "", body: "" } };
            let mut iter_s: SessionState = cur_s; let mut cur_rec: FlightRecord = rec;
            let mut last_rc: Int = 0; let mut guard: Int = 0;
            while guard < 1000 {
                let c_res: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, w.cond, cur_rec, iter_s);
                if c_res.exit_code != 0 || c_res.should_exit || c_res.is_return { guard = 1001; } else {
                    let b_res: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, w.body, c_res.flight_rec, c_res.session);
                    cur_rec = b_res.flight_rec; iter_s = b_res.session; last_rc = b_res.exit_code;
                    if b_res.should_exit || b_res.is_return { return b_res; }
                    guard = guard + 1;
                }
            }
            return make_res(iter_s.cwd, false, last_rc, cur_rec, iter_s, false);
        }
    }

    if is_if_stmt(raw_trimmed) {
        let i_r: Result[IfStmtDef, String] = parse_if_stmt(raw_trimmed);
        if i_r.is_ok() {
            let stmt: IfStmtDef = match i_r { Ok(v) => v, Err(_) => IfStmtDef { cond: "", then_body: "", else_body: "" } };
            let c_res: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, stmt.cond, rec, cur_s);
            if c_res.exit_code == 0 { return dispatch_line(fs_r, fs_w, sys, env, ffi, stmt.then_body, c_res.flight_rec, c_res.session); }
            if stmt.else_body != "" { return dispatch_line(fs_r, fs_w, sys, env, ffi, stmt.else_body, c_res.flight_rec, c_res.session); }
            return make_res(cwd, false, 0, c_res.flight_rec, c_res.session, false);
        }
    }

    if is_case_stmt(raw_trimmed) {
        let cs_r: Result[CaseStmtDef, String] = parse_case_stmt(raw_trimmed);
        if cs_r.is_ok() {
            let cs: CaseStmtDef = match cs_r { Ok(v) => v, Err(_) => CaseStmtDef { matched_body: "" } };
            if cs.matched_body != "" { return dispatch_line(fs_r, fs_w, sys, env, ffi, cs.matched_body, rec, cur_s); }
            return make_res(cwd, false, 0, flight_success(rec, raw_trimmed, 0), cur_s, false);
        }
    }

    let expanded: String = expand_command_line(sys, env, cur_s.env_map, rec.last_exit_code, raw_trimmed);
    let line: String = alias_expand(cur_s.alias_map, expanded);

    if has_unquoted_background(line) {
        let next_jobs: JobTable = spawn_background(ffi, cur_s.job_table, strip_unquoted_background(line));
        return make_res(cwd, false, 0, flight_success(rec, line, 0), SessionState { cwd: cwd, env_map: cur_s.env_map, alias_map: cur_s.alias_map, job_table: next_jobs, func_map: cur_s.func_map }, false);
    }

    if line == "return" || str_starts_with(line, "return ") {
        let rc: Int = parse_return_code(line, rec.last_exit_code);
        return make_res(cwd, false, rc, if rc == 0 { flight_success(rec, line, 0) } else { flight_failure(rec, line, rc, "", 0) }, cur_s, true);
    }
    if is_exit(line) { return make_res(cwd, true, parse_exit_code(line, rec.last_exit_code), rec, cur_s, false); }
    if is_version_cmd(line) { println("oosh " + oosh_version()); return make_res(cwd, false, 0, rec, cur_s, false); }
    if is_job_cmd(line) {
        let jr: Result[JobTable, String] = dispatch_job_cmd(ffi, line, cur_s.job_table);
        if jr.is_ok() {
            return make_res(cwd, false, 0, flight_success(rec, line, 0), SessionState { cwd: cwd, env_map: cur_s.env_map, alias_map: cur_s.alias_map, job_table: match jr { Ok(t) => t, Err(_) => cur_s.job_table }, func_map: cur_s.func_map }, false);
        }
        return make_res(cwd, false, 1, flight_failure(rec, line, 1, "", 0), cur_s, false);
    }
    if is_link_cmd(line) { ipc_dispatch_link(sys, env, cwd, rec, line); return make_res(cwd, false, 0, rec, cur_s, false); }
    if intent_is_query(line) || str_starts_with(line, "ai ") {
        let q: IntentQuery = parse_intent_query(line);
        if q.is_bare { println(intent_bare_guidance(q.prefix)); return make_res(cwd, false, 0, rec, cur_s, false); }
        let action: IntentPromptAction = intent_prompt(fs_r, sys, line, cwd);
        if action.should_execute && action.command_to_run != "" { return dispatch_line(fs_r, fs_w, sys, env, ffi, action.command_to_run, rec, cur_s); }
        return make_res(cwd, false, 0, rec, cur_s, false);
    }

    let r_split: RedirectSplit = find_unquoted_redirect(line);
    let pipe_i: Int = find_unquoted_pipe(line);
    if r_split.found && pipe_i < 0 {
        let dest: String = if r_split.op == "2>&1" { "" } else if str_starts_with(r_split.target, "/") { r_split.target } else { cwd + "/" + r_split.target };
        if r_split.op == "<" {
            let in_res: Result[String, String] = read_file(fs_r, dest);
            if in_res.is_err() {
                println("oosh: " + r_split.target + ": No such file or directory");
                return make_res(cwd, false, 1, flight_failure(rec, line, 1, "No such file or directory", 0), cur_s, false);
            }
        }
        let b_res: Result[String, String] = get_all_builtin_output(sys, env, fs_r, cwd, rec, r_split.lhs, cur_s);
        if b_res.is_ok() {
            let out_s: String = match b_res { Ok(s) => s, Err(_) => "" };
            if r_split.op == "<" || r_split.op == "2>&1" { print(out_s); }
            else { let _ = route_builtin_redirection(fs_w, out_s, cwd, r_split.target, r_split.op == ">>"); }
            return make_res(cwd, false, 0, flight_success(rec, line, 0), cur_s, false);
        }
        let r_rc: Int = route_direct_redirection(ffi, r_split.op, dest, cwd, r_split.lhs);
        return make_res(cwd, false, r_rc, if r_rc == 0 { flight_success(rec, line, 0) } else { flight_failure(rec, line, r_rc, "", 0) }, cur_s, false);
    }
    if pipe_i >= 0 {
        let lhs: String = str_trim(str_slice(line, 0, pipe_i));
        let rhs: String = str_trim(str_slice(line, pipe_i + 1, chars_len(line)));
        let b_res: Result[String, String] = get_all_builtin_output(sys, env, fs_r, cwd, rec, lhs, cur_s);
        let rhs_b: Result[String, String] = get_all_builtin_output(sys, env, fs_r, cwd, rec, rhs, cur_s);
        if rhs_b.is_ok() { print(match rhs_b { Ok(s) => s, Err(_) => "" }); return make_res(cwd, false, 0, flight_success(rec, line, 0), cur_s, false); }
        let prc: Int = if b_res.is_ok() { route_builtin_pipeline(ffi, match b_res { Ok(s) => s, Err(_) => "" }, rhs) } else { route_direct_pipeline(ffi, lhs, rhs) };
        return make_res(cwd, false, prc, if prc == 0 { flight_success(rec, line, 0) } else { flight_failure(rec, line, prc, "", 0) }, cur_s, false);
    }

    if dispatch_manual(sys, cwd, line) || dispatch_ui(sys, cwd, line) || dispatch_diagnostics(sys, cwd, rec, line) { return make_res(cwd, false, 0, rec, cur_s, false); }
    if line == "pwd" || line == "cwd" || line == "where" || line == "here" { println(cwd); return make_res(cwd, false, 0, rec, cur_s, false); }
    if is_session_builtin(line) {
        let b_res: Result[SessionState, String] = dispatch_session_builtin(ffi, fs_r, sys, env, cwd, line, cur_s);
        if b_res.is_ok() { return make_res(cwd, false, 0, flight_success(rec, line, 0), match b_res { Ok(s) => s, Err(_) => cur_s }, false); }
        return make_res(cwd, false, 1, flight_failure(rec, line, 1, "builtin failed", 0), cur_s, false);
    }
    if is_nav_cmd(line) || is_take_cmd(line) {
        let nav_res = if is_nav_cmd(line) { dispatch_nav_cd(ffi, env, cwd, cur_s.env_map, line) } else { dispatch_nav_take(ffi, env, cwd, cur_s.env_map, line) };
        if nav_res.is_ok() {
            let nr: NavResult = match nav_res { Ok(r) => r, Err(_) => NavResult { cwd: cwd, env_map: cur_s.env_map } };
            return make_res(nr.cwd, false, 0, flight_success(rec, line, 0), SessionState { cwd: nr.cwd, env_map: nr.env_map, alias_map: cur_s.alias_map, job_table: cur_s.job_table, func_map: cur_s.func_map }, false);
        }
        return make_res(cwd, false, 1, flight_failure(rec, line, 1, "directory not found", 0), cur_s, false);
    }

    let raw_tokens: List[String] = split_cmd_tokens(line);
    let tokens: List[String] = expand_globs(fs_r, raw_tokens);
    let num_tokens: Int = list_len(tokens);
    let cmd: String = list_get(tokens, 0);

    if cmd == "." || cmd == "source" {
        if num_tokens < 2 { println("oosh: " + cmd + ": filename argument required"); return make_res(cwd, false, 2, flight_failure(rec, line, 2, "filename argument required", 0), cur_s, false); }
        let src_path: String = list_get(tokens, 1);
        let full_src: String = if str_starts_with(src_path, "/") { src_path } else { cwd + "/" + src_path };
        let sr: Result[String, String] = read_file(fs_r, full_src);
        if sr.is_err() { println("oosh: " + src_path + ": No such file or directory"); return make_res(cwd, false, 1, flight_failure(rec, line, 1, "No such file or directory", 0), cur_s, false); }
        let src_body: String = match sr { Ok(s) => s, Err(_) => "" };
        let s_res: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, src_body, rec, cur_s);
        return make_res(s_res.next_cwd, s_res.should_exit, s_res.exit_code, s_res.flight_rec, s_res.session, false);
    }

    let fn_r: Result[String, String] = func_map_get(cur_s.func_map, cmd);
    if fn_r.is_ok() {
        let fn_body: String = match fn_r { Ok(b) => b, Err(_) => "" };
        let fn_sess: SessionState = SessionState { cwd: cwd, env_map: build_fn_env(cur_s.env_map, cmd, tokens), alias_map: cur_s.alias_map, job_table: cur_s.job_table, func_map: cur_s.func_map };
        let fn_res: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, fn_body, rec, fn_sess);
        let next_em: EnvMap = restore_fn_env(fn_res.session.env_map, cur_s.env_map, num_tokens - 1);
        let next_sess: SessionState = SessionState { cwd: fn_res.next_cwd, env_map: next_em, alias_map: fn_res.session.alias_map, job_table: fn_res.session.job_table, func_map: fn_res.session.func_map };
        let fn_rec: FlightRecord = if fn_res.exit_code == 0 { flight_success(fn_res.flight_rec, cmd, 0) } else { flight_failure(fn_res.flight_rec, cmd, fn_res.exit_code, "", 0) };
        return make_res(fn_res.next_cwd, fn_res.should_exit, fn_res.exit_code, fn_rec, next_sess, false);
    }

    if cmd == "test" || cmd == "[" {
        let rc: Int = if eval_test_tokens(sys, tokens) { 0 } else { 1 };
        return make_res(cwd, false, rc, if rc == 0 { flight_success(rec, line, 0) } else { flight_failure(rec, line, rc, "", 0) }, cur_s, false);
    }

    let ex_res = exec_host_command(sys, ffi, cwd, cmd, tokens);
    if ex_res.is_ok() {
        let rc: Int = match ex_res { Ok(c) => c, Err(_) => 0 };
        return make_res(cwd, false, rc, if rc == 0 { flight_success(rec, line, 0) } else { flight_failure(rec, line, rc, "", 0) }, cur_s, false);
    }
    let err_msg: String = match ex_res { Ok(_) => "", Err(m) => m };
    let rc: Int = if err_msg == "command not found" { 127 } else { 1 };
    return make_res(cwd, false, rc, flight_failure(rec, line, rc, err_msg, 0), cur_s, false);
}
