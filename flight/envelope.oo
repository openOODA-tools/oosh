// # Flight Recorder Envelope Subsystem
//
// Logline: Tracks execution flight telemetry, failure envelopes, and blackbox postmortems.
//
// Setup: In-memory circular ring buffer tracking execution events, peak memory, PID, and causality.
//
// Beats:
//   1. Initialize session flight record state and circular execution trace.
//   2. Update execution envelope upon process completion (success or failure).
//   3. Manage FIFO oldest-first ring buffer eviction at fixed capacity.
//   4. Render clean Unix columnar autopsy flight recorder report.

import "term/read.oo";

pub type FlightEntry = struct {
    seq: Int,
    cmd: String,
    exit_code: Int,
    duration_ms: Int,
    status: String,
    stderr_snippet: String,
    peak_mem: String,
    pid: Int,
    causal_link: String
};

pub type FlightRecord = struct {
    has_failed: Bool,
    last_failed_cmd: String,
    last_exit_code: Int,
    last_stderr: String,
    last_duration_ms: Int,
    total_commands: Int,
    failed_count: Int,
    last_success_cmd: String,
    entries: List[FlightEntry],
    capacity: Int,
    last_peak_mem: String,
    last_pid: Int,
    last_causal_link: String
};

fn safe_str_prefix(s: String, max_chars: Int) -> String {
    if chars_len(s) <= max_chars { return s; }
    return str_slice(s, 0, max_chars);
}

fn fmt_digits_2(n: Int) -> String {
    if n < 10 && n >= 0 { return "0" + n.to_string(); }
    return n.to_string();
}

fn pad_right_str(s: String, width: Int) -> String {
    let slen: Int = chars_len(s);
    if slen >= width { return s; }
    let mut out: String = s;
    let mut i: Int = slen;
    while i < width { out = out + " "; i = i + 1; }
    return out;
}

fn pad_left_str(s: String, width: Int) -> String {
    let slen: Int = chars_len(s);
    if slen >= width { return s; }
    let mut prefix: String = "";
    let mut i: Int = 0;
    let diff: Int = width - slen;
    while i < diff { prefix = prefix + " "; i = i + 1; }
    return prefix + s;
}

fn push_ring_entry(entries: List[FlightEntry], entry: FlightEntry, max_cap: Int) -> List[FlightEntry] {
    let cur_len: Int = list_len(entries);
    if cur_len < max_cap { return list_push(entries, entry); }
    let mut new_list: List[FlightEntry] = list_new();
    let mut i: Int = 1;
    while i < cur_len {
        new_list = list_push(new_list, list_get(entries, i));
        i = i + 1;
    }
    return list_push(new_list, entry);
}

pub fn init_flight_record() -> FlightRecord {
    let empty_entries: List[FlightEntry] = list_new();
    return FlightRecord {
        has_failed: false, last_failed_cmd: "", last_exit_code: 0,
        last_stderr: "", last_duration_ms: 0, total_commands: 0,
        failed_count: 0, last_success_cmd: "", entries: empty_entries, capacity: 16,
        last_peak_mem: "0.0 MB", last_pid: 0, last_causal_link: "root"
    };
}

pub fn record_flight_success(rec: FlightRecord, cmd: String, duration_ms: Int) -> FlightRecord {
    return record_flight_success_full(rec, cmd, duration_ms, "0.0 MB", 0, "root");
}

pub fn record_flight_success_full(rec: FlightRecord, cmd: String, duration_ms: Int, mem: String, pid: Int, link: String) -> FlightRecord {
    let seq_num: Int = rec.total_commands + 1;
    let causal: String = if link != "" { link } else if rec.total_commands > 0 { "seq#" + rec.total_commands.to_string() } else { "root" };
    let entry: FlightEntry = FlightEntry {
        seq: seq_num, cmd: cmd, exit_code: 0, duration_ms: duration_ms,
        status: "OK", stderr_snippet: "", peak_mem: mem, pid: pid, causal_link: causal
    };
    let new_entries: List[FlightEntry] = push_ring_entry(rec.entries, entry, rec.capacity);
    return FlightRecord {
        has_failed: false, last_failed_cmd: rec.last_failed_cmd,
        last_exit_code: 0, last_stderr: "",
        last_duration_ms: duration_ms, total_commands: seq_num,
        failed_count: rec.failed_count, last_success_cmd: cmd,
        entries: new_entries, capacity: rec.capacity,
        last_peak_mem: mem, last_pid: pid, last_causal_link: causal
    };
}

pub fn record_flight_failure(rec: FlightRecord, cmd: String, exit_code: Int, stderr_out: String, duration_ms: Int) -> FlightRecord {
    return record_flight_failure_full(rec, cmd, exit_code, stderr_out, duration_ms, "0.0 MB", 0, "root");
}

pub fn record_flight_failure_full(rec: FlightRecord, cmd: String, exit_code: Int, stderr_out: String, duration_ms: Int, mem: String, pid: Int, link: String) -> FlightRecord {
    let seq_num: Int = rec.total_commands + 1;
    let causal: String = if link != "" { link } else if rec.total_commands > 0 { "seq#" + rec.total_commands.to_string() } else { "root" };
    let clean_err: String = strip_escape_sequences(stderr_out);
    let clean_cmd: String = strip_escape_sequences(cmd);
    let entry: FlightEntry = FlightEntry {
        seq: seq_num, cmd: clean_cmd, exit_code: exit_code, duration_ms: duration_ms,
        status: "FAIL", stderr_snippet: safe_str_prefix(clean_err, 60),
        peak_mem: mem, pid: pid, causal_link: causal
    };
    let new_entries: List[FlightEntry] = push_ring_entry(rec.entries, entry, rec.capacity);
    return FlightRecord {
        has_failed: true, last_failed_cmd: clean_cmd, last_exit_code: exit_code,
        last_stderr: clean_err, last_duration_ms: duration_ms,
        total_commands: seq_num, failed_count: rec.failed_count + 1,
        last_success_cmd: rec.last_success_cmd, entries: new_entries, capacity: rec.capacity,
        last_peak_mem: mem, last_pid: pid, last_causal_link: causal
    };
}

pub fn update_flight_telemetry(rec: FlightRecord, duration_ms: Int, mem: String, pid: Int) -> FlightRecord {
    let n: Int = list_len(rec.entries);
    if n == 0 { return rec; }
    let last_idx: Int = n - 1;
    let last: FlightEntry = list_get(rec.entries, last_idx);
    let updated: FlightEntry = FlightEntry {
        seq: last.seq, cmd: last.cmd, exit_code: last.exit_code,
        duration_ms: duration_ms, status: last.status, stderr_snippet: last.stderr_snippet,
        peak_mem: mem, pid: pid, causal_link: last.causal_link
    };
    let mut new_entries: List[FlightEntry] = list_new();
    let mut i: Int = 0;
    while i < last_idx {
        new_entries = list_push(new_entries, list_get(rec.entries, i));
        i = i + 1;
    }
    new_entries = list_push(new_entries, updated);
    return FlightRecord {
        has_failed: rec.has_failed, last_failed_cmd: rec.last_failed_cmd,
        last_exit_code: rec.last_exit_code, last_stderr: rec.last_stderr,
        last_duration_ms: duration_ms, total_commands: rec.total_commands,
        failed_count: rec.failed_count, last_success_cmd: rec.last_success_cmd,
        entries: new_entries, capacity: rec.capacity,
        last_peak_mem: mem, last_pid: pid, last_causal_link: rec.last_causal_link
    };
}

pub fn update_flight_duration(rec: FlightRecord, duration_ms: Int) -> FlightRecord {
    return update_flight_telemetry(rec, duration_ms, rec.last_peak_mem, rec.last_pid);
}

fn format_trace_entry(entry: FlightEntry) -> String {
    let seq_str: String = "#" + fmt_digits_2(entry.seq);
    let status_str: String = if entry.exit_code == 0 { "OK" } else { "ERR " + entry.exit_code.to_string() };
    let dur_str: String = entry.duration_ms.to_string() + "ms";
    let pid_str: String = if entry.pid > 0 { entry.pid.to_string() } else { "-" };
    let mem_str: String = if entry.peak_mem != "" { entry.peak_mem } else { "0.0MB" };
    let cmd_str: String = safe_str_prefix(entry.cmd, 32);
    return pad_right_str(seq_str, 6) + " " + pad_right_str(status_str, 10) + " " + pad_left_str(dur_str, 9) + "  " + pad_left_str(pid_str, 6) + "  " + pad_left_str(mem_str, 7) + " " + cmd_str;
}

pub fn render_autopsy_card(rec: FlightRecord) -> String {
    let top: String = "=== AUTOPSY FLIGHT RECORDER ===";
    let total_str: String = rec.total_commands.to_string();
    let failed_str: String = rec.failed_count.to_string();
    let cap_str: String = rec.capacity.to_string();
    let header_info: String = "Buffer: " + total_str + " traced (capacity " + cap_str + ") | Failures: " + failed_str;

    let sec_trace: String = "\nCHRONOLOGICAL EXECUTION TIMELINE:\nSEQ    STATUS     TIME       PID     MEMORY  COMMAND";
    let num_entries: Int = list_len(rec.entries);
    let mut trace_body: String = "";
    if num_entries == 0 {
        trace_body = "  (empty trace - no commands executed yet)";
    } else {
        let mut i: Int = 0;
        while i < num_entries {
            let ent: FlightEntry = list_get(rec.entries, i);
            let row: String = format_trace_entry(ent);
            if trace_body == "" { trace_body = row; } else { trace_body = trace_body + "\n" + row; }
            i = i + 1;
        }
    }

    let sec_post: String = "\nPOSTMORTEM FAILURE ENVELOPE:";
    let post_body: String = if rec.has_failed {
        let code_str: String = rec.last_exit_code.to_string();
        let dur_str: String = rec.last_duration_ms.to_string() + "ms";
        let root_cause: String = if str_contains(rec.last_stderr, "directory not found") || str_contains(rec.last_stderr, "failed to create directory") || str_contains(rec.last_stderr, "No such file") {
            "Target file or path does not exist"
        } else if rec.last_exit_code == 127 || str_contains(rec.last_stderr, "command not found") {
            "Binary not found in PATH or unrecognized command"
        } else if rec.last_exit_code == 126 || str_contains(rec.last_stderr, "Permission denied") {
            "Execution permission denied (missing +x or elevated privs)"
        } else {
            "Process exited with non-zero status " + code_str
        };
        "Faulted Command : " + rec.last_failed_cmd + "\n" +
        "Exit Code       : " + code_str + "\n" +
        "Latency         : " + dur_str + "\n" +
        "Process ID      : " + (if rec.last_pid > 0 { rec.last_pid.to_string() } else { "-" }) + "\n" +
        "Peak Memory     : " + rec.last_peak_mem + "\n" +
        "Execution Link  : " + rec.last_causal_link + "\n" +
        "Root Cause      : " + root_cause + "\n" +
        "Captured Stderr : " + safe_str_prefix(rec.last_stderr, 100)
    } else {
        "Status : Nominal (0 unhandled faults)\n" +
        "Trace  : Clean execution pipeline\n" +
        "Last   : " + if rec.last_success_cmd == "" { "none" } else { rec.last_success_cmd }
    };

    return top + "\n" + header_info + sec_trace + "\n" + trace_body + "\n" + sec_post + "\n" + post_body + "\n=== AUTOPSY COMPLETE ===";
}

pub fn record_stream_quota_envelope(rec: FlightRecord, cmd: String, bytes_ingested: Int) -> FlightRecord {
    let mb_str: String = (bytes_ingested / 1048576).to_string() + ".0 MB";
    return record_flight_failure_full(rec, cmd, 137, "stream ingestion quota breached (16MB ceiling reached)", 0, mb_str, 0, "stream_quota");
}
