// # Flight Recorder Envelope Subsystem
//
// Logline: Tracks execution flight telemetry, failure envelopes, and blackbox postmortems.
//
// Setup: In-memory session state record tracking success/failure events and metrics.
//
// Beats:
//   1. Initialize session flight record state.
//   2. Update execution envelope upon process completion.
//   3. Render blackbox autopsy inspection card.

import "ui/palette.oo";
import "ui/card.oo";

pub type FlightRecord = struct {
    has_failed: Bool,
    last_failed_cmd: String,
    last_exit_code: Int,
    last_stderr: String,
    last_duration_ms: Int,
    total_commands: Int,
    failed_count: Int,
    last_success_cmd: String
};

pub fn init_flight_record() -> FlightRecord {
    return FlightRecord {
        has_failed: false,
        last_failed_cmd: "",
        last_exit_code: 0,
        last_stderr: "",
        last_duration_ms: 0,
        total_commands: 0,
        failed_count: 0,
        last_success_cmd: ""
    };
}

pub fn record_flight_success(rec: FlightRecord, cmd: String, duration_ms: Int) -> FlightRecord {
    return FlightRecord {
        has_failed: rec.has_failed,
        last_failed_cmd: rec.last_failed_cmd,
        last_exit_code: rec.last_exit_code,
        last_stderr: rec.last_stderr,
        last_duration_ms: duration_ms,
        total_commands: rec.total_commands + 1,
        failed_count: rec.failed_count,
        last_success_cmd: cmd
    };
}

pub fn record_flight_failure(rec: FlightRecord, cmd: String, exit_code: Int, stderr_out: String, duration_ms: Int) -> FlightRecord {
    return FlightRecord {
        has_failed: true,
        last_failed_cmd: cmd,
        last_exit_code: exit_code,
        last_stderr: stderr_out,
        last_duration_ms: duration_ms,
        total_commands: rec.total_commands + 1,
        failed_count: rec.failed_count + 1,
        last_success_cmd: rec.last_success_cmd
    };
}

fn safe_str_prefix(s: String, max_chars: Int) -> String {
    if chars_len(s) <= max_chars {
        return s;
    }
    return str_slice(s, 0, max_chars);
}

pub fn render_autopsy_card(rec: FlightRecord) -> String {
    let top: String = card_top("ᚦ", "FLIGHT RECORDER (BLACKBOX) AUTOPSY");
    let total_str: String = rec.total_commands.to_string();
    let failed_str: String = rec.failed_count.to_string();
    let r1: String = card_row("Flight log", "Armed (in-memory ring buffer, " + total_str + " commands traced)");
    let r2: String = card_row("Total Executions", total_str);
    let r3: String = card_row("Failed Count", failed_str);

    let sec1: String = card_section("POSTMORTEM ENVELOPE");
    let r4: String = if rec.has_failed {
        let code_str: String = rec.last_exit_code.to_string();
        let dur_str: String = rec.last_duration_ms.to_string() + "ms";
        card_row_colored("Postmortem", "ALERT (non-zero fault detected)", cyber_red()) + "\n" +
        card_row("Faulted Command", rec.last_failed_cmd) + "\n" +
        card_row("Exit Code", code_str) + "\n" +
        card_row("Fault Latency", dur_str) + "\n" +
        card_row("Causal trace", "Execution pipeline halted on exit " + code_str) + "\n" +
        card_row("Captured Stderr", safe_str_prefix(rec.last_stderr, 120))
    } else {
        card_row_colored("Postmortem", "Nominal (0 unhandled faults)", cyber_green()) + "\n" +
        card_row("Causal trace", "Clean execution pipeline") + "\n" +
        card_row("Last Successful", if rec.last_success_cmd == "" { "none" } else { rec.last_success_cmd })
    };

    let bottom: String = card_bottom("AUTOPSY COMPLETE");
    return top + "\n" + r1 + "\n" + r2 + "\n" + r3 + "\n" + sec1 + "\n" + r4 + "\n" + bottom;
}
