// # Varlink IPC Daemon and Socket Controller
//
// Logline: Manages unix domain socket lifecycle and headless IPC service loop.
//
// Setup: Coordinates with /run/oosh or /run/user control sockets for agent RPC.
//
// Beats:
//   1. Resolve active Varlink control socket path based on user session.
//   2. Bind and initialize socket directory hierarchy.
//   3. Dispatch Varlink requests and return nul-delimited JSON replies via native epoll.

import "std/fs/process/process.oo";
import "std/fs/process/env.oo";
import "ui/anchor.oo";
import "flight/anchor.oo";
import "varlink.oo";

fn ansi_esc() -> String {
    return bytes_to_str(bytes_push(bytes_new(), 27));
}

fn get_parent_env(sys: &ProcessCap, env: &EnvCap, var_name: String) -> String {
    let r_e: Result[String, String] = env_get(env, var_name);
    let v: String = match r_e { Ok(s) => s, Err(_) => "" };
    if v != "" {
        return v;
    }
    let cmd: String = "bash -c 'tr \"\\0\" \"\\n\" < /proc/$PPID/environ 2>/dev/null | grep \"^" + var_name + "=\" | head -n1 | cut -d= -f2-'";
    let r_p: Result[String, String] = process_exec(sys, cmd);
    return match r_p { Ok(s) => str_trim(s), Err(_) => "" };
}

pub fn resolve_socket_path_cap(bind: &BindCap, env: &EnvCap) -> String {
    return resolve_socket_path(env);
}

pub fn resolve_socket_path(env: &EnvCap) -> String {
    let r_override: Result[String, String] = env_get(env, "OOSH_SOCKET");
    let ov: String = match r_override { Ok(s) => s, Err(_) => "" };
    if ov != "" {
        return ov;
    }
    let r_oo: Result[String, String] = env_get(env, "OO_SOCKET");
    let oo_sock: String = match r_oo { Ok(s) => s, Err(_) => "" };
    if oo_sock != "" {
        return oo_sock;
    }
    let r_user: Result[String, String] = env_get(env, "USER");
    let user: String = match r_user { Ok(s) => s, Err(_) => "" };
    if user == "root" {
        return "/run/oosh/control.sock";
    }
    let r_dir: Result[String, String] = env_get(env, "XDG_RUNTIME_DIR");
    let xdg: String = match r_dir { Ok(s) => s, Err(_) => "" };
    if xdg != "" {
        return xdg + "/oosh/control.sock";
    }
    let r_home: Result[String, String] = env_get(env, "HOME");
    let home: String = match r_home { Ok(s) => s, Err(_) => "" };
    if home != "" {
        return home + "/.cache/oosh/control.sock";
    }
    let r_uid: Result[String, String] = env_get(env, "UID");
    let uid: String = match r_uid { Ok(s) => s, Err(_) => "" };
    let final_uid: String = if uid != "" { uid } else { "1000" };
    return "/tmp/oosh-" + final_uid + "/control.sock";
}

pub fn prepare_socket_path(sys: &ProcessCap, env: &EnvCap) -> String {
    let ov_oosh: String = get_parent_env(sys, env, "OOSH_SOCKET");
    let ov_oo: String = get_parent_env(sys, env, "OO_SOCKET");
    let ov: String = if ov_oosh != "" { ov_oosh } else { ov_oo };
    if ov != "" {
        let prep_cmd: String = "d=\"$(dirname \"" + ov + "\")\"; if [ \"$d\" != \"/tmp\" ] && [ \"$d\" != \"/\" ] && [ \"$d\" != \"/run\" ]; then mkdir -p -m 0700 \"$d\" 2>/dev/null; chmod 0700 \"$d\" 2>/dev/null; fi";
        let _ = process_exec(sys, prep_cmd);
        return ov;
    }
    let r_user: Result[String, String] = env_get(env, "USER");
    let user: String = match r_user { Ok(s) => s, Err(_) => "" };
    if user == "root" {
        let r_primary: Result[String, String] = process_exec(sys, "mkdir -p -m 0700 /run/oosh 2>/dev/null && chmod 0700 /run/oosh 2>/dev/null && test -w /run/oosh");
        if r_primary.is_ok() {
            return "/run/oosh/control.sock";
        }
    }
    let xdg: String = get_parent_env(sys, env, "XDG_RUNTIME_DIR");
    if xdg != "" {
        let r_xdg: Result[String, String] = process_exec(sys, "mkdir -p -m 0700 \"" + xdg + "/oosh\" 2>/dev/null && chmod 0700 \"" + xdg + "/oosh\" 2>/dev/null && test -w \"" + xdg + "/oosh\"");
        if r_xdg.is_ok() {
            return xdg + "/oosh/control.sock";
        }
    }
    let home: String = get_parent_env(sys, env, "HOME");
    if home != "" {
        let r_home: Result[String, String] = process_exec(sys, "mkdir -p -m 0700 \"" + home + "/.cache/oosh\" 2>/dev/null && chmod 0700 \"" + home + "/.cache/oosh\" 2>/dev/null && test -w \"" + home + "/.cache/oosh\"");
        if r_home.is_ok() {
            return home + "/.cache/oosh/control.sock";
        }
    }
    let r_id: Result[String, String] = process_exec(sys, "id -u 2>/dev/null || echo 1000");
    let uid_s: String = match r_id { Ok(s) => str_trim(s), Err(_) => "1000" };
    let private_dir: String = "/tmp/oosh-" + uid_s;
    let _ = process_exec(sys, "mkdir -p -m 0700 \"" + private_dir + "\" 2>/dev/null && chmod 0700 \"" + private_dir + "\" 2>/dev/null");
    return private_dir + "/control.sock";
}

pub fn unlink_stale_socket(sys: &ProcessCap, sock_path: String) -> Bool {
    let r: Result[String, String] = process_exec(sys, "rm -f \"" + sock_path + "\" 2>/dev/null");
    return r.is_ok();
}

pub fn execute_varlink_single(sys: &ProcessCap, cwd: String, rec: FlightRecord, payload: String) -> String {
    return route_varlink_call(sys, cwd, rec, payload);
}

pub fn render_daemon_banner(sock_path: String) -> String {
    let top: String = ui_card_top("*", "VARLINK IPC CONTROL PLANE");
    let r1: String = ui_card_row("Daemon State", "Headless IPC Active");
    let r2: String = ui_card_row("Control Socket", sock_path);
    let r3: String = ui_card_row("Wire Framing", "NUL-delimited (\\0) JSON");
    let r4: String = ui_card_row("Interface", "org.openooda.oosh.Control1 (v0.9.0)");
    let r5: String = ui_card_row("Supported RPC", "QueryPosture, ExecuteCommand, StreamTelemetry, GetLastFailure, SynthesizeIntent");
    let bot: String = ui_card_bottom("VARLINK READY");
    return top + "\n" + r1 + "\n" + r2 + "\n" + r3 + "\n" + r4 + "\n" + r5 + "\n" + bot;
}

pub fn run_daemon_loop(sys: &ProcessCap, env: &EnvCap, ffi: &FfiCap, cwd: String, rec: FlightRecord) -> Int {
    let sock: String = prepare_socket_path(sys, env);
    let _ = unlink_stale_socket(sys, sock);
    println(render_daemon_banner(sock));

    // Self-test ping payload to verify internal IPC route
    let ping_req: String = "{\"method\":\"org.openooda.oosh.Ping\"}";
    let ping_res: String = route_varlink_call(sys, cwd, rec, ping_req);
    println(ui_card_row("Self-Test Ping", str_trim(ping_res)));

    // Resolve binary path for child process IPC dispatch
    let bin_lookup: Result[String, String] = process_exec(sys, "[ -x ./dist/oosh ] && realpath ./dist/oosh 2>/dev/null || command -v oosh || echo ./dist/oosh");
    let bin_path: String = match bin_lookup { Ok(s) => str_trim(s), Err(_) => "./dist/oosh" };

    // Launch native compiled C AF_UNIX epoll daemon loop via APC channel.
    let esc: String = ansi_esc();
    let apc_cmd: String = esc + "_daemon:sock=" + sock + ";bin=" + bin_path + ";cwd=" + cwd;
    let _r = oo_tui_write(ffi, apc_cmd);

    // Final cleanup guarantee
    let _ = unlink_stale_socket(sys, sock);
    return 0;
}
