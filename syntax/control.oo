// # Syntax Control Flow and Function Table
//
// Logline: Parses and evaluates loops (for/while), conditionals (if/case), subshells, and functions.
//
// Setup: Bridges control flow statements, command grouping, and in-memory function definitions.
//
// Beats:
//   1. Maintain session function table for user-defined shell functions.
//   2. Parse and evaluate test/[ conditions, string equality, and numeric comparisons.
//   3. Recognize for/while loops, if/case conditionals, groupings, and subshell blocks.

import "lexer.oo";
import "arith.oo";
import "std/fs/process/process.oo";

pub type FunctionMap = struct { names: List[String], bodies: List[String] };
pub fn func_map_new() -> FunctionMap { return FunctionMap { names: list_new(), bodies: list_new() }; }
pub fn func_map_get(m: FunctionMap, name: String) -> Result[String, String] {
    let n: Int = list_len(m.names); let mut i: Int = 0;
    while i < n { if list_get(m.names, i) == name { return Ok(list_get(m.bodies, i)); } i = i + 1; }
    return Err("not_found");
}
pub fn func_map_set(m: FunctionMap, name: String, body: String) -> FunctionMap {
    let mut new_n: List[String] = list_new(); let mut new_b: List[String] = list_new();
    let n: Int = list_len(m.names); let mut i: Int = 0;
    while i < n {
        if list_get(m.names, i) != name { new_n = list_push(new_n, list_get(m.names, i)); new_b = list_push(new_b, list_get(m.bodies, i)); }
        i = i + 1;
    }
    return FunctionMap { names: list_push(new_n, name), bodies: list_push(new_b, body) };
}

pub fn is_subshell_stmt(line: String) -> Bool { let t: String = str_trim(line); return chars_len(t) >= 2 && str_starts_with(t, "(") && str_ends_with(t, ")"); }
pub fn extract_subshell_body(line: String) -> String { let t: String = str_trim(line); let n: Int = chars_len(t); return if n >= 2 && str_starts_with(t, "(") && str_ends_with(t, ")") { str_trim(str_slice(t, 1, n - 1)) } else { t }; }
pub fn is_group_stmt(line: String) -> Bool {
    let t: String = str_trim(line); let n: Int = chars_len(t);
    return n >= 3 && !is_function_def(t) && (str_starts_with(t, "{ ") || str_starts_with(t, "{\t") || str_starts_with(t, "{\n")) && (str_ends_with(t, " }") || str_ends_with(t, "\t}") || str_ends_with(t, "\n}") || str_ends_with(t, ";}"));
}
pub fn extract_group_body(line: String) -> String { let t: String = str_trim(line); let n: Int = chars_len(t); return if n >= 2 && str_starts_with(t, "{") && str_ends_with(t, "}") { str_trim(str_slice(t, 1, n - 1)) } else { t }; }

pub fn is_function_def(line: String) -> Bool { let t: String = str_trim(line); return (str_starts_with(t, "function ") || str_index_of(t, "()") > 0) && str_contains(t, "{") && str_ends_with(t, "}"); }
pub fn parse_function_def(line: String) -> Result[CompoundSplit, String] {
    let t: String = str_trim(line); let o_b: Int = str_index_of(t, "{");
    let mut c_b: Int = -1; let mut ci: Int = chars_len(t) - 1;
    while ci >= 0 { if char_at(t, ci) == "}" { c_b = ci; ci = -1; } else { ci = ci - 1; } }
    if o_b < 0 || c_b <= o_b { return Err("malformed_function"); }
    let body: String = str_trim(str_slice(t, o_b + 1, c_b)); let head: String = str_trim(str_slice(t, 0, o_b));
    let name: String = if str_starts_with(head, "function ") {
        let a: String = str_trim(str_slice(head, 9, chars_len(head))); if str_contains(a, "()") { str_trim(str_slice(a, 0, str_index_of(a, "()"))) } else { a }
    } else {
        let p: Int = str_index_of(head, "()"); if p > 0 { str_trim(str_slice(head, 0, p)) } else { head }
    };
    return Ok(CompoundSplit { lhs: name, op: "def", rhs: body });
}

pub type ForLoopDef = struct { var_name: String, items: List[String], body: String };
pub type WhileLoopDef = struct { cond: String, body: String };
pub type IfStmtDef = struct { cond: String, then_body: String, else_body: String };
pub type CaseStmtDef = struct { matched_body: String };
pub fn for_def_empty() -> ForLoopDef { return ForLoopDef { var_name: "", items: list_new(), body: "" }; }

fn trim_semi(s: String) -> String { let t: String = str_trim(s); return if str_ends_with(t, ";") { str_trim(str_slice(t, 0, chars_len(t) - 1)) } else { t }; }
fn kw_end_ok(t: String, i: Int, n: Int) -> Bool { return i == n || char_at(t, i) == " " || char_at(t, i) == "\t" || char_at(t, i) == "\n" || char_at(t, i) == ";"; }

pub fn find_keyword_delimited(line: String, kw: String, last: Bool) -> Int {
    let n: Int = chars_len(line); let kn: Int = chars_len(kw);
    if kn == 0 || n < kn { return -1; }
    let mut in_s: Bool = false; let mut in_d: Bool = false; let mut esc: Bool = false;
    let mut last_pos: Int = -1; let mut i: Int = 0;
    while i <= n - kn {
        let ch: String = char_at(line, i);
        if esc { esc = false; i = i + 1; } else if ch == "\\" && !in_s { esc = true; i = i + 1; }
        else if ch == "'" && !in_d { in_s = !in_s; i = i + 1; } else if ch == "\"" && !in_s { in_d = !in_d; i = i + 1; }
        else if !in_s && !in_d {
            if str_slice(line, i, i + kn) == kw {
                let p_ok: Bool = i == 0 || kw_end_ok(line, i - 1, n);
                let n_ok: Bool = kw_end_ok(line, i + kn, n);
                if p_ok && n_ok { if !last { return i; } last_pos = i; }
            }
            i = i + 1;
        } else { i = i + 1; }
    }
    return last_pos;
}

pub fn parse_for_stmt(line: String) -> Result[ForLoopDef, String] {
    let do_i: Int = find_keyword_delimited(line, "do", false); let done_i: Int = find_keyword_delimited(line, "done", true);
    if do_i <= 0 || done_i <= do_i { return Err("malformed_for"); }
    let h_toks: List[String] = split_cmd_tokens_quote_aware(trim_semi(str_slice(line, 4, do_i)));
    if list_len(h_toks) < 3 { return Err("missing_in_clause"); }
    let mut items: List[String] = list_new(); let mut hi: Int = 2;
    while hi < list_len(h_toks) { items = list_push(items, list_get(h_toks, hi)); hi = hi + 1; }
    return Ok(ForLoopDef { var_name: list_get(h_toks, 0), items: items, body: trim_semi(str_slice(line, do_i + 2, done_i)) });
}

pub fn parse_while_stmt(line: String) -> Result[WhileLoopDef, String] {
    let do_i: Int = find_keyword_delimited(line, "do", false); let done_i: Int = find_keyword_delimited(line, "done", true);
    if do_i <= 0 || done_i <= do_i { return Err("malformed_while"); }
    return Ok(WhileLoopDef { cond: trim_semi(str_slice(line, 6, do_i)), body: trim_semi(str_slice(line, do_i + 2, done_i)) });
}

pub fn parse_if_stmt(line: String) -> Result[IfStmtDef, String] {
    let t: String = str_trim(line); let n: Int = chars_len(t);
    if !str_starts_with(t, "if ") || n < 8 { return Err("not_if"); }
    let mut in_s: Bool = false; let mut in_d: Bool = false; let mut esc: Bool = false;
    let mut depth: Int = 0; let mut then_pos: Int = -1; let mut elif_pos: Int = -1;
    let mut else_pos: Int = -1; let mut fi_pos: Int = -1; let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(t, i);
        if esc { esc = false; i = i + 1; } else if ch == "\\" && !in_s { esc = true; i = i + 1; }
        else if ch == "'" && !in_d { in_s = !in_s; i = i + 1; } else if ch == "\"" && !in_s { in_d = !in_d; i = i + 1; }
        else if !in_s && !in_d {
            let p_ok: Bool = i == 0 || kw_end_ok(t, i - 1, n);
            if p_ok {
                let rem_len: Int = n - i;
                if rem_len >= 2 && str_slice(t, i, i + 2) == "if" && kw_end_ok(t, i + 2, n) { depth = depth + 1; if depth >= 128 { return Err("recursion_limit_exceeded"); } i = i + 2; }
                else if rem_len >= 2 && str_slice(t, i, i + 2) == "fi" && kw_end_ok(t, i + 2, n) { depth = depth - 1; if depth == 0 { fi_pos = i; i = n; } else { i = i + 2; } }
                else if depth == 1 && rem_len >= 4 && str_slice(t, i, i + 4) == "then" && kw_end_ok(t, i + 4, n) { if then_pos < 0 { then_pos = i; } i = i + 4; }
                else if depth == 1 && rem_len >= 4 && str_slice(t, i, i + 4) == "elif" && kw_end_ok(t, i + 4, n) { if elif_pos < 0 && else_pos < 0 { elif_pos = i; } i = i + 4; }
                else if depth == 1 && rem_len >= 4 && str_slice(t, i, i + 4) == "else" && kw_end_ok(t, i + 4, n) { if else_pos < 0 && elif_pos < 0 { else_pos = i; } i = i + 4; }
                else { i = i + 1; }
            } else { i = i + 1; }
        } else { i = i + 1; }
    }
    if then_pos < 0 || fi_pos < 0 { return Err("malformed_if"); }
    let cond: String = trim_semi(str_slice(t, 3, then_pos));
    if elif_pos > 0 { return Ok(IfStmtDef { cond: cond, then_body: trim_semi(str_slice(t, then_pos + 4, elif_pos)), else_body: "if " + str_trim(str_slice(t, elif_pos + 4, fi_pos)) + "; fi" }); }
    if else_pos > 0 { return Ok(IfStmtDef { cond: cond, then_body: trim_semi(str_slice(t, then_pos + 4, else_pos)), else_body: trim_semi(str_slice(t, else_pos + 4, fi_pos)) }); }
    return Ok(IfStmtDef { cond: cond, then_body: trim_semi(str_slice(t, then_pos + 4, fi_pos)), else_body: "" });
}

pub fn pattern_matches_word(pattern: String, word: String) -> Bool {
    let mut p: String = str_trim(pattern);
    let plen: Int = chars_len(p);
    if plen >= 2 && ((str_starts_with(p, "\"") && str_ends_with(p, "\"")) || (str_starts_with(p, "'") && str_ends_with(p, "'"))) { p = str_slice(p, 1, plen - 1); }
    if p == "*" || p == word { return true; }
    if str_contains(p, "|") {
        let n: Int = chars_len(p); let mut cur: String = ""; let mut i: Int = 0;
        while i < n {
            let c: String = char_at(p, i);
            if c == "|" { if pattern_matches_word(cur, word) { return true; } cur = ""; } else { cur = cur + c; }
            i = i + 1;
        }
        return pattern_matches_word(cur, word);
    }
    if str_contains(p, "?") && chars_len(p) == chars_len(word) {
        let mut mi: Int = 0; let mut ok: Bool = true;
        while mi < chars_len(p) {
            let pc: String = char_at(p, mi);
            if pc != "?" && pc != char_at(word, mi) { ok = false; mi = chars_len(p); } else { mi = mi + 1; }
        }
        if ok { return true; }
    }
    if str_ends_with(p, "*") && str_starts_with(p, "*") { return str_contains(word, str_slice(p, 1, chars_len(p) - 1)); }
    if str_ends_with(p, "*") { return str_starts_with(word, str_slice(p, 0, chars_len(p) - 1)); }
    if str_starts_with(p, "*") { return str_ends_with(word, str_slice(p, 1, chars_len(p))); }
    return false;
}

pub fn is_case_stmt(line: String) -> Bool { let t: String = str_trim(line); let in_i: Int = find_keyword_delimited(t, "in", false); return str_starts_with(t, "case ") && in_i > 0 && find_keyword_delimited(t, "esac", true) > in_i; }

pub fn parse_case_stmt_word(line: String, target_word: String) -> Result[CaseStmtDef, String] {
    let in_i: Int = find_keyword_delimited(line, "in", false); let esac_i: Int = find_keyword_delimited(line, "esac", true);
    if in_i <= 0 || esac_i <= in_i { return Err("malformed_case"); }
    let body: String = str_slice(line, in_i + 2, esac_i); let bn: Int = chars_len(body);
    let mut i: Int = 0; let mut chunk_start: Int = 0;
    let mut in_s: Bool = false; let mut in_d: Bool = false; let mut esc: Bool = false;
    while i <= bn {
        let ch: String = if i < bn { char_at(body, i) } else { "" };
        if esc { esc = false; } else if ch == "\\" && !in_s { esc = true; }
        else if ch == "'" && !in_d { in_s = !in_s; } else if ch == "\"" && !in_s { in_d = !in_d; }
        let is_sep: Bool = if !in_s && !in_d && i + 1 < bn { char_at(body, i) == ";" && char_at(body, i + 1) == ";" } else { i == bn };
        if is_sep {
            let chunk: String = str_trim(str_slice(body, chunk_start, i)); let p_idx: Int = str_index_of(chunk, ")");
            if p_idx > 0 {
                let mut raw_pat: String = str_trim(str_slice(chunk, 0, p_idx));
                if str_starts_with(raw_pat, "(") { raw_pat = str_trim(str_slice(raw_pat, 1, chars_len(raw_pat))); }
                if pattern_matches_word(raw_pat, target_word) { return Ok(CaseStmtDef { matched_body: str_trim(str_slice(chunk, p_idx + 1, chars_len(chunk))) }); }
            }
            chunk_start = i + 2; i = i + 1;
        }
        i = i + 1;
    }
    return Ok(CaseStmtDef { matched_body: "" });
}

pub fn parse_case_stmt(line: String) -> Result[CaseStmtDef, String] {
    let in_i: Int = find_keyword_delimited(line, "in", false); if in_i <= 0 { return Err("malformed_case"); }
    let raw_w: String = str_trim(str_slice(line, 5, in_i)); let wlen: Int = chars_len(raw_w);
    let target_word: String = if wlen >= 2 && ((str_starts_with(raw_w, "\"") && str_ends_with(raw_w, "\"")) || (str_starts_with(raw_w, "'") && str_ends_with(raw_w, "'"))) { str_slice(raw_w, 1, wlen - 1) } else { raw_w };
    return parse_case_stmt_word(line, target_word);
}

pub fn is_line_incomplete(buf: String) -> Bool {
    let t: String = str_trim(buf); let n: Int = chars_len(t); if n == 0 { return false; }
    let mut in_s: Bool = false; let mut in_d: Bool = false; let mut esc: Bool = false;
    let mut p_d: Int = 0; let mut b_d: Int = 0;
    let mut if_cnt: Int = 0; let mut fi_cnt: Int = 0; let mut do_cnt: Int = 0; let mut done_cnt: Int = 0;
    let mut case_cnt: Int = 0; let mut esac_cnt: Int = 0; let mut for_cnt: Int = 0; let mut while_cnt: Int = 0; let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(t, i);
        if esc { esc = false; i = i + 1; }
        else if ch == "\\" && !in_s { esc = true; i = i + 1; }
        else if ch == "'" && !in_d { in_s = !in_s; i = i + 1; }
        else if ch == "\"" && !in_s { in_d = !in_d; i = i + 1; }
        else if !in_s && !in_d {
            let p_ok: Bool = i == 0 || kw_end_ok(t, i - 1, n);
            if ch == "(" { p_d = p_d + 1; } else if ch == ")" && p_d > 0 { p_d = p_d - 1; }
            else if ch == "{" { b_d = b_d + 1; } else if ch == "}" && b_d > 0 { b_d = b_d - 1; }
            else if p_ok {
                let r: String = str_slice(t, i, n); let rl: Int = chars_len(r);
                if str_starts_with(r, "if") && kw_end_ok(r, 2, rl) { if_cnt = if_cnt + 1; } else if str_starts_with(r, "fi") && kw_end_ok(r, 2, rl) { fi_cnt = fi_cnt + 1; }
                else if str_starts_with(r, "do") && kw_end_ok(r, 2, rl) { do_cnt = do_cnt + 1; } else if str_starts_with(r, "done") && kw_end_ok(r, 4, rl) { done_cnt = done_cnt + 1; }
                else if str_starts_with(r, "case") && kw_end_ok(r, 4, rl) { case_cnt = case_cnt + 1; } else if str_starts_with(r, "esac") && kw_end_ok(r, 4, rl) { esac_cnt = esac_cnt + 1; }
                else if str_starts_with(r, "for") && kw_end_ok(r, 3, rl) { for_cnt = for_cnt + 1; } else if str_starts_with(r, "while") && kw_end_ok(r, 5, rl) { while_cnt = while_cnt + 1; }
            }
            i = i + 1;
        } else { i = i + 1; }
    }
    if in_s || in_d || esc || p_d > 0 || b_d > 0 || if_cnt > fi_cnt || do_cnt > done_cnt || case_cnt > esac_cnt || for_cnt > done_cnt || while_cnt > done_cnt { return true; }
    return str_ends_with(t, "\\") || str_ends_with(t, "&&") || str_ends_with(t, "||") || str_ends_with(t, "|");
}

pub fn is_for_stmt(line: String) -> Bool { return str_starts_with(str_trim(line), "for ") && parse_for_stmt(line).is_ok(); }
pub fn is_while_stmt(line: String) -> Bool { return str_starts_with(str_trim(line), "while ") && parse_while_stmt(line).is_ok(); }
pub fn is_if_stmt(line: String) -> Bool { return str_starts_with(str_trim(line), "if ") && parse_if_stmt(line).is_ok(); }

pub fn eval_test_tokens(fs_r: &FsReadCap, sys: &ProcessCap, tokens: List[String]) -> Bool {
    let n: Int = list_len(tokens); if n == 0 { return false; }
    let s_i: Int = if list_get(tokens, 0) == "test" || list_get(tokens, 0) == "[" { 1 } else { 0 };
    let e_i: Int = if n > s_i && list_get(tokens, n - 1) == "]" { n - 1 } else { n };
    let mut args: List[String] = list_new(); let mut i: Int = s_i;
    while i < e_i { args = list_push(args, list_get(tokens, i)); i = i + 1; }
    let argc: Int = list_len(args);
    if argc == 0 { return false; } if argc == 1 { return list_get(args, 0) != ""; }
    if argc == 2 {
        let op: String = list_get(args, 0); let val: String = list_get(args, 1);
        if op == "-z" { return val == ""; } if op == "-n" { return val != ""; } if op == "!" { return val == ""; }
        if op == "-e" { return path_exists(fs_r, val); } if op == "-d" { return path_exists(fs_r, val) && oo_fs_is_dir(fs_r, val); }
        if op == "-f" { return path_exists(fs_r, val) && !oo_fs_is_dir(fs_r, val); } if op == "-s" { return path_exists(fs_r, val) && file_size(fs_r, val) > 0; }
    }
    if argc == 3 {
        let a0: String = list_get(args, 0); let op: String = list_get(args, 1); let a2: String = list_get(args, 2);
        if op == "=" || op == "==" { return a0 == a2; } if op == "!=" { return a0 != a2; }
        if op == "-eq" || op == "-ne" || op == "-lt" || op == "-le" || op == "-gt" || op == "-ge" {
            let v1: Int = parse_int_safe(a0); let v2: Int = parse_int_safe(a2);
            return if op == "-eq" { v1 == v2 } else if op == "-ne" { v1 != v2 } else if op == "-lt" { v1 < v2 } else if op == "-le" { v1 <= v2 } else if op == "-gt" { v1 > v2 } else { v1 >= v2 };
        }
    }
    let mut cmd: String = "test"; let mut fi: Int = 0;
    while fi < argc { cmd = cmd + " \"" + list_get(args, fi) + "\""; fi = fi + 1; }
    return process_exec(sys, cmd).is_ok();
}
