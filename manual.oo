// # oosh Sovereign Manual and Guidance Engine
//
// Logline: Formats and displays built-in command guides, shortcuts, and contextual help documentation.
//
// Setup: Pure terminal ANSI string formatting, reference guide catalog, and telemetry display.
//
// Beats:
//   1. Render categorized sovereign shell command reference.
//   2. Provide focused guidance for individual builtin commands.
//   3. Format node posture, capability audits, and ambient telemetry.

import "std/fs/process/process.oo";
import "prompt.oo";

pub fn print_help_guide() {
    let esc: String = ansi_esc();
    println(esc + "[1;33mᚱ oosh sovereign builtins & triggers:" + esc + "[0m");
    println("");
    println(esc + "[1;36m  Navigation:" + esc + "[0m");
    println("    cd [dir], goto, jump, walk   change directory (~, .., relative, absolute)");
    println("    ..                           navigate to parent directory");
    println("    ...                          navigate up two directory levels");
    println("    pwd, cwd, whereami           display active directory and git branch");
    println("    take [dir], mkcd             create directory recursively and enter it");
    println("");
    println(esc + "[1;36m  Session & Viewport:" + esc + "[0m");
    println("    exit, quit, q, :q, bye       terminate shell session cleanly");
    println("    clear, cls, clean, reset     clear terminal screen");
    println("");
    println(esc + "[1;36m  System & Capability Audit:" + esc + "[0m");
    println("    status, stat, health, info   node posture and runtime telemetry");
    println("    caps, perms, whoami          audit active openOODA capability tokens");
    println("    version, ver, about          display shell banner and version");
    println("    rune, token, talisman        query hardware ambient token enclave");
    println("    autopsy, bb, blackbox        examine flight recorder / crash telemetry");
    println("    link [sock], connect         connect or probe syntropd IPC daemon");
    println("    scry [target], inspect       deep-scan process or system diagnostics");
    println("    remedy, fix, repair          diagnose last failure and suggest recovery");
    println("");
    println(esc + "[1;36m  Ergonomics & Host Execution:" + esc + "[0m");
    println("    open [target], view, show    open file or URL with default desktop app");
    println("    time [cmd], bench            measure execution duration and memory");
    println("    env, vars, printenv          display active environment variables");
    println("    ? <query>, ask, how, why     channel intent to openOODA reasoning substrate");
    println("    <binary> [args]              execute any host binary (ls, git, cargo, ps)");
}

pub fn print_context_help(raw_topic: String) {
    let esc: String = ansi_esc();
    let topic: String = str_trim(raw_topic);
    if topic == "cd" || topic == "goto" || topic == "jump" || topic == ".." || topic == "walk" {
        println(esc + "[1;33mcd [dir] / .. / ... / take <dir>" + esc + "[0m");
        println("  Navigation builtins. Bare '..' jumps up one level, '...' jumps two.");
        println("  'take <dir>' (or 'mkcd') creates a directory and cds into it in one step.");
        println("  Aliases: goto, jump, walk.");
        return;
    }
    if topic == "exit" || topic == "quit" || topic == ":q" || topic == "q" || topic == "bye" {
        println(esc + "[1;33mexit / quit / :q / bye" + esc + "[0m");
        println("  Terminates current oosh session cleanly and restores terminal state.");
        println("  Aliases: quit, q, :q, :q!, :x, bye, logout, leave, close.");
        return;
    }
    if topic == "caps" || topic == "whoami" || topic == "perms" || topic == "tokens" {
        println(esc + "[1;33mcaps / perms / whoami" + esc + "[0m");
        println("  Audits active openOODA unforgeable capability tokens and host user identity.");
        println("  Aliases: cap, capabilities, perms, permissions, tokens, authority, whoami.");
        return;
    }
    if topic == "status" || topic == "health" || topic == "info" {
        println(esc + "[1;33mstatus / health / info" + esc + "[0m");
        println("  Displays node posture, active substrate, and syntropd link telemetry.");
        println("  Aliases: stat, info, health, posture, ping, check, --status, -s.");
        return;
    }
    if topic == "take" || topic == "mkcd" || topic == "mcd" {
        println(esc + "[1;33mtake <dir> / mkcd <dir>" + esc + "[0m");
        println("  Atomically creates directory hierarchy ('mkdir -p') and navigates into it.");
        println("  Aliases: mkcd, mcd, mdcd, create-cd.");
        return;
    }
    if topic == "open" || topic == "view" || topic == "show" {
        println(esc + "[1;33mopen <file/url> / view <file>" + esc + "[0m");
        println("  Launches target with desktop handler (xdg-open) or default viewer.");
        println("  Aliases: view, show, launch, xdg-open.");
        return;
    }
    if topic == "time" || topic == "bench" || topic == "clock" {
        println(esc + "[1;33mtime <command> / bench <command>" + esc + "[0m");
        println("  Executes command and measures wall-clock duration and memory overhead.");
        println("  Aliases: bench, benchmark, measure, clock.");
        return;
    }
    print_help_guide();
}

pub fn print_status(cwd: String) {
    let esc: String = ansi_esc();
    println(esc + "[1;33m⚡ oosh node telemetry:" + esc + "[0m");
    println("   Mode:       Standalone Sovereign Shell");
    println("   CWD:        " + cwd);
    println("   Substrate:  openOODA native runtime (glibc)");
    println("   Syntropd:   Dormant (local control socket unlinked)");
    println("   Latency:    < 1ms interactive dispatch");
}

pub fn print_caps(sys: &ProcessCap) {
    let esc: String = ansi_esc();
    let user_res: Result[String, String] = process_exec(sys, "id -un 2>/dev/null || whoami");
    let user_str: String = match user_res { Ok(u) => str_trim(u), Err(_) => "sovereign" };
    println(esc + "[1;33m⚡ oosh sovereign capability audit:" + esc + "[0m");
    println("   Identity:     " + user_str);
    println("   Tokens Held:  &ProcessCap (host process execution)");
    println("                 &EnvCap     (environment isolation)");
    println("                 &FsReadCap  (filesystem inspection)");
    println("                 &TimeCap    (monotonic latency clock)");
    println("   Enclave:      Software Sandbox (glibc standalone)");
    println("   Rune Token:   Unbound (local terminal session)");
}

pub fn print_autopsy() {
    let esc: String = ansi_esc();
    println(esc + "[1;33m⚡ oosh flight recorder (blackbox):" + esc + "[0m");
    println("   Postmortem:   Nominal (0 unhandled faults)");
    println("   Causal trace: Clean execution pipeline");
    println("   Flight log:   Armed (in-memory ring buffer)");
}

pub fn print_rune() {
    let esc: String = ansi_esc();
    println(esc + "[1;33mᚱ oosh ambient rune status:" + esc + "[0m");
    println("   Hardware:     No physical rune token detected on USB/NFC");
    println("   Subsystem:    Ambient listener dormant");
    println("   Authority:    Session operating under local host terminal");
}

pub fn print_link() {
    let esc: String = ansi_esc();
    println(esc + "[1;36m✦ syntropd link coordinator:" + esc + "[0m");
    println("   Target:       /run/syntrop/control.sock");
    println("   Status:       Socket not found (daemon offline)");
    println("   Note:         Run 'systemctl status syntropd' to start the ambient daemon.");
}

pub fn print_remedy() {
    let esc: String = ansi_esc();
    println(esc + "[1;36m✦ oosh remedy engine:" + esc + "[0m");
    println("   Diagnostic:   No active failure trace detected in current scope.");
    println("   Hint:         If a command fails, invoke 'remedy' immediately to diagnose.");
}

pub fn print_scry(sys: &ProcessCap, cwd: String) {
    let esc: String = ansi_esc();
    println(esc + "[1;35m✦ scry system observation:" + esc + "[0m");
    let diag: Result[String, String] = process_exec(sys, "cd \"" + cwd + "\" && (uptime && free -h | head -2) 2>/dev/null");
    let diag_str: String = match diag { Ok(s) => s, Err(_) => "system telemetry unavailable\n" };
    print(diag_str);
}
