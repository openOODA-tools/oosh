// # Terminal Subsystem Anchor Shim
//
// Logline: Re-exports terminal raw mode, line editor, escape decoder, and history management.
//
// Setup: Bridges terminal capabilities across openOODA shell submodules.
//
// Beats:
//   1. Re-export raw mode lifecycle controllers.
//   2. Re-export escape sequence reader and key events.
//   3. Re-export in-memory line buffer editor.
//   4. Re-export persistent command history storage.
//   5. Re-export tab completion engine.

import "raw.oo";
import "read.oo";
import "line.oo";
import "history.oo";
import "complete.oo";

pub fn term_enable(ffi: &FfiCap) -> Result[String, String] {
    return term_enable_raw(ffi);
}

pub fn term_disable(ffi: &FfiCap) -> Result[String, String] {
    return term_disable_raw(ffi);
}

pub fn term_read(ffi: &FfiCap) -> KeyEvent {
    return term_read_key(ffi);
}

pub fn term_line_new() -> LineEditor {
    return line_editor_new();
}

pub fn term_history_load(fs_r: &FsReadCap, env: &EnvCap) -> HistoryState {
    return history_load(fs_r, env);
}

pub fn term_complete(fs_r: &FsReadCap, cur_line: String, alias_names: List[String]) -> String {
    return complete_token(fs_r, cur_line, alias_names);
}

pub fn term_complete_ghost(fs_r: &FsReadCap, cur_line: String, alias_names: List[String]) -> String {
    return complete_ghost(fs_r, cur_line, alias_names);
}

pub fn term_history_suggest(hist: HistoryState, cur_prefix: String) -> String {
    return history_suggest(hist, cur_prefix);
}

pub fn term_line_redraw_full(prompt: String, ed: LineEditor, ghost: String) {
    line_editor_redraw_full(prompt, ed, ghost);
}

pub fn term_get_cols(ffi: &FfiCap) -> Int {
    return term_get_terminal_cols(ffi);
}

pub fn term_strip_escapes(s: String) -> String {
    return strip_escape_sequences(s);
}
