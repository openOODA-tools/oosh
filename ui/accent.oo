// # Command Syntax Accenting Engine
//
// Logline: Classifies input commands to dynamically accent builtins, host binaries, strings, and paths.
//
// Setup: Pure string analysis. Imports ui/palette.oo for TrueColor classification badges and live syntax.
//
// Beats:
//   1. Extract primary command verb from input command string.
//   2. Match verb against builtins, intent indicators, and system execution patterns.
//   3. Highlight command verbs, arguments, strings, paths, and pipes live in real time.

import "palette.oo";

pub fn is_navigation_verb(verb: String) -> Bool {
    return verb == "cd" || verb == "chdir" || verb == "goto" || verb == "jump" || verb == "walk" ||
           verb == ".." || verb == "..." || verb == "...." || verb == "-" ||
           verb == "take" || verb == "mkcd" || verb == "mcd" || verb == "mdcd" ||
           verb == "pwd" || verb == "cwd" || verb == "where" || verb == "here" || verb == "whereami";
}

pub fn is_builtin_verb(verb: String) -> Bool {
    return is_navigation_verb(verb) ||
           verb == "status" || verb == "info" || verb == "health" || verb == "posture" ||
           verb == "caps" || verb == "cap" || verb == "perms" || verb == "tokens" ||
           verb == "help" || verb == "-h" || verb == "--help" || verb == "?" || verb == "guide" || verb == "docs" ||
           verb == "scry" || verb == "oosh inspect" || verb == "probe" || verb == "trace" ||
           verb == "autopsy" || verb == "bb" || verb == "blackbox" || verb == "crash" ||
           verb == "remedy" || verb == "fix" || verb == "repair" || verb == "heal" ||
           verb == "rune" || verb == "token" || verb == "link" || verb == "connect" ||
           verb == "clear" || verb == "cls" || verb == "clean" || verb == "reset" || verb == "wipe" || verb == "blank" ||
           verb == "open" || verb == "view" || verb == "show" || verb == "time" || verb == "bench" ||
           verb == "exit" || verb == "quit" || verb == "q" || verb == ":q" || verb == ":q!" || verb == ":x" || verb == "bye" ||
           verb == "version" || verb == "ver" || verb == "about" ||
           verb == "history" || verb == "hist" || verb == "past" || verb == "recall" ||
           verb == "env" || verb == "vars" || verb == "printenv" ||
           verb == "export" || verb == "unset" || verb == "alias" || verb == "unalias" ||
           verb == "jobs";
}

fn is_intent_query(cmd: String) -> Bool {
    let trimmed: String = str_trim(cmd);
    if trimmed == "?" {
        return false;
    }
    return str_starts_with(trimmed, "?") ||
           str_starts_with(trimmed, "ai ") ||
           str_starts_with(trimmed, "ask ") ||
           str_starts_with(trimmed, "do ") ||
           str_starts_with(trimmed, "how ") ||
           str_starts_with(trimmed, "why ") ||
           str_starts_with(trimmed, "please ");
}

pub fn render_syntax_accent(cmd: String) -> String {
    return render_syntax_accent_themed(cmd, "");
}

pub fn render_syntax_accent_themed(cmd: String, theme: String) -> String {
    let trimmed: String = str_trim(cmd);
    if trimmed == "" { return ""; }
    let rst: String = cyber_reset();

    if is_intent_query(trimmed) {
        return theme_shell_intent(theme) + "[INTENT CHANNEL]" + rst;
    }

    let sp_idx: Int = str_index_of(trimmed, " ");
    let tb_idx: Int = str_index_of(trimmed, "\t");
    let mut cut_idx: Int = -1;
    if sp_idx >= 0 && tb_idx >= 0 { cut_idx = if sp_idx < tb_idx { sp_idx } else { tb_idx }; }
    else if sp_idx >= 0 { cut_idx = sp_idx; }
    else if tb_idx >= 0 { cut_idx = tb_idx; }
    let verb: String = if cut_idx >= 0 { str_slice(trimmed, 0, cut_idx) } else { trimmed };

    if is_navigation_verb(verb) {
        return theme_shell_nav(theme) + "[NAVIGATION: " + verb + "]" + rst;
    }
    if is_builtin_verb(verb) {
        return theme_shell_builtin(theme) + "[SOVEREIGN BUILTIN: " + verb + "]" + rst;
    }

    return theme_shell_host_bin(theme) + "[HOST BINARY: " + verb + "]" + rst;
}

fn color_token(tok: String, is_first: Bool, theme: String) -> String {
    let rst: String = cyber_reset();
    if is_first {
        if is_intent_query(tok) { return theme_shell_intent(theme) + tok + rst; }
        if is_builtin_verb(tok) { return theme_shell_builtin(theme) + tok + rst; }
        if is_navigation_verb(tok) { return theme_shell_nav(theme) + tok + rst; }
        return theme_shell_host_bin(theme) + tok + rst;
    }
    // Pipeline and redirection operators
    if tok == "|" || tok == ">" || tok == ">>" || tok == "<" || tok == "&&" || tok == "||" {
        return theme_shell_intent(theme) + tok + rst;
    }
    // String literals (quoted)
    if str_starts_with(tok, "\"") || str_starts_with(tok, "'") {
        return theme_shell_builtin(theme) + tok + rst;
    }
    // Paths (contain slash or start with tilde)
    if str_contains(tok, "/") || str_starts_with(tok, "~") {
        return theme_shell_nav(theme) + tok + rst;
    }
    // Command flags
    if str_starts_with(tok, "-") {
        return theme_shell_builtin(theme) + tok + rst;
    }
    return tok;
}

pub fn accent_command_tokens(cmd: String) -> String {
    return accent_command_tokens_themed(cmd, "");
}

pub fn accent_command_tokens_themed(cmd: String, theme: String) -> String {
    let n: Int = chars_len(cmd);
    if n == 0 { return ""; }
    if is_intent_query(cmd) {
        return theme_shell_intent(theme) + cmd + cyber_reset();
    }
    let mut out: String = "";
    let mut cur: String = "";
    let mut is_first: Bool = true;
    let mut in_str: Bool = false;
    let mut quote_ch: String = "";
    let mut i: Int = 0;

    while i < n {
        let ch: String = char_at(cmd, i);
        if in_str {
            cur = cur + ch;
            if ch == quote_ch {
                in_str = false;
                quote_ch = "";
                out = out + color_token(cur, is_first, theme);
                cur = "";
                is_first = false;
            }
        } else if ch == "\"" || ch == "'" {
            if cur != "" {
                out = out + color_token(cur, is_first, theme);
                is_first = false;
                cur = "";
            }
            in_str = true;
            quote_ch = ch;
            cur = ch;
        } else if ch == " " || ch == "\t" {
            if cur != "" {
                out = out + color_token(cur, is_first, theme);
                is_first = false;
                cur = "";
            }
            out = out + ch;
        } else if ch == "|" || ch == ">" || ch == "<" || ch == ";" || (ch == "&" && i + 1 < n && char_at(cmd, i + 1) == "&") {
            if cur != "" {
                out = out + color_token(cur, is_first, theme);
                is_first = false;
                cur = "";
            }
            if ch == ">" && i + 1 < n && char_at(cmd, i + 1) == ">" {
                out = out + color_token(">>", false, theme);
                i = i + 1;
            } else if ch == "&" && i + 1 < n && char_at(cmd, i + 1) == "&" {
                out = out + color_token("&&", false, theme);
                i = i + 1;
                is_first = true;
            } else if ch == "|" && i + 1 < n && char_at(cmd, i + 1) == "|" {
                out = out + color_token("||", false, theme);
                i = i + 1;
                is_first = true;
            } else if ch == "|" || ch == ";" {
                out = out + color_token(ch, false, theme);
                is_first = true;
            } else {
                out = out + color_token(ch, false, theme);
            }
        } else {
            cur = cur + ch;
        }
        i = i + 1;
    }
    if cur != "" {
        out = out + color_token(cur, is_first, theme);
    }
    return out;
}
