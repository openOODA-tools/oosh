// # Test Control Suite - Unit Verification for Control Flow Structures
//
// Logline: Verify parsing and state evaluation for conditionals, loops, subshells, and functions.
//
// Setup: Pure algorithmic test suite using TestRunner and syntax/control.oo.
//
// Beats:
//   1. Test if conditional parsing with and without else branches.
//   2. Test for and while loop statement parsing.
//   3. Test subshell recognition, subshell body extraction, and function table operations.

import "std/meta/test/runner.oo";
import "syntax/control.oo";

pub fn run_test_control(r: TestRunner) -> TestRunner {
    let mut tr: TestRunner = r;

    // if statement parsing
    let if1: Result[IfStmtDef, String] = parse_if_stmt("if test 1 -eq 1; then echo yes; fi");
    tr = test_assert(tr, "control: parse flat if statement", if1.is_ok());
    if if1.is_ok() {
        let def1: IfStmtDef = match if1 { Ok(d) => d, Err(_) => IfStmtDef { cond: "", then_body: "", else_body: "" } };
        tr = test_assert_eq_str(tr, "control: if cond", def1.cond, "test 1 -eq 1");
        tr = test_assert_eq_str(tr, "control: if then_body", def1.then_body, "echo yes");
        tr = test_assert_eq_str(tr, "control: if else_body empty", def1.else_body, "");
    }

    let if2: Result[IfStmtDef, String] = parse_if_stmt("if false; then echo 1; else echo 2; fi");
    tr = test_assert(tr, "control: parse if/else statement", if2.is_ok());
    if if2.is_ok() {
        let def2: IfStmtDef = match if2 { Ok(d) => d, Err(_) => IfStmtDef { cond: "", then_body: "", else_body: "" } };
        tr = test_assert_eq_str(tr, "control: if/else then", def2.then_body, "echo 1");
        tr = test_assert_eq_str(tr, "control: if/else else", def2.else_body, "echo 2");
    }

    // for loop parsing
    let f1: Result[ForLoopDef, String] = parse_for_stmt("for x in a b c; do echo $x; done");
    tr = test_assert(tr, "control: parse for loop", f1.is_ok());
    if f1.is_ok() {
        let fdef: ForLoopDef = match f1 { Ok(d) => d, Err(_) => for_def_empty() };
        tr = test_assert_eq_str(tr, "control: for var name", fdef.var_name, "x");
        tr = test_assert_eq_int(tr, "control: for items count", list_len(fdef.items), 3);
        tr = test_assert_eq_str(tr, "control: for body", fdef.body, "echo $x");
    }

    // while loop parsing
    let w1: Result[WhileLoopDef, String] = parse_while_stmt("while test $i -lt 5; do i=done; done");
    tr = test_assert(tr, "control: parse while loop", w1.is_ok());
    if w1.is_ok() {
        let wdef: WhileLoopDef = match w1 { Ok(d) => d, Err(_) => WhileLoopDef { cond: "", body: "" } };
        tr = test_assert_eq_str(tr, "control: while cond", wdef.cond, "test $i -lt 5");
        tr = test_assert_eq_str(tr, "control: while body", wdef.body, "i=done");
    }

    // subshell detection and extraction
    tr = test_assert(tr, "control: is subshell (echo hi)", is_subshell_stmt("(echo hi)"));
    tr = test_assert(tr, "control: not subshell echo hi", !is_subshell_stmt("echo hi"));
    tr = test_assert_eq_str(tr, "control: extract subshell body", extract_subshell_body("(echo subshell_ok)"), "echo subshell_ok");

    // function table operations
    let mut fm: FunctionMap = func_map_new();
    fm = func_map_set(fm, "greet", "echo hello sovereign");
    let g1: Result[String, String] = func_map_get(fm, "greet");
    tr = test_assert(tr, "control: function map get exists", g1.is_ok());
    if g1.is_ok() {
        tr = test_assert_eq_str(tr, "control: function body", match g1 { Ok(s) => s, Err(_) => "" }, "echo hello sovereign");
    }
    let g2: Result[String, String] = func_map_get(fm, "nonexistent");
    tr = test_assert(tr, "control: function map get missing", g2.is_err());

    // command grouping
    tr = test_assert(tr, "control: is group stmt { echo a; }", is_group_stmt("{ echo a; }"));
    tr = test_assert(tr, "control: not group stmt echo a", !is_group_stmt("echo a"));
    tr = test_assert_eq_str(tr, "control: extract group body", extract_group_body("{ echo group_ok; }"), "echo group_ok;");

    // incomplete line detection
    tr = test_assert(tr, "control: incomplete unclosed single quote", is_line_incomplete("echo 'hello"));
    tr = test_assert(tr, "control: incomplete unclosed double quote", is_line_incomplete("echo \"hello"));
    tr = test_assert(tr, "control: incomplete trailing backslash", is_line_incomplete("echo hello \\"));
    tr = test_assert(tr, "control: incomplete trailing pipe", is_line_incomplete("cat foo |"));
    tr = test_assert(tr, "control: incomplete for loop", is_line_incomplete("for x in 1 2; do"));
    tr = test_assert(tr, "control: incomplete for without do", is_line_incomplete("for x in 1 2 3"));
    tr = test_assert(tr, "control: incomplete while without do", is_line_incomplete("while true"));
    tr = test_assert(tr, "control: incomplete if block", is_line_incomplete("if true; then"));
    tr = test_assert(tr, "control: complete statement", !is_line_incomplete("echo hello"));

    // case statement parsing and pattern matching
    tr = test_assert(tr, "control: pattern match exact", pattern_matches_word("foo", "foo"));
    tr = test_assert(tr, "control: pattern match wildcard", pattern_matches_word("*", "anything"));
    tr = test_assert(tr, "control: pattern match alternation", pattern_matches_word("a|b|c", "b"));
    tr = test_assert(tr, "control: pattern match prefix", pattern_matches_word("foo*", "foobar"));
    tr = test_assert(tr, "control: pattern match suffix", pattern_matches_word("*.txt", "readme.txt"));
    tr = test_assert(tr, "control: pattern match quoted", pattern_matches_word("\"foo\"", "foo"));
    tr = test_assert(tr, "control: pattern match single quoted", pattern_matches_word("'bar'", "bar"));
    tr = test_assert(tr, "control: pattern match question mark", pattern_matches_word("fo?", "foo"));
    let cs_res: Result[CaseStmtDef, String] = parse_case_stmt_word("case bar in foo) echo 1 ;; bar) echo 2 ;; esac", "bar");
    tr = test_assert(tr, "control: parse case stmt word", cs_res.is_ok());
    if cs_res.is_ok() {
        let cs_def: CaseStmtDef = match cs_res { Ok(d) => d, Err(_) => CaseStmtDef { matched_body: "" } };
        tr = test_assert_eq_str(tr, "control: case matched body", cs_def.matched_body, "echo 2");
    }
    let cs_q: Result[CaseStmtDef, String] = parse_case_stmt("case \"bar\" in (foo) echo 1 ;; (bar) echo 2 ;; esac");
    tr = test_assert(tr, "control: parse case quoted with parens", cs_q.is_ok());
    if cs_q.is_ok() {
        let cd_q: CaseStmtDef = match cs_q { Ok(d) => d, Err(_) => CaseStmtDef { matched_body: "" } };
        tr = test_assert_eq_str(tr, "control: case matched body quoted", cd_q.matched_body, "echo 2");
    }

    return tr;
}
