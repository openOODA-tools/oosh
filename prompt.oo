// # oosh Prompt Renderer
//
// Logline: Renders standard POSIX bash prompt and current working directory path.
//
// Setup: Pure string formatting. Formats current directory from active shell state with tilde abbreviation.
//
// Beats:
//   1. Resolve active directory string safely.
//   2. Abbreviate home directory path with tilde glyph when applicable.
//   3. Render standard POSIX Bash prompt or custom PS1 sovereign posture.

import "std/fs/process/env.oo";
import "ui/anchor.oo";

pub fn ansi_esc() -> String {
    return bytes_to_str(bytes_push(bytes_new(), 27));
}

pub fn format_prompt_path(env: &EnvCap, cwd: String) -> String {
    let mut home: String = match env_get(env, "HOME") { Ok(h) => h, Err(_) => "" };
    if home == "" {
        if str_starts_with(cwd, "/home/") {
            let after: String = str_slice(cwd, 6, chars_len(cwd));
            let s_idx: Int = str_index_of(after, "/");
            let u: String = if s_idx > 0 { str_slice(after, 0, s_idx) } else { after };
            if u != "" { home = "/home/" + u; }
        } else if str_starts_with(cwd, "/root") {
            home = "/root";
        }
    }

    if home != "" {
        if cwd == home { return "~"; }
        if str_starts_with(cwd, home + "/") {
            let rest: String = str_slice(cwd, chars_len(home), chars_len(cwd));
            return "~" + rest;
        }
    }
    return cwd;
}

pub fn render_grounded_symbol(has_failure: Bool) -> String {
    return if has_failure { "$ " } else { "$ " };
}

pub fn render_prompt_state(env: &EnvCap, cwd: String, has_failure: Bool) -> String {
    let ps1_r: Result[String, String] = env_get(env, "PS1");
    if ps1_r.is_ok() {
        let ps1: String = match ps1_r { Ok(s) => s, Err(_) => "" };
        if ps1 != "" { return ps1; }
    }
    let u_r: Result[String, String] = env_get(env, "USER");
    let user: String = match u_r { Ok(u) => u, Err(_) => "user" };
    let h_r: Result[String, String] = env_get(env, "HOSTNAME");
    let host: String = match h_r { Ok(h) => h, Err(_) => "localhost" };
    let p_path: String = format_prompt_path(env, cwd);
    let sym_r: Result[String, String] = env_get(env, "OOSH_PROMPT_SYMBOL");
    let custom_sym: String = match sym_r { Ok(s) => s, Err(_) => "" };
    let sign: String = if custom_sym != "" { custom_sym } else if user == "root" { "# " } else { "$ " };
    return user + "@" + host + ":" + p_path + sign;
}

pub fn render_prompt(env: &EnvCap, cwd: String) -> String {
    return render_prompt_state(env, cwd, false);
}

pub fn render_prompt_with_dock(fs_r: &FsReadCap, env: &EnvCap, cwd: String, has_failure: Bool, last_rc: Int) -> String {
    let dock: String = ui_render_dock(fs_r, env, cwd, has_failure, last_rc);
    let p: String = render_prompt_state(env, cwd, has_failure);
    return dock + p;
}

pub fn render_plain_prompt(env: &EnvCap, cwd: String) -> String {
    return render_prompt_state(env, cwd, false);
}

pub fn parse_cd_target(line: String, cwd: String, home: String, oldpwd: String) -> String {
    let raw_t: String = if line == ".." { ".." } else if line == "..." { "../.." } else if line == "...." { "../../.." } else if line == "-" { "-" } else if line == "cd" || line == "chdir" || line == "goto" || line == "jump" || line == "walk" { "~" } else if str_starts_with(line, "cd ") { str_slice(line, 3, chars_len(line)) } else if str_starts_with(line, "chdir ") { str_slice(line, 6, chars_len(line)) } else { str_slice(line, 5, chars_len(line)) };
    let clean_t: String = str_trim(raw_t);
    if clean_t == "~" || clean_t == "" { return home; }
    if clean_t == "-" { return oldpwd; }
    if str_starts_with(clean_t, "~/") { return home + str_slice(clean_t, 1, chars_len(clean_t)); }
    return clean_t;
}

