// # oosh Session Command Alias and State Table
//
// Logline: Manages in-memory session state, command aliases, and environment variables.
//
// Setup: Pure string associative map. Stores session environment and alias definitions across prompt iterations.
//
// Beats:
//   1. Initialize session state, env map, and alias table.
//   2. Store, lookup, and remove alias and env key-value definitions.
//   3. Format active aliases, split compounds, and expand environment variables.

import "std/fs/process/env.oo";

pub type AliasMap = struct {
    names: List[String],
    targets: List[String]
};

pub type EnvMap = struct {
    keys: List[String],
    vals: List[String]
};

pub type SessionState = struct {
    cwd: String,
    env_map: EnvMap,
    alias_map: AliasMap
};

pub type CompoundSplit = struct {
    lhs: String,
    op: String,
    rhs: String
};

pub fn alias_map_new() -> AliasMap {
    let empty_n: List[String] = list_new();
    let empty_t: List[String] = list_new();
    return AliasMap { names: empty_n, targets: empty_t };
}

pub fn alias_map_get(m: AliasMap, name: String) -> Result[String, String] {
    let n: Int = list_len(m.names);
    let mut i: Int = 0;
    while i < n {
        if list_get(m.names, i) == name { return Ok(list_get(m.targets, i)); }
        i = i + 1;
    }
    return Err("not_found");
}

pub fn alias_map_remove(m: AliasMap, name: String) -> AliasMap {
    let mut new_n: List[String] = list_new();
    let mut new_t: List[String] = list_new();
    let n: Int = list_len(m.names);
    let mut i: Int = 0;
    while i < n {
        let cur_name: String = list_get(m.names, i);
        if cur_name != name {
            new_n = list_push(new_n, cur_name); new_t = list_push(new_t, list_get(m.targets, i));
        }
        i = i + 1;
    }
    return AliasMap { names: new_n, targets: new_t };
}

pub fn alias_map_set(m: AliasMap, name: String, target: String) -> AliasMap {
    let rem: AliasMap = alias_map_remove(m, name);
    return AliasMap { names: list_push(rem.names, name), targets: list_push(rem.targets, target) };
}

pub fn format_aliases(m: AliasMap) -> String {
    let n: Int = list_len(m.names);
    if n == 0 { return "No aliases defined\n"; }
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        out = out + "alias " + list_get(m.names, i) + "='" + list_get(m.targets, i) + "'\n";
        i = i + 1;
    }
    return out;
}

pub fn alias_expand(m: AliasMap, line: String) -> String {
    let trimmed: String = str_trim(line);
    let n: Int = chars_len(trimmed);
    let mut sp_idx: Int = n;
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(trimmed, i);
        if ch == " " || ch == "\t" { sp_idx = i; i = n; } else { i = i + 1; }
    }
    let first_tok: String = str_slice(trimmed, 0, sp_idx);
    let r: Result[String, String] = alias_map_get(m, first_tok);
    if r.is_ok() {
        let target: String = match r { Ok(t) => t, Err(_) => "" };
        let rest: String = if sp_idx < n { str_slice(trimmed, sp_idx, n) } else { "" };
        return target + rest;
    }
    return line;
}

pub fn split_cmd_tokens(cmd: String) -> List[String] {
    let mut tokens: List[String] = list_new();
    let n: Int = chars_len(cmd);
    let mut cur: String = "";
    let mut in_q: Bool = false;
    let mut q_ch: String = "";
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(cmd, i);
        if in_q {
            if ch == q_ch { in_q = false; q_ch = ""; } else { cur = cur + ch; }
        } else if ch == "\"" || ch == "'" {
            in_q = true; q_ch = ch;
        } else if ch == " " || ch == "\t" {
            if cur != "" { tokens = list_push(tokens, cur); cur = ""; }
        } else { cur = cur + ch; }
        i = i + 1;
    }
    if cur != "" { tokens = list_push(tokens, cur); }
    return tokens;
}

pub fn env_map_new() -> EnvMap {
    let empty_k: List[String] = list_new();
    let empty_v: List[String] = list_new();
    return EnvMap { keys: empty_k, vals: empty_v };
}

pub fn env_map_get(m: EnvMap, key: String) -> Result[String, String] {
    let n: Int = list_len(m.keys);
    let mut i: Int = 0;
    while i < n {
        if list_get(m.keys, i) == key { return Ok(list_get(m.vals, i)); }
        i = i + 1;
    }
    return Err("not_found");
}

pub fn env_map_remove(m: EnvMap, key: String) -> EnvMap {
    let mut new_k: List[String] = list_new();
    let mut new_v: List[String] = list_new();
    let n: Int = list_len(m.keys);
    let mut i: Int = 0;
    while i < n {
        let cur_k: String = list_get(m.keys, i);
        if cur_k != key {
            new_k = list_push(new_k, cur_k); new_v = list_push(new_v, list_get(m.vals, i));
        }
        i = i + 1;
    }
    return EnvMap { keys: new_k, vals: new_v };
}

pub fn env_map_set(m: EnvMap, key: String, val: String) -> EnvMap {
    let rem: EnvMap = env_map_remove(m, key);
    return EnvMap { keys: list_push(rem.keys, key), vals: list_push(rem.vals, val) };
}

pub fn session_state_new(init_cwd: String, init_aliases: AliasMap) -> SessionState {
    return SessionState {
        cwd: init_cwd,
        env_map: env_map_new(),
        alias_map: init_aliases
    };
}

pub fn find_compound_op(cmd: String) -> CompoundSplit {
    let n: Int = chars_len(cmd);
    let mut in_s: Bool = false;
    let mut in_d: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(cmd, i);
        if ch == "'" && !in_d { in_s = !in_s; }
        else if ch == "\"" && !in_s { in_d = !in_d; }
        else if !in_s && !in_d {
            if ch == ";" {
                return CompoundSplit { lhs: str_trim(str_slice(cmd, 0, i)), op: ";", rhs: str_trim(str_slice(cmd, i + 1, n)) };
            }
            if i + 1 < n {
                let next_ch: String = char_at(cmd, i + 1);
                if ch == "&" && next_ch == "&" {
                    return CompoundSplit { lhs: str_trim(str_slice(cmd, 0, i)), op: "&&", rhs: str_trim(str_slice(cmd, i + 2, n)) };
                }
                if ch == "|" && next_ch == "|" {
                    return CompoundSplit { lhs: str_trim(str_slice(cmd, 0, i)), op: "||", rhs: str_trim(str_slice(cmd, i + 2, n)) };
                }
            }
        }
        i = i + 1;
    }
    return CompoundSplit { lhs: cmd, op: "", rhs: "" };
}

pub fn expand_env_vars(env: &EnvCap, session: SessionState, last_rc: Int, line: String) -> String {
    let n: Int = chars_len(line);
    let mut out: String = "";
    let mut in_s: Bool = false;
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(line, i);
        if ch == "'" { in_s = !in_s; out = out + ch; i = i + 1; }
        else if ch == "$" && !in_s && i + 1 < n {
            let next_ch: String = char_at(line, i + 1);
            if next_ch == "?" {
                out = out + last_rc.to_string();
                i = i + 2;
            } else if next_ch == "{" {
                let mut close_idx: Int = -1;
                let mut ci: Int = i + 2;
                while ci < n {
                    if char_at(line, ci) == "}" { close_idx = ci; ci = n; }
                    else { ci = ci + 1; }
                }
                if close_idx >= 0 {
                    let k: String = str_slice(line, i + 2, close_idx);
                    let val: String = match env_map_get(session.env_map, k) {
                        Ok(v) => v,
                        Err(_) => match env_get(env, k) { Ok(ev) => ev, Err(_) => "" }
                    };
                    out = out + val;
                    i = close_idx + 1;
                } else { out = out + "${"; i = i + 2; }
            } else {
                let mut vi: Int = i + 1;
                let mut var_name: String = "";
                while vi < n {
                    let vc: String = char_at(line, vi);
                    let vb: Int = byte_at(vc, 0);
                    if (vb >= 65 && vb <= 90) || (vb >= 97 && vb <= 122) || (vb >= 48 && vb <= 57) || vb == 95 {
                        var_name = var_name + vc;
                        vi = vi + 1;
                    } else { vi = n; }
                }
                if chars_len(var_name) > 0 {
                    let val: String = match env_map_get(session.env_map, var_name) {
                        Ok(v) => v,
                        Err(_) => match env_get(env, var_name) { Ok(ev) => ev, Err(_) => "" }
                    };
                    out = out + val;
                    i = i + 1 + chars_len(var_name);
                } else { out = out + "$"; i = i + 1; }
            }
        } else { out = out + ch; i = i + 1; }
    }
    return out;
}
