// # oosh Interactive Engine - The OODA REPL Loop
//
// Logline: Implements the interactive prompt loop: observes input, orients command intent, and executes actions.
//
// Setup: Takes capability tokens, manages session state, modular line editor, and command dispatch.
//
// Beats:
//   1. Initialize session state, persistent command history, and aliases.
//   2. Read and edit line input with ghost suggestions and multiline continuation under raw mode.
//   3. Dispatch commands and update telemetry flight recorder.

import "alias.oo";
import "prompt.oo";
import "dispatch.oo";
import "term/anchor.oo";
import "flight/anchor.oo";
import "ui/anchor.oo";
import "syntax/anchor.oo";

fn compute_ghost(fs_r: &FsReadCap, buf: String, cur: Int, rem: String, aliases: List[String], hist: HistoryState) -> String {
    if buf == "" && rem != "" { return "[Auto-Remedy: " + rem + " | Tab to accept]"; }
    if cur == chars_len(buf) && buf != "" {
        let hs: String = term_history_suggest(hist, buf);
        if hs != "" { return hs; }
        return term_complete_ghost(fs_r, buf, aliases);
    }
    return "";
}

pub fn run_engine(fs_r: &FsReadCap, sys: &ProcessCap, env: &EnvCap, time: &TimeCap, bind: &BindCap, fs_w: &FsWriteCap, ffi: &FfiCap, init_session: SessionState) -> Int {
    let mut session: SessionState = init_session;
    let mut rec: FlightRecord = flight_init();
    let is_interactive: Bool = match env_map_get(session.env_map, "OOSH_INTERACTIVE") { Ok(v) => v == "1", Err(_) => ui_is_interactive(sys) };
    let mut hist: HistoryState = history_load(fs_r, env);
    let mut running: Bool = true;
    let mut ed: LineEditor = line_editor_new();
    let mut multiline_prefix: String = "";

    if is_interactive { let _ = term_enable(ffi); }

    while running {
        let ps1_res: Result[String, String] = env_map_get(session.env_map, "PS1");
        let has_ps1: Bool = ps1_res.is_ok() && match ps1_res { Ok(s) => s != "", Err(_) => false };
        let base_prompt: String = if has_ps1 { match ps1_res { Ok(s) => s, Err(_) => "" } } else { render_prompt_state_fs(fs_r, env, session.cwd, rec.has_failed) };
        let ps2_res: Result[String, String] = env_map_get(session.env_map, "PS2");
        let ps2_prompt: String = match ps2_res { Ok(s) => if s != "" { s } else { "> " }, Err(_) => "> " };
        let mut active_prompt: String = if multiline_prefix != "" { ps2_prompt } else { base_prompt };
        let remedy_cand: String = if rec.has_failed && rec.last_exit_code != 0 {
            let diag: DiagnosticResult = flight_rules_match(rec.last_failed_cmd, rec.last_exit_code, rec.last_stderr, session.cwd);
            diag.actionable_cmd
        } else { "" };
        let mut cur_ghost: String = compute_ghost(fs_r, ed.buf, ed.cursor, remedy_cand, session.alias_map.names, hist);
        let show_dock: Bool = match env_map_get(session.env_map, "OOSH_DOCK") { Ok(v) => v == "1", Err(_) => match env_get(env, "OOSH_DOCK") { Ok(v) => v == "1", Err(_) => false } };
        if is_interactive {
            if !has_ps1 && show_dock && multiline_prefix == "" { print(render_ambient_dock(fs_r, env, session.cwd, rec.has_failed, rec.last_exit_code)); }
            line_editor_redraw_full(active_prompt, ed, cur_ghost);
        }

        let mut line_done: Bool = false;
        while !line_done && running {
            let key: KeyEvent = term_read_key(ffi);
            let action: String = key.action;

            if action == "eof" { running = false; line_done = true; break; }
            else if action == "enter" {
                let full_cand: String = multiline_prefix + ed.buf;
                if is_interactive && full_cand != "" && is_line_incomplete(full_cand) {
                    multiline_prefix = full_cand + "\n";
                    ed = line_editor_reset();
                    cur_ghost = "";
                    print("\r\n");
                    active_prompt = ps2_prompt;
                    line_editor_redraw_full(active_prompt, ed, cur_ghost);
                } else {
                    if is_interactive { print("\r\n"); }
                    line_done = true;
                }
            } else if is_interactive && action == "ctrl_c" {
                print("^C\r\n");
                multiline_prefix = "";
                ed = line_editor_reset();
                cur_ghost = "";
                hist = history_reset_cursor(hist);
                line_done = true;
            } else if is_interactive && action == "ctrl_d" {
                if ed.buf == "" && multiline_prefix == "" { running = false; break; }
            } else if is_interactive && action == "backspace" {
                ed = line_editor_backspace(ed);
                cur_ghost = compute_ghost(fs_r, ed.buf, ed.cursor, remedy_cand, session.alias_map.names, hist);
                line_editor_redraw_full(active_prompt, ed, cur_ghost);
            } else if is_interactive && action == "delete" {
                ed = line_editor_delete(ed);
                cur_ghost = compute_ghost(fs_r, ed.buf, ed.cursor, remedy_cand, session.alias_map.names, hist);
                line_editor_redraw_full(active_prompt, ed, cur_ghost);
            } else if is_interactive && action == "left" {
                ed = line_editor_move_left(ed);
                cur_ghost = "";
                line_editor_redraw_full(active_prompt, ed, cur_ghost);
            } else if is_interactive && (action == "right" || action == "ctrl_f") {
                if ed.buf == "" && remedy_cand != "" {
                    ed = line_editor_set(ed, remedy_cand); cur_ghost = "";
                } else if ed.cursor == chars_len(ed.buf) && cur_ghost != "" {
                    ed = line_editor_set(ed, ed.buf + cur_ghost); cur_ghost = "";
                } else if action == "right" {
                    ed = line_editor_move_right(ed);
                    cur_ghost = compute_ghost(fs_r, ed.buf, ed.cursor, remedy_cand, session.alias_map.names, hist);
                }
                line_editor_redraw_full(active_prompt, ed, cur_ghost);
            } else if is_interactive && action == "home" {
                ed = line_editor_home(ed); cur_ghost = "";
                line_editor_redraw_full(active_prompt, ed, cur_ghost);
            } else if is_interactive && action == "end" {
                ed = line_editor_end(ed);
                cur_ghost = compute_ghost(fs_r, ed.buf, ed.cursor, remedy_cand, session.alias_map.names, hist);
                line_editor_redraw_full(active_prompt, ed, cur_ghost);
            } else if is_interactive && action == "ctrl_u" {
                ed = line_editor_kill_to_start(ed); cur_ghost = "";
                line_editor_redraw_full(active_prompt, ed, cur_ghost);
            } else if is_interactive && action == "ctrl_k" {
                ed = line_editor_kill_to_end(ed); cur_ghost = "";
                line_editor_redraw_full(active_prompt, ed, cur_ghost);
            } else if is_interactive && action == "ctrl_w" {
                ed = line_editor_kill_word_backward(ed); cur_ghost = "";
                line_editor_redraw_full(active_prompt, ed, cur_ghost);
            } else if is_interactive && action == "ctrl_l" {
                print(ansi_esc() + "[2J" + ansi_esc() + "[H");
                line_editor_redraw_full(active_prompt, ed, cur_ghost);
            } else if is_interactive && action == "word_left" {
                ed = line_editor_word_left(ed); cur_ghost = "";
                line_editor_redraw_full(active_prompt, ed, cur_ghost);
            } else if is_interactive && action == "word_right" {
                ed = line_editor_word_right(ed); cur_ghost = "";
                line_editor_redraw_full(active_prompt, ed, cur_ghost);
            } else if is_interactive && action == "up" {
                let prev_r: Result[String, String] = history_prev(hist);
                if prev_r.is_ok() {
                    let prev_cmd: String = match prev_r { Ok(s) => s, Err(_) => "" };
                    hist = history_set_cursor(hist, hist.cursor_idx - 1);
                    ed = line_editor_set(ed, prev_cmd); cur_ghost = "";
                    line_editor_redraw_full(active_prompt, ed, cur_ghost);
                }
            } else if is_interactive && action == "down" {
                let next_r: Result[String, String] = history_next(hist);
                if next_r.is_ok() {
                    let next_cmd: String = match next_r { Ok(s) => s, Err(_) => "" };
                    hist = history_set_cursor(hist, hist.cursor_idx + 1);
                    ed = line_editor_set(ed, next_cmd);
                } else {
                    hist = history_reset_cursor(hist); ed = line_editor_reset();
                }
                cur_ghost = "";
                line_editor_redraw_full(active_prompt, ed, cur_ghost);
            } else if is_interactive && action == "tab" {
                if ed.buf == "" && remedy_cand != "" {
                    ed = line_editor_set(ed, remedy_cand); cur_ghost = "";
                    line_editor_redraw_full(active_prompt, ed, cur_ghost);
                } else if cur_ghost != "" {
                    ed = line_editor_set(ed, ed.buf + cur_ghost); cur_ghost = "";
                    line_editor_redraw_full(active_prompt, ed, cur_ghost);
                } else if ed.buf != "" {
                    let comp: String = term_complete(fs_r, ed.buf, session.alias_map.names);
                    ed = line_editor_set(ed, comp); cur_ghost = "";
                    line_editor_redraw_full(active_prompt, ed, cur_ghost);
                }
            } else if is_interactive && action == "ctrl_r" {
                let mut search_q: String = "";
                let mut match_idx: Int = list_len(hist.entries) - 1;
                let mut searching: Bool = true;
                let esc: String = bytes_to_str(bytes_push(bytes_new(), 27));
                while searching {
                    let mut found_str: String = "";
                    let mut fi: Int = match_idx;
                    while fi >= 0 {
                        let e: String = list_get(hist.entries, fi);
                        if search_q == "" || str_contains(e, search_q) { found_str = e; match_idx = fi; fi = -1; } else { fi = fi - 1; }
                    }
                    print("\r(reverse-i-search)`" + search_q + "': " + found_str + esc + "[K");
                    let sk: KeyEvent = term_read(ffi);
                    if sk.action == "ctrl_r" { if match_idx > 0 { match_idx = match_idx - 1; } }
                    else if sk.action == "char" { search_q = search_q + sk.text; match_idx = list_len(hist.entries) - 1; }
                    else if sk.action == "backspace" {
                        let slen: Int = chars_len(search_q);
                        if slen > 0 { search_q = str_slice(search_q, 0, slen - 1); }
                        match_idx = list_len(hist.entries) - 1;
                    } else if sk.action == "enter" {
                        if found_str != "" { ed = line_editor_set(ed, found_str); }
                        searching = false;
                    } else { searching = false; }
                }
                cur_ghost = "";
                line_editor_redraw_full(active_prompt, ed, cur_ghost);
            } else if action == "char" {
                if is_interactive {
                    ed = line_editor_insert(ed, key.text);
                    cur_ghost = compute_ghost(fs_r, ed.buf, ed.cursor, remedy_cand, session.alias_map.names, hist);
                    line_editor_redraw_full(active_prompt, ed, cur_ghost);
                } else {
                    ed = LineEditor { buf: ed.buf + key.text, cursor: ed.cursor + chars_len(key.text) };
                }
            }
        }

        if !running && ed.buf == "" && multiline_prefix == "" { break; }

        let line_to_run: String = str_trim(multiline_prefix + ed.buf);
        multiline_prefix = "";
        ed = line_editor_reset();
        hist = history_reset_cursor(hist);

        if line_to_run != "" {
            if is_interactive {
                hist = history_add(fs_w, hist, line_to_run);
                let _ = term_disable(ffi);
            }
            let t0: Int = now_ms(time);
            let res: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, line_to_run, rec, session);
            session = res.session;
            let dur: Int = now_ms(time) - t0;
            let mem: String = flight_memory(fs_r); let pid: Int = flight_pid(fs_r);
            rec = flight_update_telemetry(res.flight_rec, dur, mem, pid);
            let show_telem: Bool = match env_map_get(session.env_map, "OOSH_TELEMETRY") { Ok(v) => v == "1", Err(_) => match env_get(env, "OOSH_TELEMETRY") { Ok(v) => v == "1", Err(_) => false } };
            if is_interactive && show_telem { println(flight_telemetry_full(dur, res.flight_rec.last_exit_code, mem, pid)); }
            if is_interactive && !res.should_exit { let _ = term_enable(ffi); }
            if res.should_exit { running = false; break; }
        }
    }

    if is_interactive { let _ = term_disable(ffi); }
    return rec.last_exit_code;
}
