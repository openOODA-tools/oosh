// # Terminal Tab Completion Engine
//
// Logline: Generates multi-match path and builtin completions for interactive line editing.
//
// Setup: Inspects ambient filesystem directories, session alias table, and builtin runes.
//
// Beats:
//   1. Resolve command names against builtins, aliases, and system binaries.
//   2. Query filesystem directory entries matching user prefix tokens.
//   3. Calculate longest common prefix across candidates or display multi-matches.

pub fn complete_token(fs_r: &FsReadCap, cur_line: String, alias_names: List[String]) -> String {
    let n: Int = chars_len(cur_line);
    let mut last_sp: Int = -1;
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(cur_line, i);
        if ch == " " || ch == "\t" { last_sp = i; }
        i = i + 1;
    }
    if last_sp < 0 {
        let builtins: String = "help:version:status:caps:whereami:history:clear:remedy:autopsy:export:unset:alias:unalias:take:pwd:cd:exit:echo:scry";
        let bn: Int = chars_len(builtins);
        let mut cur: String = "";
        let mut bi: Int = 0;
        while bi < bn {
            let ch: String = char_at(builtins, bi);
            if ch == ":" {
                if str_starts_with(cur, cur_line) { return cur; }
                cur = "";
            } else { cur = cur + ch; }
            bi = bi + 1;
        }
        if cur != "" && str_starts_with(cur, cur_line) { return cur; }
        let an: Int = list_len(alias_names);
        let mut ai: Int = 0;
        while ai < an {
            let aname: String = list_get(alias_names, ai);
            if str_starts_with(aname, cur_line) { return aname; }
            ai = ai + 1;
        }
        let bin_entries: List[String] = oo_fs_read_dir(fs_r, "/usr/bin");
        let ben: Int = list_len(bin_entries);
        let mut bei: Int = 0;
        while bei < ben {
            let bname: String = list_get(bin_entries, bei);
            if str_starts_with(bname, cur_line) { return bname; }
            bei = bei + 1;
        }
        return cur_line;
    }
    let prefix_tok: String = str_slice(cur_line, last_sp + 1, n);
    let prefix_head: String = str_slice(cur_line, 0, last_sp + 1);
    let mut sl_idx: Int = -1;
    let mut si: Int = 0;
    let plen: Int = chars_len(prefix_tok);
    while si < plen {
        if char_at(prefix_tok, si) == "/" { sl_idx = si; }
        si = si + 1;
    }
    let dir_path: String = if sl_idx >= 0 { str_slice(prefix_tok, 0, sl_idx) } else { "." };
    let file_prefix: String = if sl_idx >= 0 { str_slice(prefix_tok, sl_idx + 1, plen) } else { prefix_tok };
    let entries: List[String] = oo_fs_read_dir(fs_r, dir_path);
    let elen: Int = list_len(entries);
    let mut matches: List[String] = list_new();
    let mut ei: Int = 0;
    while ei < elen {
        let ent: String = list_get(entries, ei);
        if str_starts_with(ent, file_prefix) && (!str_starts_with(ent, ".") || str_starts_with(file_prefix, ".")) {
            matches = list_push(matches, ent);
        }
        ei = ei + 1;
    }
    let mlen: Int = list_len(matches);
    if mlen == 0 { return cur_line; }
    if mlen == 1 {
        let match_path: String = if sl_idx >= 0 { dir_path + "/" + list_get(matches, 0) } else { list_get(matches, 0) };
        return prefix_head + match_path;
    }
    let first_m: String = list_get(matches, 0);
    let mut cp_len: Int = chars_len(first_m);
    let mut mi: Int = 1;
    while mi < mlen {
        let cand: String = list_get(matches, mi);
        let cand_len: Int = chars_len(cand);
        if cand_len < cp_len { cp_len = cand_len; }
        let mut ci: Int = 0;
        while ci < cp_len {
            if char_at(first_m, ci) != char_at(cand, ci) {
                cp_len = ci;
            } else {
                ci = ci + 1;
            }
        }
        mi = mi + 1;
    }
    let common: String = str_slice(first_m, 0, cp_len);
    if chars_len(common) > chars_len(file_prefix) {
        let match_path: String = if sl_idx >= 0 { dir_path + "/" + common } else { common };
        return prefix_head + match_path;
    }
    print("\r\n");
    let mut pi: Int = 0;
    while pi < mlen {
        print(list_get(matches, pi) + "  ");
        pi = pi + 1;
    }
    print("\r\n");
    return cur_line;
}
