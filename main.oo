// # oosh Main - Argv Router and Interactive Shell Entry
//
// Logline: Parse startup flags, validate environment, and launch sovereign shell, script, or Varlink daemon.
//
// Setup: Wire capability tokens per openOODA capability model. Handle flags, scripts, .ooshrc, and REPL.
//
// Beats:
//   1. Pre-pass --help, --version, and flags without side effects.
//   2. Support positional .oosh script execution and shebang #!/usr/bin/env oosh with args.
//   3. Source ~/.ooshrc configuration into session environment and alias table.
//   4. Initialize prompt and dispatch to the OODA REPL engine with FfiCap.

import "std/fs/process/env.oo";
import "alias.oo";
import "version.oo";
import "engine.oo";
import "dispatch.oo";
import "flight/anchor.oo";
import "ipc/anchor.oo";
import "ui/anchor.oo";

fn print_help() {
    println("oosh — openOODA sovereign shell");
    println("usage: oosh [flags] [script.oosh] [args...] [-c <command>]");
    println("");
    println("flags:");
    println("  -c <command>           execute specified command and exit");
    println("  -h, --help             display this help message");
    println("  -v, --version          display oosh version");
    println("      --no-banner        suppress startup banner");
    println("      --daemon           launch headless Varlink IPC control daemon");
    println("      --varlink          launch headless Varlink IPC control daemon");
    println("      --varlink-daemon   launch headless Varlink IPC control daemon");
    println("      --varlink-call <s> execute single-shot Varlink IPC JSON call");
}

fn validate_argv(args: List[String]) -> Result[String, String] {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        if a == "--help" || a == "-h" {
            print_help();
            return Ok("showed-help");
        }
        if a == "--version" || a == "-v" {
            println("oosh " + oosh_version());
            return Ok("showed-version");
        }
        if a == "--no-banner" || a == "--daemon" || a == "--varlink" || a == "--varlink-daemon" {
            i = i + 1;
        } else if a == "-c" {
            if i + 1 >= n {
                println("ERR\toosh\t-c requires a command string");
                process_exit(2);
                return Err("missing -c arg");
            }
            i = i + 2;
        } else if a == "--varlink-call" {
            if i + 1 >= n {
                println("ERR\toosh\t--varlink-call requires a JSON string");
                process_exit(2);
                return Err("missing --varlink-call arg");
            }
            i = i + 2;
        } else if !str_starts_with(a, "-") {
            i = i + 1;
        } else {
            println("ERR\toosh\tunknown flag: " + a);
            process_exit(2);
            return Err("unknown flag");
        }
    }
    return Ok("validated");
}

fn run_script_file(fs_r: &FsReadCap, fs_w: &FsWriteCap, sys: &ProcessCap, env: &EnvCap, ffi: &FfiCap, script_path: String, script_args: List[String], rec: FlightRecord, session: SessionState) -> Int {
    let sr: Result[String, String] = read_file(fs_r, script_path);
    if sr.is_err() {
        println("ERR\toosh\tcannot read script: " + script_path);
        return 1;
    }
    let content: String = match sr { Ok(s) => s, Err(_) => "" };
    let num_args: Int = list_len(script_args);
    let mut em: EnvMap = session.env_map;
    em = env_map_set(em, "0", script_path);
    em = env_map_set(em, "#", num_args.to_string());
    let mut all_args_str: String = "";
    let mut ai: Int = 0;
    while ai < num_args {
        let arg_val: String = list_get(script_args, ai);
        em = env_map_set(em, (ai + 1).to_string(), arg_val);
        all_args_str = if all_args_str == "" { arg_val } else { all_args_str + " " + arg_val };
        ai = ai + 1;
    }
    em = env_map_set(em, "@", all_args_str);
    em = env_map_set(em, "*", all_args_str);
    let cur_sess: SessionState = SessionState { cwd: session.cwd, env_map: em, alias_map: session.alias_map, job_table: session.job_table, func_map: session.func_map };
    let res: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, content, rec, cur_sess);
    return res.exit_code;
}

pub fn main(bind: &BindCap, fs_r: &FsReadCap, sys: &ProcessCap, sys_cap: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, thread: &ThreadCap, ffi: &FfiCap, args: List[String]) -> Result[Int, String] {
    let _h = dlopen(ffi, "");
    let pre: Result[String, String] = validate_argv(args);
    let kind: String = match pre { Ok(s) => s, Err(_) => "validated" };
    if kind == "showed-help" || kind == "showed-version" {
        return Ok(0);
    }

    let n: Int = list_len(args);
    let mut one_shot_cmd: String = "";
    let mut has_c_flag: Bool = false;
    let mut is_daemon: Bool = false;
    let mut varlink_payload: String = "";
    let mut script_file: String = "";
    let mut script_args: List[String] = list_new();

    let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        if a == "--no-banner" {
            i = i + 1;
        } else if a == "--daemon" || a == "--varlink" || a == "--varlink-daemon" {
            is_daemon = true;
            i = i + 1;
        } else if a == "-c" {
            has_c_flag = true;
            one_shot_cmd = list_get(args, i + 1);
            i = i + 2;
        } else if a == "--varlink-call" {
            varlink_payload = list_get(args, i + 1);
            i = i + 2;
        } else if !str_starts_with(a, "-") {
            if script_file == "" {
                script_file = a;
            } else {
                script_args = list_push(script_args, a);
            }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }

    let pr: Result[String, String] = env_get(env, "PWD");
    let cwd: String = match pr { Ok(s) => s, Err(_) => "." };
    let rec: FlightRecord = flight_init();
    let mut session: SessionState = session_state_new(cwd, alias_map_new());

    if varlink_payload != "" {
        let reply: String = ipc_route(sys, cwd, rec, varlink_payload);
        print(reply);
        return Ok(0);
    }

    if is_daemon {
        let d_rc: Int = ipc_run_daemon(sys, env, ffi, cwd, rec);
        return Ok(d_rc);
    }

    if has_c_flag {
        if str_trim(one_shot_cmd) == "" { return Ok(0); }
        let res: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, one_shot_cmd, rec, session);
        if res.exit_code != 0 { process_exit(res.exit_code); }
        return Ok(res.exit_code);
    }

    // Source ~/.ooshrc configuration into session environment and alias table
    let hr: Result[String, String] = env_get(env, "HOME");
    let home: String = match hr { Ok(h) => h, Err(_) => "" };
    if home != "" {
        let ooshrc_path: String = home + "/.ooshrc";
        let ooshrc_read: Result[String, String] = read_file(fs_r, ooshrc_path);
        if ooshrc_read.is_ok() {
            let rc_content: String = match ooshrc_read { Ok(s) => s, Err(_) => "" };
            let rc_res: DispatchResult = dispatch_line(fs_r, fs_w, sys, env, ffi, rc_content, rec, session);
            session = rc_res.session;
        }
    }

    if script_file != "" {
        let s_rc: Int = run_script_file(fs_r, fs_w, sys, env, ffi, script_file, script_args, rec, session);
        if s_rc != 0 { process_exit(s_rc); }
        return Ok(s_rc);
    }

    let rc: Int = run_engine(fs_r, sys, env, time, bind, fs_w, ffi, session);
    if rc != 0 { process_exit(rc); }
    return Ok(rc);
}
