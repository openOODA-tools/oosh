// # Failure Diagnostic Rules Engine
//
// Logline: Rule-based pattern matcher for session failure envelopes and recovery command synthesis.
//
// Setup: Pure string matching and heuristic classification. No ambient authority required.
//
// Beats:
//   1. Define structured DiagnosticResult and FailureEnvelope types.
//   2. Match failure patterns against exit codes, command signatures, and captured output streams.
//   3. Synthesize context-aware proposed remediation commands and alternatives.

import "envelope.oo";

pub type FailureEnvelope = struct {
    has_failed: Bool,
    cmd: String,
    exit_code: Int,
    output: String,
    cwd: String,
    duration_ms: Int
};

pub type DiagnosticResult = struct {
    category: String,
    summary: String,
    actionable_cmd: String,
    secondary_cmd: String,
    explanation: String
};

pub fn make_diagnostic(cat: String, sum: String, act: String, sec: String, exp: String) -> DiagnosticResult {
    return DiagnosticResult { category: cat, summary: sum, actionable_cmd: act, secondary_cmd: sec, explanation: exp };
}

pub fn flight_envelope_empty() -> FailureEnvelope {
    return FailureEnvelope {
        has_failed: false,
        cmd: "",
        exit_code: 0,
        output: "",
        cwd: "",
        duration_ms: 0
    };
}

pub fn flight_to_envelope(rec: FlightRecord, cwd: String) -> FailureEnvelope {
    return FailureEnvelope {
        has_failed: rec.has_failed,
        cmd: rec.last_failed_cmd,
        exit_code: rec.last_exit_code,
        output: rec.last_stderr,
        cwd: cwd,
        duration_ms: rec.last_duration_ms
    };
}

fn safe_str_prefix(s: String, max_chars: Int) -> String {
    if chars_len(s) <= max_chars { return s; }
    return str_slice(s, 0, max_chars);
}

fn extract_binary(cmd: String) -> String {
    let trimmed: String = str_trim(cmd);
    let n: Int = chars_len(trimmed);
    let mut i: Int = 0;
    while i < n && char_at(trimmed, i) != " " && char_at(trimmed, i) != "\t" {
        i = i + 1;
    }
    return str_slice(trimmed, 0, i);
}

fn extract_first_arg(cmd: String) -> String {
    let trimmed: String = str_trim(cmd);
    let n: Int = chars_len(trimmed);
    let mut i: Int = 0;
    while i < n && char_at(trimmed, i) != " " && char_at(trimmed, i) != "\t" { i = i + 1; }
    while i < n && (char_at(trimmed, i) == " " || char_at(trimmed, i) == "\t") { i = i + 1; }
    if i >= n { return ""; }
    let start: Int = i;
    while i < n && char_at(trimmed, i) != " " && char_at(trimmed, i) != "\t" { i = i + 1; }
    return str_slice(trimmed, start, i);
}

fn extract_target_arg(cmd: String) -> String {
    let trimmed: String = str_trim(cmd);
    let n: Int = chars_len(trimmed);
    let mut i: Int = 0;
    while i < n && char_at(trimmed, i) != " " && char_at(trimmed, i) != "\t" { i = i + 1; }
    let mut last_non_flag: String = "";
    while i < n {
        while i < n && (char_at(trimmed, i) == " " || char_at(trimmed, i) == "\t") { i = i + 1; }
        if i < n {
            let start: Int = i;
            while i < n && char_at(trimmed, i) != " " && char_at(trimmed, i) != "\t" { i = i + 1; }
            let word: String = str_slice(trimmed, start, i);
            if !str_starts_with(word, "-") {
                last_non_flag = word;
            }
        }
    }
    if last_non_flag != "" { return last_non_flag; }
    return extract_first_arg(cmd);
}

fn is_nav_builtin(bin: String) -> Bool {
    return bin == "cd" || bin == "goto" || bin == "jump" || bin == "take" || bin == "chdir" || bin == "walk" || bin == "mkcd" || bin == "mcd" || bin == "mdcd";
}

fn match_command_not_found(bin: String, cmd: String) -> DiagnosticResult {
    let rest: String = if chars_len(cmd) > chars_len(bin) { str_slice(cmd, chars_len(bin), chars_len(cmd)) } else { "" };
    if is_nav_builtin(bin) {
        let arg: String = extract_target_arg(cmd);
        let target: String = if arg != "" { arg } else { "<dir>" };
        return make_diagnostic("MISSING_PATH", "Target directory does not exist: '" + target + "'.", "take " + target, "ls -la", "Directory missing; 'take' will atomically mkdir -p and cd into it.");
    }
    if bin == "sl" { return make_diagnostic("COMMAND_NOT_FOUND", "Command 'sl' not found; likely typo for 'ls'.", "ls" + rest, "which ls", "Replaced misspelled binary 'sl' with coreutil 'ls'."); }
    if bin == "gti" { return make_diagnostic("COMMAND_NOT_FOUND", "Command 'gti' not found; likely typo for 'git'.", "git" + rest, "which git", "Replaced misspelled binary 'gti' with 'git'."); }
    if bin == "dc" { return make_diagnostic("COMMAND_NOT_FOUND", "Command 'dc' not found; likely typo for 'cd'.", "cd" + rest, "pwd", "Replaced misspelled binary 'dc' with navigation builtin 'cd'."); }
    if bin == "claer" { return make_diagnostic("COMMAND_NOT_FOUND", "Command 'claer' not found; likely typo for 'clear'.", "clear", "help clear", "Replaced misspelled binary 'claer' with terminal 'clear'."); }
    if bin == "python" { return make_diagnostic("COMMAND_NOT_FOUND", "Legacy 'python' binary not found in PATH.", "python3" + rest, "sudo apt install -y python3-is-python3 || sudo apt install -y python3", "Modern Linux distros expose 'python3' rather than unversioned 'python'."); }
    if bin == "pip" { return make_diagnostic("COMMAND_NOT_FOUND", "Python package installer 'pip' not found.", "pip3" + rest, "sudo apt install -y python3-pip", "Package manager is packaged as 'pip3' on host system."); }
    if bin == "cargo" || bin == "rustc" { return make_diagnostic("COMMAND_NOT_FOUND", "Rust toolchain binary '" + bin + "' not found.", "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh", "export PATH=\"$HOME/.cargo/bin:$PATH\"", "Install Rust toolchain via rustup or verify PATH includes ~/.cargo/bin."); }
    if bin == "oodac" { return make_diagnostic("COMMAND_NOT_FOUND", "openOODA compiler 'oodac' not found in PATH.", "export PATH=\"$HOME/.openooda/bin:$PATH\"", "ls -la ~/.openooda/bin/oodac", "The openOODA toolchain binaries are located in ~/.openooda/bin."); }
    if bin == "node" || bin == "npm" || bin == "npx" { return make_diagnostic("COMMAND_NOT_FOUND", "Node.js runtime '" + bin + "' not found.", "sudo apt install -y nodejs npm", "curl -fsSL https://deb.nodesource.com/setup_lts.x | sudo -E bash -", "Install Node.js runtime and npm package manager from host repositories."); }
    if bin == "docker" || bin == "docker-compose" { return make_diagnostic("COMMAND_NOT_FOUND", "Container engine '" + bin + "' not found in PATH.", "sudo apt install -y podman-docker || sudo apt install -y docker.io", "podman " + if chars_len(cmd) > chars_len(bin) { str_slice(cmd, chars_len(bin) + 1, chars_len(cmd)) } else { "" }, "Install Docker or use native Podman rootless container engine."); }
    if str_starts_with(bin, "./") { return make_diagnostic("COMMAND_NOT_FOUND", "Local script '" + bin + "' not found or lacks execute bit.", "ls -la " + bin, "chmod +x " + bin, "Ensure local file exists in active directory and has execute permissions (+x)."); }
    return make_diagnostic("COMMAND_NOT_FOUND", "Executable binary '" + bin + "' not found in active PATH.", "which " + bin + " || sudo apt install -y " + bin, "cargo install " + bin + " 2>/dev/null || help", "Check command spelling, install via host package manager, or search builtins with 'help'.");
}

fn match_permission_denied(bin: String, cmd: String, err_str: String) -> DiagnosticResult {
    if str_starts_with(bin, "./") || str_contains(bin, "/") {
        return make_diagnostic("PERMISSION_DENIED", "Script or binary '" + bin + "' lacks executable permissions.", "chmod +x " + bin + " && " + cmd, "ls -la " + bin, "Add the execute mode bit (+x) to allow host kernel process execution.");
    }
    if bin == "systemctl" || bin == "apt" || bin == "dnf" || bin == "pacman" || bin == "mount" || str_contains(cmd, "/etc/") || str_contains(cmd, "/var/") {
        return make_diagnostic("PERMISSION_DENIED", "Command requires root or administrative system authority.", "sudo " + cmd, "caps", "System modification operations require elevated privileges via sudo.");
    }
    return make_diagnostic("PERMISSION_DENIED", "Execution privilege denied by operating system.", "sudo " + cmd, "chmod +x " + bin, "Process denied access; retry with elevated privileges or inspect file permissions.");
}

fn match_git_failure(cmd: String, err_str: String) -> DiagnosticResult {
    if str_contains(err_str, "CONFLICT") || str_contains(err_str, "Merge conflict") || str_contains(err_str, "Automatic merge failed") || str_contains(err_str, "resolve your current index") {
        return make_diagnostic("GIT_CONFLICT", "Merge conflict detected in active working tree.", "git diff --check || git status", "git merge --abort", "Conflicting edits require manual conflict resolution or merge abort.");
    }
    if str_contains(err_str, "overwritten by merge") || str_contains(err_str, "overwritten by checkout") {
        return make_diagnostic("GIT_CONFLICT", "Uncommitted local changes prevent branch checkout or merge.", "git stash && " + cmd + " && git stash pop", "git status -s", "Working directory is dirty. Stash uncommitted changes before branch switching.");
    }
    if str_contains(err_str, "not a git repository") {
        return make_diagnostic("GIT_CONFLICT", "Active directory is not inside a git repository.", "git init", "cd .. && git status", "No .git root found in active hierarchy. Initialize a new repository or cd to root.");
    }
    if str_contains(err_str, "pathspec") || str_contains(err_str, "did not match any file") {
        return make_diagnostic("GIT_CONFLICT", "Git pathspec or branch reference does not exist.", "git branch -a", "git status -s", "Specified branch or file pattern is not tracked in git index.");
    }
    return make_diagnostic("GIT_CONFLICT", "Git operation halted with error: " + safe_str_prefix(err_str, 40), "git status", "git log -n 5 --oneline", "Inspect git status or commit history to resolve repository state.");
}

fn is_directory_operation(bin: String, err_str: String) -> Bool {
    if is_nav_builtin(bin) || bin == "rmdir" || bin == "mkdir" {
        return true;
    }
    if str_contains(err_str, "directory not found") || str_contains(err_str, "failed to create directory") || str_contains(err_str, "cannot create directory") || str_contains(err_str, "Not a directory") || str_contains(err_str, "No such directory") {
        return true;
    }
    if str_contains(err_str, "directory") && !str_contains(err_str, "No such file") {
        return true;
    }
    return false;
}

fn match_missing_path(bin: String, arg: String, cmd: String, err_str: String) -> DiagnosticResult {
    if is_directory_operation(bin, err_str) {
        let target: String = if arg != "" { arg } else { "<dir>" };
        return make_diagnostic("MISSING_PATH", "Target directory does not exist: '" + target + "'.", "take " + target, "ls -la", "Directory missing; 'take' will atomically mkdir -p and cd into it.");
    }
    let target: String = if arg != "" { arg } else { "<file>" };
    return make_diagnostic("MISSING_PATH", "Target file or path does not exist: '" + target + "'.", "touch " + target + " && " + cmd, "find . -name \"" + target + "\" 2>/dev/null", "Path is missing from active workspace. Create file or locate it via find.");
}

fn match_build_failure(bin: String, arg: String, cmd: String, err_str: String) -> DiagnosticResult {
    if bin == "cargo" || str_contains(cmd, "cargo ") || str_contains(err_str, "could not compile") || str_contains(err_str, "error[E") {
        return make_diagnostic("BUILD_FAILURE", "Rust compilation error detected in Cargo build pipeline.", "cargo check --verbose", "cargo clean && cargo build", "Cargo build failed; run 'cargo check' to inspect detailed type and syntax diagnostics.");
    }
    if bin == "make" || str_contains(cmd, "make ") || str_contains(err_str, "make: ***") || str_contains(err_str, "Error 1") {
        return make_diagnostic("BUILD_FAILURE", "Makefile recipe target execution failed.", "make clean && make", "make -n", "Makefile target halted on non-zero exit; clean build cache or run dry-run (-n).");
    }
    if bin == "oodac" || str_contains(cmd, "oodac ") || str_contains(err_str, "oodac check") || str_contains(err_str, "syntax error") {
        let target_file: String = if arg != "" { arg } else { "main.oo" };
        return make_diagnostic("BUILD_FAILURE", "openOODA compiler check rejected source code.", "make verify && make check", "oodac check " + target_file, "Source file violates openOODA language syntax, types, or House Laws line rules.");
    }
    return make_diagnostic("BUILD_FAILURE", "Project build process terminated with compilation error.", cmd + " --verbose", "make clean 2>/dev/null", "Build tool exited non-zero; re-run with verbose diagnostics or clean build artifacts.");
}

pub fn match_failure_rules(cmd: String, exit_code: Int, stderr_out: String, cwd: String) -> DiagnosticResult {
    let bin: String = extract_binary(cmd);
    let arg: String = extract_target_arg(cmd);
    let err_str: String = stderr_out;

    if is_nav_builtin(bin) || bin == "rmdir" || bin == "mkdir" || str_contains(err_str, "directory not found") || str_contains(err_str, "failed to create directory") {
        return match_missing_path(bin, arg, cmd, err_str);
    }
    if !is_nav_builtin(bin) && (exit_code == 127 || str_contains(err_str, "command not found") || (str_contains(err_str, "not found") && !str_contains(err_str, "No such file") && !str_contains(err_str, "directory"))) {
        return match_command_not_found(bin, cmd);
    }
    if exit_code == 126 || str_contains(err_str, "Permission denied") || str_contains(err_str, "Operation not permitted") {
        return match_permission_denied(bin, cmd, err_str);
    }
    if str_starts_with(cmd, "git ") || str_contains(err_str, "CONFLICT") || str_contains(err_str, "Merge conflict") || str_contains(err_str, "Automatic merge failed") || str_contains(err_str, "overwritten by merge") || str_contains(err_str, "not a git repository") {
        return match_git_failure(cmd, err_str);
    }
    if str_contains(err_str, "Connection refused") || str_contains(err_str, "connect") || (str_contains(cmd, "sock") && str_contains(err_str, "No such file")) {
        return make_diagnostic("IPC_FAILURE", "Varlink IPC control socket is inactive or unreachable.", "oosh --daemon &", "ls -la /run/oosh/control.sock /tmp/oosh-control.sock", "No active listener on socket; launch daemon in background or check permissions.");
    }
    if bin == "cat" || bin == "head" || bin == "tail" || str_contains(err_str, "No such file or directory") || str_contains(err_str, "cannot access") || str_contains(err_str, "Not a directory") || str_contains(err_str, "No such directory") {
        return match_missing_path(bin, arg, cmd, err_str);
    }
    if bin == "cargo" || bin == "make" || bin == "oodac" || str_contains(cmd, "cargo ") || str_contains(cmd, "make ") || str_contains(cmd, "oodac ") || str_contains(err_str, "could not compile") || str_contains(err_str, "make: ***") {
        return match_build_failure(bin, arg, cmd, err_str);
    }
    let code_str: String = exit_code.to_string();
    return make_diagnostic("GENERIC_FAULT", "Command exited with non-zero status code: " + code_str, "time " + cmd, "autopsy", "Unhandled execution fault; run with 'time' for latency metrics or inspect 'autopsy'.");
}
