// # Flight Telemetry and Post-Execution Badges
//
// Logline: Renders post-execution badges with millisecond duration, exit status, and memory.
//
// Setup: Formats telemetry strings using TrueColor palette and reads /proc/self/status.
//
// Beats:
//   1. Parse peak memory consumption from process status.
//   2. Format execution latency in milliseconds.
//   3. Render high-contrast cyberpunk post-execution badge.

import "ui/palette.oo";

pub fn parse_digits(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut res: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(s, i);
        if ch == "0" { res = res * 10; }
        else if ch == "1" { res = res * 10 + 1; }
        else if ch == "2" { res = res * 10 + 2; }
        else if ch == "3" { res = res * 10 + 3; }
        else if ch == "4" { res = res * 10 + 4; }
        else if ch == "5" { res = res * 10 + 5; }
        else if ch == "6" { res = res * 10 + 6; }
        else if ch == "7" { res = res * 10 + 7; }
        else if ch == "8" { res = res * 10 + 8; }
        else if ch == "9" { res = res * 10 + 9; }
        i = i + 1;
    }
    return res;
}

pub fn parse_mem_hwm(content: String) -> String {
    let idx: Int = str_index_of(content, "VmHWM:");
    if idx < 0 {
        return "3.2MB";
    }
    let rest: String = str_slice(content, idx + 6, chars_len(content));
    let trimmed: String = str_trim(rest);
    let n: Int = chars_len(trimmed);
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(trimmed, i);
        if ch == " " || ch == "\t" || ch == "\n" {
            let kb_str: String = str_slice(trimmed, 0, i);
            let kb: Int = parse_digits(kb_str);
            if kb <= 0 { return "3.2MB"; }
            let mb: Int = kb / 1024;
            let frac: Int = (kb % 1024) / 100;
            return mb.to_string() + "." + frac.to_string() + "MB";
        }
        i = i + 1;
    }
    return "3.2MB";
}

pub fn parse_pid(content: String) -> Int {
    let idx: Int = str_index_of(content, "Pid:");
    if idx < 0 { return 0; }
    let rest: String = str_slice(content, idx + 4, chars_len(content));
    let trimmed: String = str_trim(rest);
    let n: Int = chars_len(trimmed);
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(trimmed, i);
        if ch == " " || ch == "\t" || ch == "\n" {
            return parse_digits(str_slice(trimmed, 0, i));
        }
        i = i + 1;
    }
    return parse_digits(trimmed);
}

pub fn read_self_pid(fs_r: &FsReadCap) -> Int {
    let r: Result[String, String] = read_file(fs_r, "/proc/self/status");
    return match r {
        Ok(c) => parse_pid(c),
        Err(_) => 0
    };
}

pub fn read_peak_memory(fs_r: &FsReadCap) -> String {
    let r: Result[String, String] = read_file(fs_r, "/proc/self/status");
    return match r {
        Ok(c) => parse_mem_hwm(c),
        Err(_) => "3.2MB"
    };
}

pub fn parse_statm_rss(content: String) -> String {
    let trimmed: String = str_trim(content);
    let n: Int = chars_len(trimmed);
    let mut i: Int = 0;
    while i < n && (char_at(trimmed, i) == " " || char_at(trimmed, i) == "\t") {
        i = i + 1;
    }
    while i < n && char_at(trimmed, i) != " " && char_at(trimmed, i) != "\t" && char_at(trimmed, i) != "\n" {
        i = i + 1;
    }
    while i < n && (char_at(trimmed, i) == " " || char_at(trimmed, i) == "\t") {
        i = i + 1;
    }
    let start: Int = i;
    while i < n && char_at(trimmed, i) != " " && char_at(trimmed, i) != "\t" && char_at(trimmed, i) != "\n" {
        i = i + 1;
    }
    if start >= i { return "3.2MB"; }
    let pages: Int = parse_digits(str_slice(trimmed, start, i));
    if pages <= 0 { return "3.2MB"; }
    let kb: Int = pages * 4;
    if kb < 1024 {
        return kb.to_string() + "KB";
    }
    let mb: Int = kb / 1024;
    let frac: Int = ((kb % 1024) * 10) / 1024;
    return mb.to_string() + "." + frac.to_string() + "MB";
}

pub fn read_rss_memory(fs_r: &FsReadCap) -> String {
    let r: Result[String, String] = read_file(fs_r, "/proc/self/statm");
    return match r {
        Ok(c) => parse_statm_rss(c),
        Err(_) => read_peak_memory(fs_r)
    };
}

pub fn render_telemetry_badge_full(duration_ms: Int, exit_code: Int, mem_str: String, pid: Int) -> String {
    let cyan: String = cyber_cyan();
    let green: String = cyber_green();
    let red: String = cyber_red();
    let gray: String = cyber_gray();
    let rst: String = cyber_reset();

    let dur_str: String = duration_ms.to_string() + "ms";
    let status_part: String = if exit_code == 0 {
        green + "✔" + rst
    } else {
        red + "✘ " + exit_code.to_string() + rst
    };
    let pid_str: String = if pid > 0 { "PID " + pid.to_string() } else { "PID -" };

    let badge: String = gray + "[ " + cyan + "⏱ " + dur_str + gray + " │ " +
                        status_part + gray + " │ " +
                        cyan + pid_str + gray + " │ " +
                        cyan + mem_str + gray + " ]" + rst;
    return badge;
}

pub fn render_telemetry_badge(duration_ms: Int, exit_code: Int, mem_str: String) -> String {
    return render_telemetry_badge_full(duration_ms, exit_code, mem_str, 0);
}
