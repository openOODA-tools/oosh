// # oosh Main - Argv Router and Interactive Shell Entry
//
// Logline: Parse startup flags, validate environment, and launch sovereign shell or Varlink daemon.
//
// Setup: Wire capability tokens per openOODA capability model. Handle --help, --version, -c, --daemon.
//
// Beats:
//   1. Pre-pass --help and --version without side effects.
//   2. Validate startup flags; support one-shot -c command execution.
//   3. Handle headless Varlink IPC daemon mode when requested.
//   4. Initialize prompt and dispatch to the OODA REPL engine.

import "std/fs/process/env.oo";
import "version.oo";
import "engine.oo";
import "dispatch.oo";
import "flight/anchor.oo";
import "ipc/anchor.oo";

fn print_help() {
    println("oosh — openOODA sovereign shell");
    println("usage: oosh [flags] [-c <command>]");
    println("");
    println("flags:");
    println("  -c <command>           execute specified command and exit");
    println("  -h, --help             display this help message");
    println("  -v, --version          display oosh version");
    println("      --no-banner        suppress startup banner");
    println("      --daemon           launch headless Varlink IPC control daemon");
    println("      --varlink          launch headless Varlink IPC control daemon");
    println("      --varlink-call <s> execute single-shot Varlink IPC JSON call");
}

fn validate_argv(args: List[String]) -> Result[String, String] {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        if a == "--help" || a == "-h" {
            print_help();
            return Ok("showed-help");
        }
        if a == "--version" || a == "-v" {
            println("oosh " + oosh_version());
            return Ok("showed-version");
        }
        if a == "--no-banner" || a == "--daemon" || a == "--varlink" {
            i = i + 1;
        } else if a == "-c" {
            if i + 1 >= n {
                println("ERR\toosh\t-c requires a command string");
                process_exit(2);
                return Err("missing -c arg");
            }
            i = i + 2;
        } else if a == "--varlink-call" {
            if i + 1 >= n {
                println("ERR\toosh\t--varlink-call requires a JSON string");
                process_exit(2);
                return Err("missing --varlink-call arg");
            }
            i = i + 2;
        } else {
            println("ERR\toosh\tunknown flag: " + a);
            process_exit(2);
            return Err("unknown flag");
        }
    }
    return Ok("validated");
}

pub fn main(bind: &BindCap, fs_r: &FsReadCap, sys: &ProcessCap, sys_cap: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, thread: &ThreadCap, args: List[String]) -> Result[Int, String] {
    let pre: Result[String, String] = validate_argv(args);
    let kind: String = match pre { Ok(s) => s, Err(_) => "validated" };
    if kind == "showed-help" || kind == "showed-version" {
        return Ok(0);
    }

    let n: Int = list_len(args);
    let mut show_banner: Bool = true;
    let mut one_shot_cmd: String = "";
    let mut has_c_flag: Bool = false;
    let mut is_daemon: Bool = false;
    let mut varlink_payload: String = "";

    let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        if a == "--no-banner" {
            show_banner = false;
            i = i + 1;
        } else if a == "--daemon" || a == "--varlink" {
            show_banner = false;
            is_daemon = true;
            i = i + 1;
        } else if a == "-c" {
            show_banner = false;
            has_c_flag = true;
            one_shot_cmd = list_get(args, i + 1);
            i = i + 2;
        } else if a == "--varlink-call" {
            show_banner = false;
            varlink_payload = list_get(args, i + 1);
            i = i + 2;
        } else {
            i = i + 1;
        }
    }

    let pr: Result[String, String] = env_get(env, "PWD");
    let cwd: String = match pr { Ok(s) => s, Err(_) => "." };
    let rec: FlightRecord = flight_init();

    // Single-shot Varlink IPC call execution
    if varlink_payload != "" {
        let reply: String = ipc_route(sys, cwd, rec, varlink_payload);
        print(reply);
        return Ok(0);
    }

    // Headless Varlink IPC control daemon
    if is_daemon {
        let d_rc: Int = ipc_run_daemon(sys, env, cwd, rec);
        return Ok(d_rc);
    }

    // Handle one-shot command execution (-c "cmd")
    if has_c_flag {
        if str_trim(one_shot_cmd) == "" {
            return Ok(0);
        }
        let res: DispatchResult = dispatch_line(sys, env, cwd, one_shot_cmd, rec);
        return Ok(res.exit_code);
    }

    if show_banner {
        println(oosh_banner());
    }

    // Launch interactive OODA REPL engine
    let rc: Int = run_engine(fs_r, sys, env, time, bind, fs_w);
    return Ok(rc);
}
