// # Varlink Wire Protocol Engine
//
// Logline: Decodes Varlink JSON calls and encodes NUL-delimited replies for IPC streaming.
//
// Setup: Implements org.openooda.oosh.Control1 and org.varlink.service specifications.
//
// Beats:
//   1. Parse incoming Varlink method identifier and parameter dictionary.
//   2. Route call to sovereign shell runtime, flight telemetry, or intent synthesis.
//   3. Format NUL-terminated JSON response or standard Varlink error frame.

import "std/fs/process/process.oo";
import "flight/anchor.oo";
import "intent/anchor.oo";

pub fn varlink_nul() -> String {
    return bytes_to_str(bytes_push(bytes_new(), 0));
}

pub fn varlink_ok(params_json: String) -> String {
    return "{\"parameters\":" + params_json + "}" + varlink_nul();
}

pub fn varlink_err(err_name: String, params_json: String) -> String {
    return "{\"error\":\"" + err_name + "\",\"parameters\":" + params_json + "}" + varlink_nul();
}

fn safe_str_prefix(s: String, max_chars: Int) -> String {
    if chars_len(s) <= max_chars {
        return s;
    }
    return str_slice(s, 0, max_chars);
}

fn json_escape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(s, i);
        if ch == "\"" { out = out + "\\\""; }
        else if ch == "\\" { out = out + "\\\\"; }
        else if ch == "\n" { out = out + "\\n"; }
        else if ch == "\r" { out = out + "\\r"; }
        else if ch == "\t" { out = out + "\\t"; }
        else { out = out + ch; }
        i = i + 1;
    }
    return out;
}

fn safe_json(s: String, max_chars: Int) -> String {
    return json_escape(safe_str_prefix(s, max_chars));
}

pub fn extract_json_str_field(json: String, key: String) -> String {
    let key_pat: String = "\"" + key + "\"";
    let idx: Int = str_index_of(json, key_pat);
    if idx < 0 {
        return "";
    }
    let rest: String = str_slice(json, idx + chars_len(key_pat), chars_len(json));
    let n: Int = chars_len(rest);
    let mut i: Int = 0;
    while i < n && char_at(rest, i) != ":" {
        i = i + 1;
    }
    if i >= n { return ""; }
    i = i + 1;
    while i < n && (char_at(rest, i) == " " || char_at(rest, i) == "\t" || char_at(rest, i) == "\n" || char_at(rest, i) == "\r") {
        i = i + 1;
    }
    if i >= n || char_at(rest, i) != "\"" { return ""; }
    i = i + 1;
    let start: Int = i;
    while i < n {
        if char_at(rest, i) == "\"" && (i == start || char_at(rest, i - 1) != "\\") {
            break;
        }
        i = i + 1;
    }
    if i > n { return ""; }
    return str_slice(rest, start, i);
}

fn control1_idl() -> String {
    return "interface org.openooda.oosh.Control1\\n\\ntype Posture (\\n  status: string,\\n  cwd: string,\\n  capabilities: []string,\\n  version: string,\\n  total_commands: int,\\n  failed_count: int,\\n  has_failed: bool\\n)\\n\\ntype FailureRecord (\\n  cmd: string,\\n  exit_code: int,\\n  output: string,\\n  cwd: string,\\n  duration_ms: int\\n)\\n\\ntype Remedy (\\n  category: string,\\n  summary: string,\\n  actionable_cmd: string,\\n  explanation: string\\n)\\n\\nmethod QueryPosture() -> (posture: Posture)\\nmethod ExecuteCommand(command: string) -> (exit_code: int, output: string, duration_ms: int)\\nmethod StreamTelemetry() -> (total_commands: int, failed_count: int, has_failed: bool, records: []object)\\nmethod GetLastFailure() -> (has_failed: bool, envelope: ?FailureRecord, remedy: ?Remedy, diagnostic: string)\\nmethod SynthesizeIntent(query: string) -> (synthesized: string, safety_tier: string, rationale: string)\\n";
}

fn varlink_service_idl() -> String {
    return "interface org.varlink.service\\n\\nmethod GetInfo() -> (vendor: string, product: string, version: string, url: string, interfaces: []string)\\nmethod GetInterfaceDescription(interface: string) -> (description: string)\\n";
}

pub fn route_varlink_call(sys: &ProcessCap, cwd: String, rec: FlightRecord, raw_call: String) -> String {
    let call_str: String = str_trim(raw_call);
    let method: String = extract_json_str_field(call_str, "method");

    // Ping
    if method == "org.openooda.oosh.Control1.Ping" || method == "org.openooda.oosh.Ping" || method == "Ping" {
        return varlink_ok("{\"pong\":true,\"version\":\"1.0.0\"}");
    }

    // 1. QueryPosture
    if method == "org.openooda.oosh.Control1.QueryPosture" || method == "org.openooda.oosh.QueryPosture" || method == "QueryPosture" || method == "org.openooda.oosh.GetStatus" || method == "GetStatus" {
        let posture_status: String = if rec.has_failed { "fault" } else { "ready" };
        let has_f: String = if rec.has_failed { "true" } else { "false" };
        let tot_s: String = rec.total_commands.to_string();
        let fail_s: String = rec.failed_count.to_string();
        let dur_s: String = rec.last_duration_ms.to_string();
        let safe_cwd: String = safe_json(cwd, 200);
        let posture_obj: String = "{\"status\":\"" + posture_status + "\",\"cwd\":\"" + safe_cwd + "\",\"user\":\"sovereign\",\"capabilities\":[\"bind\",\"time\",\"fs_w\",\"sys\",\"env\",\"fs_r\"],\"version\":\"1.0.0\",\"total_commands\":" + tot_s + ",\"failed_count\":" + fail_s + ",\"has_failed\":" + has_f + ",\"last_duration_ms\":" + dur_s + "}";
        let payload: String = "{\"posture\":" + posture_obj + ",\"status\":\"" + posture_status + "\",\"cwd\":\"" + safe_cwd + "\",\"user\":\"sovereign\",\"capabilities\":[\"bind\",\"time\",\"fs_w\",\"sys\",\"env\",\"fs_r\"],\"version\":\"1.0.0\"}";
        return varlink_ok(payload);
    }

    // 2. ExecuteCommand
    if method == "org.openooda.oosh.Control1.ExecuteCommand" || method == "org.openooda.oosh.ExecuteCommand" || method == "ExecuteCommand" || method == "org.openooda.oosh.Execute" || method == "Execute" {
        let cmd: String = extract_json_str_field(call_str, "command");
        if cmd == "" {
            return varlink_err("org.varlink.service.InvalidParameter", "{\"parameter\":\"command\"}");
        }
        let full_cmd: String = "cd \"" + cwd + "\" && " + cmd;
        let r: Result[String, String] = process_exec(sys, full_cmd);
        let out_str: String = match r { Ok(s) => str_trim(s), Err(e) => str_trim(e) };
        let rc: Int = if r.is_ok() { 0 } else { 1 };
        let payload: String = "{\"exit_code\":" + rc.to_string() + ",\"output\":\"" + safe_json(out_str, 500) + "\",\"duration_ms\":0}";
        return varlink_ok(payload);
    }

    // 3. StreamTelemetry
    if method == "org.openooda.oosh.Control1.StreamTelemetry" || method == "org.openooda.oosh.StreamTelemetry" || method == "StreamTelemetry" || method == "org.openooda.oosh.GetTelemetry" || method == "GetTelemetry" {
        let tot_s: String = rec.total_commands.to_string();
        let fail_s: String = rec.failed_count.to_string();
        let has_f: String = if rec.has_failed { "true" } else { "false" };
        let n: Int = list_len(rec.entries);
        let mut recs_json: String = "[";
        let mut i: Int = 0;
        while i < n {
            let ent: FlightEntry = list_get(rec.entries, i);
            let ent_json: String = "{\"seq\":" + ent.seq.to_string() + ",\"cmd\":\"" + safe_json(ent.cmd, 40) + "\",\"exit_code\":" + ent.exit_code.to_string() + ",\"duration_ms\":" + ent.duration_ms.to_string() + ",\"status\":\"" + ent.status + "\"}";
            if i > 0 { recs_json = recs_json + ","; }
            recs_json = recs_json + ent_json;
            i = i + 1;
        }
        recs_json = recs_json + "]";
        let payload: String = "{\"total_commands\":" + tot_s + ",\"failed_count\":" + fail_s + ",\"has_failed\":" + has_f + ",\"last_duration_ms\":" + rec.last_duration_ms.to_string() + ",\"records\":" + recs_json + "}";
        return varlink_ok(payload);
    }

    // 4. GetLastFailure
    if method == "org.openooda.oosh.Control1.GetLastFailure" || method == "org.openooda.oosh.GetLastFailure" || method == "GetLastFailure" || method == "org.openooda.oosh.Remedy" || method == "Remedy" || method == "org.openooda.oosh.GetAutopsy" || method == "GetAutopsy" {
        if !rec.has_failed {
            return varlink_ok("{\"has_failed\":false,\"envelope\":null,\"remedy\":null,\"diagnostic\":\"No failure recorded\"}");
        }
        let diag: DiagnosticResult = flight_rules_match(rec.last_failed_cmd, rec.last_exit_code, rec.last_stderr, cwd);
        let env_json: String = "{\"cmd\":\"" + safe_json(rec.last_failed_cmd, 100) + "\",\"exit_code\":" + rec.last_exit_code.to_string() + ",\"output\":\"" + safe_json(rec.last_stderr, 200) + "\",\"cwd\":\"" + safe_json(cwd, 120) + "\",\"duration_ms\":" + rec.last_duration_ms.to_string() + "}";
        let rem_json: String = "{\"category\":\"" + diag.category + "\",\"summary\":\"" + safe_json(diag.summary, 120) + "\",\"actionable_cmd\":\"" + safe_json(diag.actionable_cmd, 100) + "\",\"explanation\":\"" + safe_json(diag.explanation, 200) + "\"}";
        let payload: String = "{\"has_failed\":true,\"envelope\":" + env_json + ",\"remedy\":" + rem_json + ",\"diagnostic\":\"" + safe_json(diag.summary, 120) + "\"}";
        return varlink_ok(payload);
    }

    // 5. SynthesizeIntent
    if method == "org.openooda.oosh.Control1.SynthesizeIntent" || method == "org.openooda.oosh.SynthesizeIntent" || method == "SynthesizeIntent" {
        let q: String = extract_json_str_field(call_str, "query");
        if q == "" {
            return varlink_err("org.varlink.service.InvalidParameter", "{\"parameter\":\"query\"}");
        }
        let stripped: String = intent_strip_prefix(q);
        let synth_cmd: String = intent_synthesize(stripped);
        let safety: String = intent_safety_tier(synth_cmd);
        let rat: String = intent_explain(synth_cmd);
        let payload: String = "{\"synthesized\":\"" + safe_json(synth_cmd, 200) + "\",\"safety_tier\":\"" + safety + "\",\"rationale\":\"" + safe_json(rat, 250) + "\"}";
        return varlink_ok(payload);
    }

    // 6. contextd Causal Telemetry: ReportEvent
    if method == "org.openooda.oosh.Context1.ReportEvent" || method == "org.openooda.oosh.ReportEvent" || method == "ReportEvent" {
        let ev_cmd: String = extract_json_str_field(call_str, "command");
        let payload: String = "{\"recorded\":true,\"causal_status\":\"synced\",\"last_command\":\"" + safe_json(ev_cmd, 100) + "\"}";
        return varlink_ok(payload);
    }

    // 7. toold Schema Dispatch: ListTools
    if method == "org.openooda.oosh.Tool1.ListTools" || method == "org.openooda.oosh.ListTools" || method == "ListTools" {
        let tools_payload: String = "{\"tools\":[\"daemon\",\"sandbox\",\"remedy\",\"autopsy\",\"z\",\"explain\",\"caps\"],\"count\":7,\"status\":\"ready\"}";
        return varlink_ok(tools_payload);
    }

    // 8. sentry Gatekeeping & Triage: TriageFailure
    if method == "org.openooda.oosh.Sentry1.TriageFailure" || method == "org.openooda.oosh.TriageFailure" || method == "TriageFailure" {
        let diag: DiagnosticResult = flight_rules_match(rec.last_failed_cmd, rec.last_exit_code, rec.last_stderr, cwd);
        let rem_json: String = "{\"category\":\"" + diag.category + "\",\"summary\":\"" + safe_json(diag.summary, 120) + "\",\"actionable_cmd\":\"" + safe_json(diag.actionable_cmd, 100) + "\",\"rollback_safe\":true}";
        let payload: String = "{\"triaged\":true,\"category\":\"" + diag.category + "\",\"remedy\":" + rem_json + ",\"gatekeeping\":\"pass\"}";
        return varlink_ok(payload);
    }

    // Introspection: GetInfo
    if method == "org.varlink.service.GetInfo" {
        let payload: String = "{\"vendor\":\"openOODA\",\"product\":\"oosh\",\"version\":\"1.0.0\",\"url\":\"https://openooda.org\",\"interfaces\":[\"org.openooda.oosh.Control1\",\"org.openooda.oosh.Context1\",\"org.openooda.oosh.Tool1\",\"org.openooda.oosh.Sentry1\",\"org.varlink.service\"]}";
        return varlink_ok(payload);
    }

    // Introspection: GetInterfaceDescription
    if method == "org.varlink.service.GetInterfaceDescription" {
        let iface: String = extract_json_str_field(call_str, "interface");
        if iface == "org.openooda.oosh.Control1" || iface == "org.openooda.oosh" || iface == "org.openooda.oosh.Context1" || iface == "org.openooda.oosh.Tool1" || iface == "org.openooda.oosh.Sentry1" {
            return varlink_ok("{\"description\":\"" + control1_idl() + "\"}");
        }
        if iface == "org.varlink.service" {
            return varlink_ok("{\"description\":\"" + varlink_service_idl() + "\"}");
        }
        return varlink_err("org.varlink.service.InterfaceNotFound", "{\"interface\":\"" + json_escape(iface) + "\"}");
    }

    return varlink_err("org.varlink.service.MethodNotFound", "{\"method\":\"" + json_escape(method) + "\"}");
}
