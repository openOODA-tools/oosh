// # Theme and Prompt Unit Tests
//
// Logline: Verifies theme hydration, token codes, prompt mascot glyphs, and default alias.
//
// Setup: Pure algorithmic verification using test runner framework.
//
// Beats:
//   1. Verify theme.oot key parsing and token code resolutions across themes.
//   2. Verify default theme alias mapping to oote engine.
//   3. Verify micro-mascot glyph exit status posture in shell prompt.

import "std/meta/test/runner.oo";
import "std/fs/process/env.oo";
import "ui/theme_io.oo";
import "ui/palette.oo";
import "ui/accent.oo";
import "alias.oo";
import "prompt.oo";

fn test_theme_tokens(r: TestRunner) -> TestRunner {
    let mut tr: TestRunner = r;
    let cfg: String = "# openOODA theme config\ntheme = \"cyberpunk\"\nmode = \"dark\"\n";
    tr = test_assert_eq_str(tr, "theme: parse key theme", parse_theme_key(cfg, "theme"), "cyberpunk");
    tr = test_assert_eq_str(tr, "theme: parse key mode", parse_theme_key(cfg, "mode"), "dark");
    tr = test_assert_eq_str(tr, "theme: config path non-empty", theme_config_path("/home/user"), "/home/user/.openooda/theme.oot");
    tr = test_assert_eq_str(tr, "theme: config path fallback", theme_config_path(""), "theme.oot");

    tr = test_assert_eq_str(tr, "theme: 1982 prompt token", theme_token_code("1982", "shell_prompt"), "32");
    tr = test_assert_eq_str(tr, "theme: 1982 host bin token", theme_token_code("1982", "shell_host_bin"), "36");
    tr = test_assert_eq_str(tr, "theme: cyberpunk prompt token", theme_token_code("cyberpunk", "shell_prompt"), "31");
    tr = test_assert_eq_str(tr, "theme: cyberpunk builtin token", theme_token_code("cyberpunk", "shell_builtin"), "36");
    tr = test_assert_eq_str(tr, "theme: nord prompt token", theme_token_code("nord", "shell_prompt"), "36");
    tr = test_assert_eq_str(tr, "theme: dracula builtin token", theme_token_code("dracula", "shell_builtin"), "32");
    tr = test_assert_eq_str(tr, "theme: default prompt token", theme_token_code("ember", "shell_prompt"), "33");
    tr = test_assert_eq_str(tr, "theme: default nav token", theme_token_code("minimax", "shell_nav"), "32");
    return tr;
}

fn test_theme_prompt_alias(env: &EnvCap, r: TestRunner) -> TestRunner {
    let mut tr: TestRunner = r;
    let m: AliasMap = alias_map_new();
    let theme_alias_r: Result[String, String] = alias_map_get(m, "theme");
    tr = test_assert(tr, "theme: default alias exists", theme_alias_r.is_ok());
    tr = test_assert_eq_str(tr, "theme: alias points to oote", match theme_alias_r { Ok(s) => s, Err(_) => "" }, "oote");
    tr = test_assert_eq_str(tr, "theme: alias expand command", alias_expand(m, "theme list"), "oote list");

    let sym_ok: String = render_grounded_symbol(false);
    let sym_err: String = render_grounded_symbol(true);
    tr = test_assert(tr, "theme: symbol ok contains happy glyph", str_contains(sym_ok, "(^.^)"));
    tr = test_assert(tr, "theme: symbol err contains failure glyph", str_contains(sym_err, "(x.x)"));

    let sym_cyber: String = render_grounded_symbol_themed("cyberpunk", false);
    tr = test_assert(tr, "theme: cyberpunk symbol ok code 31", str_contains(sym_cyber, "[31m"));
    tr = test_assert(tr, "theme: cyberpunk symbol contains happy glyph", str_contains(sym_cyber, "(^.^)"));

    let sym_1982: String = render_grounded_symbol_themed("1982", true);
    tr = test_assert(tr, "theme: 1982 symbol err code 32", str_contains(sym_1982, "[32m"));
    tr = test_assert(tr, "theme: 1982 symbol contains failure glyph", str_contains(sym_1982, "(x.x)"));

    let p_ok: String = render_prompt_state(env, "/tmp", false);
    let p_err: String = render_prompt_state(env, "/tmp", true);
    tr = test_assert(tr, "theme: prompt ok contains happy glyph", str_contains(p_ok, "(^.^)"));
    tr = test_assert(tr, "theme: prompt err contains failure glyph", str_contains(p_err, "(x.x)"));

    tr = test_assert(tr, "theme: accent intent channel", str_contains(render_syntax_accent("? test"), "INTENT CHANNEL"));
    tr = test_assert(tr, "theme: accent navigation", str_contains(render_syntax_accent("cd /"), "NAVIGATION: cd"));
    tr = test_assert(tr, "theme: accent builtin", str_contains(render_syntax_accent("whereami"), "NAVIGATION: whereami"));

    let acc_cyber_intent: String = render_syntax_accent_themed("? test", "cyberpunk");
    tr = test_assert(tr, "theme: cyberpunk accent intent code 33", str_contains(acc_cyber_intent, "[33m"));
    let acc_cyber_nav: String = render_syntax_accent_themed("whereami", "cyberpunk");
    tr = test_assert(tr, "theme: cyberpunk accent nav code 32", str_contains(acc_cyber_nav, "[32m"));
    let acc_cyber_bi: String = render_syntax_accent_themed("status", "cyberpunk");
    tr = test_assert(tr, "theme: cyberpunk accent builtin code 36", str_contains(acc_cyber_bi, "[36m"));
    return tr;
}

pub fn run_test_theme(env: &EnvCap, r: TestRunner) -> TestRunner {
    let mut tr: TestRunner = r;
    tr = test_theme_tokens(tr);
    tr = test_theme_prompt_alias(env, tr);
    return tr;
}
