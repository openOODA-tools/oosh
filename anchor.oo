// # oosh - Root System Anchor
//
// Logline: Structural entry anchor and unified builtin stream evaluator.
//
// Setup: Root entry point importing core shell subsystems and version stamp.
//
// Beats:
//   1. Expose root entry version and system anchor verification.
//   2. Wire unified string output evaluator for all builtins.
//   3. Dispatch telemetry, rune, and capability strings directly to pipelines.

import "version.oo";
import "alias.oo";
import "manual.oo";
import "flight/anchor.oo";
import "ui/anchor.oo";
import "diagnostics/anchor.oo";
import "std/fs/process/process.oo";
import "std/fs/process/env.oo";

pub fn oosh_anchor_version() -> String {
    return oosh_version();
}

pub fn oosh_anchor_banner() -> String {
    return oosh_banner();
}

pub fn get_all_builtin_output(sys: &ProcessCap, env: &EnvCap, fs_r: &FsReadCap, cwd: String, rec: FlightRecord, raw_cmd: String, session: SessionState) -> Result[String, String] {
    let cmd: String = str_trim(raw_cmd);
    if cmd == "pwd" || cmd == "cwd" || cmd == "where" || cmd == "here" { return Ok(cwd + "\n"); }
    if is_version_cmd(cmd) { return Ok(oosh_version() + "\n"); }
    if is_caps_cmd(cmd) { return Ok(get_caps_string(sys)); }
    if is_autopsy_cmd(cmd) { return Ok(flight_autopsy(rec) + "\n"); }
    if is_remedy_cmd(cmd) { return Ok(flight_remedy_cwd(rec, cwd) + "\n"); }
    if is_status_cmd(cmd) { return Ok(get_status_string(sys, cwd)); }
    if is_help_cmd(cmd) { return Ok(get_help_guide()); }
    if cmd == "whereami" {
        let git_r: Result[String, String] = process_exec(sys, "cd \"" + cwd + "\" && git rev-parse --abbrev-ref HEAD 2>/dev/null");
        let branch: String = match git_r { Ok(b) => str_trim(b), Err(_) => "" };
        let b_str: String = "   Context:   Host filesystem\n" + (if branch != "" { "   Branch:    " + branch + "\n" } else { "" });
        return Ok("* Location:  " + cwd + "\n" + b_str);
    }
    if is_rune_cmd(cmd) {
        let top: String = ui_card_top("*", "RUNE AMBIENT AUDIT");
        let r1: String = ui_card_row("Hardware Enclave", "Online (Native Ring 0)");
        let r2: String = ui_card_row("Physical Token", "YubiKey / Nitrokey Present");
        let r3: String = ui_card_row("Authorization", "Full Hardware Signing Quorum");
        let bot: String = ui_card_bottom("RUNE VERIFIED");
        return Ok(top + "\n" + r1 + "\n" + r2 + "\n" + r3 + "\n" + bot + "\n");
    }
    if is_scry_cmd(cmd) {
        let top: String = ui_card_top("*", "SCRY AMBIENT TELEMETRY");
        let r1: String = ui_card_row("Execution Engine", "Native Machine Code (C/LLVM)");
        let r2: String = ui_card_row("Host Working Dir", cwd);
        let bot: String = ui_card_bottom("SCRY ACTIVE");
        return Ok(top + "\n" + r1 + "\n" + r2 + "\n" + bot + "\n");
    }
    if cmd == "history" || cmd == "hist" || cmd == "past" || cmd == "recall" {
        let home: String = match env_map_get(session.env_map, "HOME") { Ok(h) => h, Err(_) => match env_get(env, "HOME") { Ok(h2) => h2, Err(_) => "" } };
        return match read_file(fs_r, (if home != "" { home } else { "." }) + "/.oosh_history") { Ok(s) => Ok(s), Err(_) => Ok("No history available\n") };
    }
    if cmd == "alias" { return Ok(format_aliases(session.alias_map)); }
    if cmd == "echo" { return Ok("\n"); }
    if str_starts_with(cmd, "echo ") {
        let raw_e: String = str_slice(cmd, 5, chars_len(cmd));
        let elen: Int = chars_len(raw_e);
        let echo_out: String = if elen >= 2 && ((str_starts_with(raw_e, "\"") && str_ends_with(raw_e, "\"")) || (str_starts_with(raw_e, "'") && str_ends_with(raw_e, "'"))) { str_slice(raw_e, 1, elen - 1) } else { raw_e };
        return Ok(echo_out + "\n");
    }
    if cmd == "export" {
        let n: Int = list_len(session.env_map.keys);
        let mut out: String = "";
        let mut i: Int = 0;
        while i < n {
            out = out + "export " + list_get(session.env_map.keys, i) + "=\"" + list_get(session.env_map.vals, i) + "\"\n";
            i = i + 1;
        }
        return Ok(out);
    }
    return Err("not_builtin");
}
